.parity-work*

# Local evaluation corpora, SDKs, dependency bundles, captures, and reference copies.
/.local/
/.references/
__pycache__/
*.pyc

# Restart-safe external application evaluation SDK, packages, and captures.
/.local/application-impact/

# built binaries (cmd/* names, when built into the repo root)
/moedex
/moedex-mcp
/moedex-serve
/moedex-serve-dense
/moedex-index
/moedex-index-dense
/moedex-index-lsp
/moedex-corpus
/moedex-nav
/moedex-parity
/scale

# Claude Code plugin's cross-compiled binaries (built via `make build-plugin`,
# published as release artifacts — not committed, too large for git history)
/plugin/bin/*/moe

# Claude Code worktrees (transient; never commit the gitlink)
.claude/worktrees/
.DS_Store
.bench/

# go test -c / -cpuprofile leftovers
*.test
test.log

# Disposable graph serving caches beside indexed shards.
*.idx.graph-symbols
graph-catalog.cache
.graph-symbols-*
.graph-catalog-*

# Optional semantic compiler worker build products and Python harness caches.
/tools/semantic-dotnet/bin/
/tools/semantic-dotnet/obj/
/tools/semantic-dotnet/__pycache__/
/research/semantic-intelligence/__pycache__/
/research/semantic-intelligence/roslyn/__pycache__/
