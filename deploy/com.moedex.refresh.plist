<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE — do NOT `cp` this directly. The @PLACEHOLDER@ tokens are filled in by
  scripts/install-macos.sh (or substitute @HOME@/@REPO@/@CORPUS@/@CAS_DIR@/
  @SHARD_DIR@ yourself).

  Periodic corpus refresh (macOS analog of deploy/moedex-refresh.timer). Runs
  scripts/refresh-corpus.sh daily: sync corpus -> doctor preflight -> rebuild
  shards + token/symbol sidecars -> build the dense embedding sidecar OUT OF BAND
  (incrementally) -> SIGHUP the warm daemon for a zero-downtime hot-swap. Building
  embeddings before the reload is the whole point: the daemon never re-embeds the
  corpus inline (which would take it offline for the length of the embed).

  NOTE: a launchd `zsh -lc` is a NON-interactive login shell and does NOT source
  ~/.zshrc, so the job does NOT inherit the interactive PATH/MOEDEX_CORPUS. The
  refresh script sets its own PATH; MOEDEX_CORPUS is provided below. Nothing here
  relies on ~/.zshrc.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.moedex.refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec "@REPO@/scripts/refresh-corpus.sh"</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>REFRESH_SYNC</key>
    <string>1</string>
    <key>MOEDEX_CORPUS</key>
    <string>@CORPUS@</string>
    <key>MOEDEX_CAS_DIR</key>
    <string>@CAS_DIR@</string>
    <key>MOEDEX_SHARD_DIR</key>
    <string>@SHARD_DIR@</string>
    <key>ONNXRUNTIME_LIB_PATH</key>
    <string>@ONNX_LIB@</string>
    <key>MOEDEX_ONNX_INTRA_OP_THREADS</key>
    <string>@ONNX_INTRA_THREADS@</string>
    <key>MOEDEX_ONNX_INTER_OP_THREADS</key>
    <string>@ONNX_INTER_THREADS@</string>
  </dict>

  <!-- Daily at 14:10 local time. RunAtLoad is false so installing it never kicks a heavy
       rebuild immediately; use `launchctl kickstart -p` to run on demand. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>14</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>@HOME@/.moedex-index/refresh.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/.moedex-index/refresh.log</string>
</dict>
</plist>
