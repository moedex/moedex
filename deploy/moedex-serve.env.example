# moedex-serve EnvironmentFile — copy to /etc/moedex/moedex-serve.env on the
# deploy host and `chmod 0640 && chown root:moedex` (it holds the auth secret).
#
#   install -d -m 0750 -o root -g moedex /etc/moedex
#   install -m 0640 -o root -g moedex deploy/moedex-serve.env.example \
#       /etc/moedex/moedex-serve.env
#
# Referenced by deploy/moedex-serve.service (EnvironmentFile=),
# deploy/moedex-refresh.service, and deploy/moedex-sync.service. Lines are
# KEY=VALUE (no `export`, no inline shell expansion — systemd parses this, not a
# shell).

# Directory of prebuilt *.idx shards, served by `moedex serve` and refreshed by
# `moedex index` / `moedex corpus`. The systemd units hardcode the same path in
# ReadOnlyPaths / ReadWritePaths, so if you change this, update the units too.
MOEDEX_SHARD_DIR=/srv/moedex/shards-managed

# --- Corpus acquisition & freshness (managed sibling rollout) --------------
# Use sibling paths during migration. Do not point these at the legacy live
# corpus/CAS/shards until the rollout report's parity, health, rollback, and soak
# gates are approved.
MOEDEX_CORPUS=/srv/moedex/corpus-managed
# Persistent content-addressable store backing the per-blob-delta reindex
# (`moedex index cas build/refresh/export` -> MOEDEX_SHARD_DIR). Consumed by
# the moedex-sync unit's ExecStart only.
MOEDEX_CAS_DIR=/srv/moedex/cas-managed

# External language servers never open MOEDEX_CORPUS directly. Moe projects an
# exact locked commit here and lets compiler/LSP caches mutate only this
# disposable tree. The service unit grants this path write access explicitly.
MOEDEX_LSP_WORKSPACE_DIR=/srv/moedex/lsp-workspaces

# Authentication to gitlab.example.com for moedex-sync. PREFERRED: run
# `glab auth login --hostname gitlab.example.com` ONCE as the service user (the
# same identity model as an interactive operator). ALTERNATIVE: provide a token
# here — glab reads GITLAB_TOKEN automatically (a read_api PAT or a deploy token
# with clone access). Either way the user also needs SSH clone access.
#GITLAB_TOKEN=replace-me-with-a-read_api-token

# Bearer token for the HTTP API. When set, /search and /stats require
#   Authorization: Bearer <token>
# (/healthz and /metrics stay open). Active in the daemon today. Generate one
# with e.g. `openssl rand -hex 32`. Leave commented out to run open on the
# loopback bind (only safe behind a trusted proxy that injects auth, or for
# local-only use).
#MOEDEX_AUTH_TOKEN=replace-me-with-openssl-rand-hex-32

# Cap concurrent in-flight /search requests (503 when full); each one scans the
# full corpus and can pin a core for up to -request-timeout. Default 8,
# mirroring the MCP server's own concurrency guard. 0 disables the cap. Also
# settable via -search-max-concurrency.
#MOEDEX_SEARCH_MAX_CONCURRENCY=8

# --- Dense arm (optional; -mcp only) ---------------------------------------
# The HTTP daemon (-http) does NOT use these. They matter only for the dense
# MCP path. Set BOTH to light up the HTTP-backed embedder, or use the dense
# image (Dockerfile.dense) / ONNXRUNTIME_LIB_PATH for the in-process embedder.
#MOEDEX_EMBED_URL=http://127.0.0.1:8081/embed
#MOEDEX_EMBED_MODEL=your-embed-model-id

# In-process ONNX embedder (dense image only): path to libonnxruntime.so. Also
# settable via the -onnx-runtime flag. Requires a -tags onnx build.
#ONNXRUNTIME_LIB_PATH=/usr/local/lib/libonnxruntime.so

# CPU pool tuning for the in-process ONNX session. 0 leaves ONNX Runtime's
# platform default. Corpus builds use 64-text inference batches; benchmark this
# machine with BenchmarkONNXEmbedderThreadCounts before setting a production value.
#MOEDEX_ONNX_INTRA_OP_THREADS=0
#MOEDEX_ONNX_INTER_OP_THREADS=0

# Semantic graph edges (onnx-tagged `moedex graph build`). Each symbol definition
# keeps up to K neighbors at or above the cosine threshold. Set K=0 to disable.
#MOEDEX_GRAPH_SIMILAR_TOP_K=5
#MOEDEX_GRAPH_SIMILAR_THRESHOLD=0.60
# Exact all-pairs cosine is retained only for small graphs. Above the limit,
# deterministic angular-LSH generates candidates and exact cosine reranks at
# most this many candidates per definition.
#MOEDEX_GRAPH_SIMILAR_EXACT_LIMIT=4096
#MOEDEX_GRAPH_SIMILAR_MAX_CANDIDATES=2048

# Offline LSP graph sweep (onnx+lsp `moedex graph build`). Independent language/workspace
# routes run concurrently, but requests to one language server remain sequential.
# Defaults: min(2*GOMAXPROCS, 32) workers and 100 aggregate request starts/second.
#MOEDEX_GRAPH_LSP_CONCURRENCY=32
#MOEDEX_GRAPH_LSP_REQUESTS_PER_SECOND=100

# Corpus acquisition host and group scope are deployment-specific.
# MOEDEX_GITLAB_HOST=gitlab.example.com
# MOEDEX_CORPUS_GROUPS=/etc/moedex/corpus-groups.txt
