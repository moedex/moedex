# moedex-serve — warm retrieval daemon (HTTP API).
#
# Install:
#   sudo install -m 0644 deploy/moedex-serve.service /etc/systemd/system/
#   sudo install -m 0755 moedex-serve /usr/local/bin/moedex-serve   # your built binary
#   sudo install -d -m 0750 -o root -g moedex /etc/moedex
#   sudo install -m 0640 -o root -g moedex \
#        deploy/moedex-serve.env.example /etc/moedex/moedex-serve.env  # then edit
#   sudo useradd -r -s /usr/sbin/nologin moedex   # if not already present
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now moedex-serve
#
# Reload shards without dropping in-flight requests (daemon hot-reload on SIGHUP):
#   sudo systemctl reload moedex-serve
#
# This unit binds 127.0.0.1:8080 explicitly. Front it with a trusted reverse
# proxy (nginx/caddy) if you need network exposure; the daemon enforces the
# loopback bind by default regardless.

[Unit]
Description=moedex warm retrieval daemon (HTTP)
Documentation=https://gitlab.tcdevops.com/Zak/moedex
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moedex
Group=moedex

# Secrets + config (MOEDEX_AUTH_TOKEN, MOEDEX_SHARD_DIR, optional embed vars).
# 0640 root:moedex. The unit also references MOEDEX_SHARD_DIR below.
EnvironmentFile=/etc/moedex/moedex-serve.env

# Bind loopback explicitly. -shard-dir is taken from MOEDEX_SHARD_DIR in the
# EnvironmentFile (the flag default is $MOEDEX_SHARD_DIR), so it does not need to
# be repeated here; the auth token is read from MOEDEX_AUTH_TOKEN in the env.
ExecStart=/usr/local/bin/moedex-serve -http 127.0.0.1:8080

# systemctl reload -> SIGHUP -> the daemon re-opens MOEDEX_SHARD_DIR and
# hot-swaps the corpus without dropping in-flight requests.
ExecReload=/bin/kill -HUP $MAINPID

# The daemon does a 5s graceful drain on SIGTERM; give it headroom.
KillSignal=SIGTERM
TimeoutStopSec=10

Restart=on-failure
RestartSec=2

# --- Hardening -------------------------------------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The HTTP daemon only ever READS the shard dir; keep it read-only here. The
# refresh unit (which rewrites shards) declares ReadWritePaths instead.
# Adjust the path if you change MOEDEX_SHARD_DIR.
ReadOnlyPaths=/srv/moedex/shards

[Install]
WantedBy=multi-user.target
