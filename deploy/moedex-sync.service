# moedex-sync — pull the corpus fresh from GitLab and re-index it (per-blob
# delta), then hot-reload the daemon. The COMPLETE freshness loop. Driven by
# moedex-sync.timer (or run on demand: `sudo systemctl start moedex-sync`).
#
# Unlike moedex-refresh (which only rebuilds shards from an already-updated LOCAL
# corpus), moedex-sync talks to gitlab.example.com: it clones newly-created
# repos, fast-forwards existing ones, then drives cas-refresh -> cas-export
# -deduped. It therefore needs (a) NETWORK, (b) the service identity to be
# authenticated to GitLab, and (c) WRITE to the corpus / CAS / shard tree.
#
# CREDENTIALS (the load-bearing difference from the read-only units): the user
# this runs as must reach GitLab non-interactively —
#   * glab : run once AS THAT USER:  glab auth login --hostname gitlab.example.com
#            (or set GITLAB_TOKEN in the EnvironmentFile — glab reads it).
#   * git  : an SSH key that can clone the repos, with the GitLab host key already
#            in that user's ~/.ssh/known_hosts (sync uses ssh accept-new, which
#            would otherwise write known_hosts on first contact — but HOME is
#            read-only here; pre-seed the host key, or point GIT_SSH_COMMAND's
#            UserKnownHostsFile at a writable path under /srv/moedex).
# On a single-owner box it is simplest to run this timer as YOUR OWN user (set
# User=/Group= to yourself), reusing your existing glab + ssh — then no service
# identity has to be provisioned.
#
# Install (full runbook in deploy/README.md):
#   sudo install -m 0755 moe /usr/local/bin/moe
#   sudo install -m 0644 deploy/moedex-sync.service /etc/systemd/system/
#   sudo install -m 0644 deploy/moedex-sync.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now moedex-sync.timer

[Unit]
Description=moedex corpus sync + per-blob-delta reindex + hot reload
Documentation=https://github.com/moedex/moedex
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=moedex
Group=moedex

# Backstop for the whole oneshot (doctor + sync + cas-refresh + cas-export): a
# stalled network call inside any of them now fails loudly on its own (see
# moedex-corpus's -timeout, generous per-subcommand defaults), but this bounds
# the parts that flag doesn't reach too, so a hang can never silently swallow
# an hourly tick with no error and no non-zero exit to alert on. Systemd sends
# SIGTERM at this limit, which `moedex corpus` signal handling turns into
# a clean, reported cancellation rather than a hard kill.
TimeoutStartSec=5400

# MOEDEX_CORPUS, MOEDEX_CAS_DIR, MOEDEX_SHARD_DIR (+ optional GITLAB_TOKEN).
EnvironmentFile=/etc/moedex/moedex-serve.env

# Fail-stop managed sequence. A sync failure (including a partial/carry-forward
# result) prevents CAS and served snapshots from advancing. cas-export's deduped
# delta path preserves the prior served directory until the replacement is
# complete and durable.
ExecStartPre=/usr/local/bin/moedex corpus doctor --no-banner --corpus ${MOEDEX_CORPUS}
ExecStart=/usr/local/bin/moedex corpus sync --no-banner --corpus ${MOEDEX_CORPUS}
ExecStart=/usr/local/bin/moedex index cas refresh --cas-dir ${MOEDEX_CAS_DIR} --corpus ${MOEDEX_CORPUS}
ExecStart=/usr/local/bin/moedex index cas export --deduped --cas-dir ${MOEDEX_CAS_DIR} --shard-dir ${MOEDEX_SHARD_DIR}

# Hot-reload the running daemon onto the fresh shards (|| true keeps the timer
# green if the daemon is down). Same mechanism as moedex-refresh; reloading an
# unchanged shard set is a harmless no-op via SIGHUP.
ExecStartPost=/bin/sh -c '/bin/systemctl reload moedex-serve.service || true'

# --- Hardening (relaxed vs the read-only serve/refresh units) ---------------
NoNewPrivileges=true
ProtectSystem=strict
# HOME must be readable for glab config + ssh keys/known_hosts (see CREDENTIALS).
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Clone/pull/prune + CAS writes + shard export (and the atomic rename of the
# shard dir, which writes its parent) all happen under /srv/moedex, so the whole
# tree is read-write for this unit. Adjust if your paths differ.
ReadWritePaths=/srv/moedex
