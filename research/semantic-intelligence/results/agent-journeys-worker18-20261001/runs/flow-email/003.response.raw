{"jsonrpc":"2.0","id":3,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"b5149e390d53a03fad142e70324881acadf0b31a2966863526bd6fb79355caf3","blob_shas":["4d3aab75d965c2f22497e2ba73f5b851ce1afa78","747277d2ae2a7eba0f6a3062b35f920f46c0fac2"]}},"content":[{"type":"text","text":"3 context block(s), ~809 tokens\n\n--- src/Sample.Components/StateMachines/RegistrationStateDefinition.cs:1-16 (score 0.0492) ---\nnamespace Sample.Components.StateMachines;\n\nusing MassTransit;\n\n\npublic class RegistrationStateDefinition :\n    SagaDefinition\u003cRegistrationState\u003e\n{\n    protected override void ConfigureSaga(IReceiveEndpointConfigurator endpointConfigurator,\n        ISagaConfigurator\u003cRegistrationState\u003e consumerConfigurator, IRegistrationContext context)\n    {\n        endpointConfigurator.UseMessageRetry(r =\u003e r.Intervals(10, 50, 100, 1000, 1000, 1000, 1000, 1000));\n\n        endpointConfigurator.UseEntityFrameworkOutbox\u003cRegistrationDbContext\u003e(context);\n    }\n}\n\n--- src/Sample.Worker/Program.cs:26-89 (score 0.0161) ---\nvar host = Host.CreateDefaultBuilder(args)\n    .ConfigureServices((hostContext, services) =\u003e\n    {\n        services.AddDbContext\u003cRegistrationDbContext\u003e(x =\u003e\n        {\n            var connectionString = hostContext.Configuration.GetConnectionString(\"Default\");\n\n            x.UseNpgsql(connectionString, options =\u003e\n            {\n                options.MinBatchSize(1);\n            });\n        });\n\n        services.AddOpenTelemetry().WithTracing(x =\u003e\n        {\n            x.SetResourceBuilder(ResourceBuilder.CreateDefault()\n                    .AddService(\"service\")\n                    .AddTelemetrySdk()\n                    .AddEnvironmentVariableDetector())\n                .AddSource(\"MassTransit\")\n                .AddJaegerExporter(o =\u003e\n                {\n                    o.AgentHost = HostMetadataCache.IsRunningInContainer ? \"jaeger\" : \"localhost\";\n                    o.AgentPort = 6831;\n                    o.MaxPayloadSizeInBytes = 4096;\n                    o.ExportProcessorType = ExportProcessorType.Batch;\n                    o.BatchExportProcessorOptions = new BatchExportProcessorOptions\u003cActivity\u003e\n                    {\n                        MaxQueueSize = 2048,\n                        ScheduledDelayMilliseconds = 5000,\n                        ExporterTimeoutMilliseconds = 30000,\n                        MaxExportBatchSize = 512,\n                    };\n                });\n        });\n\n        services.AddScoped\u003cIRegistrationValidationService, RegistrationValidationService\u003e();\n        services.AddMassTransit(x =\u003e\n        {\n            x.AddEntityFrameworkOutbox\u003cRegistrationDbContext\u003e(o =\u003e\n            {\n                o.UsePostgres();\n\n                o.DuplicateDetectionWindow = TimeSpan.FromSeconds(30);\n            });\n\n            x.SetKebabCaseEndpointNameFormatter();\n\n            x.AddConsumer\u003cNotifyRegistrationConsumer\u003e();\n            x.AddConsumer\u003cSendRegistrationEmailConsumer\u003e();\n            x.AddConsumer\u003cAddEventAttendeeConsumer\u003e();\n            x.AddConsumer\u003cValidateRegistrationConsumer, ValidateRegistrationConsumerDefinition\u003e();\n            x.AddSagaStateMachine\u003cRegistrationStateMachine, RegistrationState, RegistrationStateDefinition\u003e()\n                .EntityFrameworkRepository(r =\u003e\n                {\n                    r.ExistingDbContext\u003cRegistrationDbContext\u003e();\n                    r.UsePostgres();\n                });\n\n            x.UsingRabbitMq((context, cfg) =\u003e\n            {\n                cfg.ConfigureEndpoints(context);\n            });\n        });\n\n--- src/Sample.Worker/Program.cs:8-14 (score 0.0161) ---\nusing Sample.Components;\nusing Sample.Components.Consumers;\nusing Sample.Components.Services;\nusing Sample.Components.StateMachines;\nusing Serilog;\nusing Serilog.Events;\n\n"}],"structuredContent":{"summary":{"scope":{"repo":"Sample-Outbox"},"blocks":3,"token_estimate":809,"truncated":false,"clipped":false},"blocks":[{"blob":33,"blob_sha":"4d3aab75d965c2f22497e2ba73f5b851ce1afa78","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/StateMachines/RegistrationStateDefinition.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/StateMachines/RegistrationStateDefinition.cs","start_line":1,"end_line":16,"score":0.04918032786885246,"lexical":16.57761035704056,"dense":0,"text":"namespace Sample.Components.StateMachines;\n\nusing MassTransit;\n\n\npublic class RegistrationStateDefinition :\n    SagaDefinition\u003cRegistrationState\u003e\n{\n    protected override void ConfigureSaga(IReceiveEndpointConfigurator endpointConfigurator,\n        ISagaConfigurator\u003cRegistrationState\u003e consumerConfigurator, IRegistrationContext context)\n    {\n        endpointConfigurator.UseMessageRetry(r =\u003e r.Intervals(10, 50, 100, 1000, 1000, 1000, 1000, 1000));\n\n        endpointConfigurator.UseEntityFrameworkOutbox\u003cRegistrationDbContext\u003e(context);\n    }\n}\n","clipped":false},{"blob":36,"blob_sha":"747277d2ae2a7eba0f6a3062b35f920f46c0fac2","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Worker/Program.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Worker/Program.cs","start_line":26,"end_line":89,"score":0.016129032258064516,"lexical":8.539212043984932,"dense":0,"text":"var host = Host.CreateDefaultBuilder(args)\n    .ConfigureServices((hostContext, services) =\u003e\n    {\n        services.AddDbContext\u003cRegistrationDbContext\u003e(x =\u003e\n        {\n            var connectionString = hostContext.Con