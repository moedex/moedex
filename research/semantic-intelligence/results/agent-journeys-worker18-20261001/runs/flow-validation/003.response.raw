;\n\n        endpointConfigurator.UseEntityFrameworkOutbox\u003cRegistrationDbContext\u003e(context);\n    }\n}\n\n--- src/Sample.Components/Services/IRegistrationValidationService.cs:1-6 (score 0.0159) ---\nnamespace Sample.Components.Services;\n\npublic interface IRegistrationValidationService\n{\n    Task ValidateRegistration(string eventId, string memberId, Guid registrationId);\n}\n"}],"structuredContent":{"summary":{"scope":{"repo":"Sample-Outbox"},"blocks":3,"token_estimate":386,"truncated":false,"clipped":false},"blocks":[{"blob":19,"blob_sha":"143941df6aeb8ccde274c49681290f3a74f5ddfa","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Consumers/ValidateRegistrationConsumer.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/Consumers/ValidateRegistrationConsumer.cs","start_line":1,"end_line":25,"score":0.01639344262295082,"lexical":45.60915131524642,"dense":0,"text":"namespace Sample.Components.Consumers;\n\nusing Contracts;\nusing MassTransit;\nusing Microsoft.Extensions.Logging;\nusing Services;\n\n\npublic class ValidateRegistrationConsumer :\n    IConsumer\u003cAddEventAttendee\u003e\n{\n    readonly ILogger\u003cValidateRegistrationConsumer\u003e _logger;\n    readonly IRegistrationValidationService _validationService;\n\n    public ValidateRegistrationConsumer(ILogger\u003cValidateRegistrationConsumer\u003e logger, IRegistrationValidationService validationService)\n    {\n        _logger = logger;\n        _validationService = validationService;\n    }\n\n    public async Task Consume(ConsumeContext\u003cAddEventAttendee\u003e context)\n    {\n        await _validationService.ValidateRegistration(context.Message.EventId, context.Message.MemberId, context.Message.RegistrationId);\n    }\n}\n","clipped":false},{"blob":20,"blob_sha":"8da055f13ea33f1c57870da5917481d7dfa94dcf","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","re