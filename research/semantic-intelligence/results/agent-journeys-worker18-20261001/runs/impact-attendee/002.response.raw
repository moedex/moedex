, cfg) =\u003e\n            {\n                cfg.ConfigureEndpoints(context);\n            });\n        });\n","clipped":false},{"blob":8,"blob_sha":"3bad1ba3e38bd4a17792fd2a39be61fc7dc62e63","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Api/Program.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Api/Program.cs","start_line":11,"end_line":24,"score":0.015151515151515152,"lexical":3.3798634947414086,"dense":0,"text":"using Sample.Api;\nusing Sample.Components;\nusing Serilog;\nusing Serilog.Events;\n\nLog.Logger = new LoggerConfiguration()\n    .MinimumLevel.Information()\n    .MinimumLevel.Override(\"MassTransit\", LogEventLevel.Debug)\n    .MinimumLevel.Override(\"Microsoft\", LogEventLevel.Warning)\n    .MinimumLevel.Override(\"Microsoft.EntityFrameworkCore\", LogEventLevel.Warning)\n    .MinimumLevel.Override(\"Microsoft.EntityFrameworkCore.Database.Command\", LogEventLevel.Warning)\n    .Enrich.FromLogContext()\n    .WriteTo.Console()\n    .CreateLogger();\n","clipped":false},{"blob":8,"blob_sha":"3bad1ba3e38bd4a17792fd2a39be61fc7dc62e63","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Api/Program.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Api/Program.cs","start_line":27,"end_line":37,"score":0.015151515151515152,"lexical":3.3798634947414086,"dense":0,"text":"\nbuilder.Host.UseSerilog();\n\nbuilder.Services.AddScoped\u003cIRegistrationService, RegistrationService\u003e();\n\nbuilder.Services.AddControllers();\n\nbuilder.Services.AddDbContext\u003cRegistrationDbContext\u003e(x =\u003e\n{\n    var connectionString = builder.Configuration.GetConnectionString(\"Default\");\n\n","clipped":false},{"blob":8,"blob_sha":"3bad1ba3e38bd4a17792fd2a39be61fc7dc62e63","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Api/Program.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Api/Program.cs","start_line":45,"end_line":71,"score":0.015151515151515152,"lexical":3.3798634947414086,"dense":0,"text":"    });\n});\n\nbuilder.Services.AddHostedService\u003cRecreateDatabaseHostedService\u003cRegistrationDbContext\u003e\u003e();\n\nbuilder.Services.AddOpenTelemetry().WithTracing(x =\u003e\n{\n    x.SetResourceBuilder(ResourceBuilder.CreateDefault()\n            .AddService(\"api\")\n            .AddTelemetrySdk()\n            .AddEnvironmentVariableDetector())\n        .AddSource(\"MassTransit\")\n        .AddAspNetCoreInstrumentation()\n        .AddJaegerExporter(o =\u003e\n        {\n            o.AgentHost = HostMetadataCache.IsRunningInContainer ? \"jaeger\" : \"localhost\";\n            o.AgentPort = 6831;\n            o.MaxPayloadSizeInBytes = 4096;\n            o.ExportProcessorType = ExportProcessorType.Batch;\n            o.BatchExportProcessorOptions = new BatchExportProcessorOptions\u003cActivity\u003e\n            {\n                MaxQueueSize = 2048,\n                ScheduledDelayMilliseconds = 5000,\n                ExporterTimeoutMilliseconds = 30000,\n                MaxExportBatchSize = 512,\n            };\n        });\n","clipped":false},{"blob":27,"blob_sha":"b0dcb76c7a4bb7b4dd888175c0ed754e63fbaefb","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/RegistrationDbContext.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/RegistrationDbContext.cs","start_line":23,"end_line":52,"score":0.014925373134328358,"lexical":2.7174390672085122,"dense":0,"text":"    protected override void OnModelCreating(ModelBuilder modelBuilder)\n    {\n        base.OnModelCreating(modelBuilder);\n\n        MapRegistration(modelBuilder);\n\n        modelBuilder.AddInboxStateEntity();\n        modelBuilder.AddOutboxMessageEntity();\n        modelBuilder.AddOutboxStateEntity();\n    }\n\n    static void MapRegistration(ModelBuilder modelBuilder)\n    {\n        EntityTypeBuilder\u003cRegistration\u003e registration = modelBuilder.Entity\u003cRegistration\u003e();\n\n        registration.Property(x =\u003e x.Id);\n        registration.HasKey(x =\u003e x.Id);\n\n        registration.Property(x =\u003e x.RegistrationId);\n        registration.Property(x =\u003e x.RegistrationDate);\n        registration.Property(x =\u003e x.MemberId).HasMaxLength(64);\n        registration.Property(x =\u003e x.EventId).HasMaxLength(64);\n        registration.Property(x =\u003e x.Payment);\n\n        registration.HasIndex(x =\u003e new\n        {\n            x.MemberId,\n            x.EventId\n        }).IsUnique();\n    }\n","clipped":false},{"blob":28,"blob_sha":"16d40af749971f67edae3e8ba485b24f5bbaa5e2","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/RegistrationService.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/RegistrationService.cs","start_line":21,"end_line":53,"score":0.014705882352941176,"lexical":2.2028700827650627,"dense":0,"text":"    public async Task\u003cRegistration\u003e SubmitRegistration(string eventId, string memberId, decimal payment)\n    {\n        var registration = new Registration\n        {\n            RegistrationId = NewId.NextGuid(),\n            RegistrationDate = DateTime.UtcNow,\n            MemberId = memberId,\n            EventId = eventId,\n            Payment = payment\n        };\n\n        await _dbContext.Set\u003cRegistration\u003e().AddAsync(registration);\n\n        await _publishEndpoint.Publish(new RegistrationSubmitted\n        {\n            RegistrationId = registration.RegistrationId,\n            RegistrationDate = registration.RegistrationDate,\n            MemberId = registration.MemberId,\n            EventId = registration.EventId,\n            Payment = payment\n        });\n\n        try\n        {\n            await _dbContext.SaveChangesAsync();\n        }\n        catch (DbUpdateException exception) when (exception.InnerException is PostgresException { SqlState: PostgresErrorCodes.UniqueViolation })\n        {\n            throw new DuplicateRegistrationException(\"Duplicate registration\", exception);\n        }\n\n        return registration;\n    }\n","clipped":false},{"blob":16,"blob_sha":"c921fa19ce379bd6ae59f5b334d022e6b8e0a4fa","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Consumers/NotifyRegistrationConsumer.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/Consumers/NotifyRegistrationConsumer.cs","start_line":18,"end_line":24,"score":0.014492753623188406,"lexical":0.9979730746927665,"dense":0,"text":"    public Task Consume(ConsumeContext\u003cRegistrationSubmitted\u003e context)\n    {\n        _logger.LogInformation(\"Member {MemberId} registered for event {EventId} on {RegistrationDate}\", context.Message.MemberId, context.Message.EventId,\n            context.Message.RegistrationDate);\n\n        return Task.CompletedTask;\n    }\n","clipped":false},{"blob":18,"blob_sha":"d3c539a54e03973d42fe8b2a1afeb54874fcbccd","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Consumers/SendRegistrationEmailConsumer.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/Consumers/SendRegistrationEmailConsumer.cs","start_line":18,"end_line":24,"score":0.014285714285714285,"lexical":0.9598432051824787,"dense":0,"text":"    public Task Consume(ConsumeContext\u003cSendRegistrationEmail\u003e context)\n    {\n        _logger.LogInformation(\"Notifying Member {MemberId} that they registered for event {EventId} on {RegistrationDate}\", context.Message.MemberId,\n            context.Message.EventId, context.Message.RegistrationDate);\n\n        return Task.CompletedTask;\n    }\n","clipped":false},{"blob":7,"blob_sha":"8b48b2f063e02e4eae61bac29ed1fef7c7424b63","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Api/Controllers/RegistrationController.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Api/Controllers/RegistrationController.cs","start_line":20,"end_line":45,"score":0.014084507042253521,"lexical":0.9355370427602508,"dense":0,"text":"    public async Task\u003cIActionResult\u003e Submit([FromBody] RegistrationModel model)\n    {\n        if (!ModelState.IsValid)\n            return BadRequest(ModelState);\n\n        try\n        {\n            var registration = await _registrationService.SubmitRegistration(model.EventId, model.MemberId, model.Payment);\n\n            return Ok(new\n            {\n                registration.RegistrationId,\n                registration.RegistrationDate,\n                registration.MemberId,\n                registration.EventId,\n            });\n        }\n        catch (DuplicateRegistrationException)\n        {\n            return Conflict(new\n            {\n                model.MemberId,\n                model.EventId,\n            });\n        }\n    }\n","clipped":false},{"blob":1,"blob_sha":"b49959f409c022164e94367f5f565a0cd07a3137","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"README.md","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/README.md","start_line":2,"end_line":10,"score":0.013888888888888888,"lexical":0.9177648123786584,"dense":0,"text":"\nThis sample shows how to configure and use MassTransit's new transactional outbox, including:\n\n- An API controller that uses a domain registration service to register a member for an event. The controller has no knowledge of MassTransit, and the registration service uses `IPublishEndpoint` to publish a domain event which is written to the transactional outbox.\n- Adds the transactional outbox delivery service as a hosted service, which delivers outbox message to the transport.\n- A separate service that consumes the domain event by itself, and also includes a saga state machine which uses the transactional outbox (and inbox, for idempotent message delivery).\n\n## Video\n\n","clipped":false},{"blob":25,"blob_sha":"0d663b6374eea699b6ebe16271d96f6c9d1b963d","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/IRegistrationService.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/IRegistrationService.cs","start_line":5,"end_line":5,"score":0.0136986301369863,"lexical":0.9017544136272304,"dense":0,"text":"    Task\u003cRegistration\u003e SubmitRegistration(string eventId, string memberId, decimal payment);\n","clipped":false},{"blob":12,"blob_sha":"7e32fb2bbdae09cc8c4d6e8402f1f5e555b5ff26","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Api/RegistrationResult.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Api/RegistrationResult.cs","start_line":3,"end_line":8,"score":0.013513513513513514,"lexical":0.8902504060824626,"dense":0,"text":"public class RegistrationResult\n{\n    public Guid RegistrationId { get; set; }\n    public string? EventId { get; set; }\n    public string? MemberId { get; set; }\n}\n","clipped":false},{"blob":30,"blob_sha":"c93fe4e3aa5df3627a3c62f3569935bc1a070b3c","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Services/IRegistrationValidationService.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/Services/IRegistrationValidationService.cs","start_line":5,"end_line":5,"score":0.013333333333333334,"lexical":0.8790362227244135,"dense":0,"text":"    Task ValidateRegistration(string eventId, string memberId, Guid registrationId);\n","clipped":false}]}}}