ple.Components/StateMachines/RegistrationStateMap.cs","start_line":8,"end_line":20,"score":0.012658227848101266,"lexical":0.8519382560639579,"dense":0,"text":"public class RegistrationStateMap :\n    SagaClassMap\u003cRegistrationState\u003e\n{\n    protected override void Configure(EntityTypeBuilder\u003cRegistrationState\u003e entity, ModelBuilder model)\n    {\n        entity.Property(x =\u003e x.CurrentState);\n        \n        entity.Property(x =\u003e x.RegistrationDate);\n        entity.Property(x =\u003e x.EventId);\n        entity.Property(x =\u003e x.MemberId);\n        entity.Property(x =\u003e x.Payment);\n    }\n}\n","clipped":false},{"blob":12,"blob_sha":"7e32fb2bbdae09cc8c4d6e8402f1f5e555b5ff26","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Api/RegistrationResult.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Api/RegistrationResult.cs","start_line":3,"end_line":8,"score":0.0125,"lexical":0.8415795494646914,"dense":0,"text":"public class RegistrationResult\n{\n    public Guid RegistrationId { get; set; }\n    public string? EventId { get; set; }\n    public string? MemberId { get; set; }\n}\n","clipped":false},{"blob":32,"blob_sha":"8c31c99ce866aa8ac9aa207f01f4cad985b28231","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/StateMachines/RegistrationState.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/StateMachines/RegistrationState.cs","start_line":6,"end_line":17,"score":0.012345679012345678,"lexical":0.7622111240901148,"dense":0,"text":"public class RegistrationState :\n    SagaStateMachineInstance\n{\n    public string CurrentState { get; set; } = null!;\n\n    public DateTime RegistrationDate { get; set; }\n\n    public string EventId { get; set; } = null!;\n    public string MemberId { get; set; } = null!;\n    public decimal Payment { get; set; }\n    public Guid CorrelationId { get; set; }\n}\n","clipped":false},{"blob":21,"blob_sha":"f9f0bc54914d7aaceb2739ce1c4af03c317b8188","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Contracts/AddEventAttendee.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/Contracts/AddEventAttendee.cs","start_line":3,"end_line":8,"score":0.012195121951219513,"lexical":0.6870277503137151,"dense":0,"text":"public record AddEventAttendee\n{\n    public Guid RegistrationId { get; init; }\n    public string MemberId { get; init; } = null!;\n    public string EventId { get; init; } = null!;\n}\n","clipped":false},{"blob":11,"blob_sha":"2b381af6f1ed92b3ad2ecbe264bcb878df93c448","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Api/RegistrationModel.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Api/RegistrationModel.cs","start_line":6,"end_line":16,"score":0.012048192771084338,"lexical":0.6730727535234301,"dense":0,"text":"public class RegistrationModel\n{\n    [Required]\n    public string EventId { get; set; } = null!;\n\n    [Required]\n    public string MemberId { get; set; } = null!;\n\n    [Required]\n    public decimal Payment { get; set; }\n}\n","clipped":false},{"blob":1,"blob_sha":"b49959f409c022164e94367f5f565a0cd07a3137","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"README.md","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/README.md","start_line":2,"end_line":8,"score":0.011904761904761904,"lexical":0.6302809068563014,"dense":0,"text":"\nThis sample shows how to configure and use MassTransit's new transactional outbox, including:\n\n- An API controller that uses a domain registration service to register a member for an event. The controller has no knowledge of MassTransit, and the registration service uses `IPublishEndpoint` to publish a domain event which is written to the transactional outbox.\n- Adds the transactional outbox delivery service as a hosted service, which delivers outbox message to the transport.\n- A separate service that consumes the domain event by itself, and also includes a saga state machine which uses the transactional outbox (and inbox, for idempotent message delivery).\n\n","clipped":false},{"blob":8,"blob_sha":"3bad1ba3e38bd4a17792fd2a39be61fc7dc62e63","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Api/Program.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Api/Program.cs","start_line":27,"end_line":51,"score":0.011764705882352941,"lexical":0.6232276246047553,"dense":0,"text":"\nbuilder.Host.UseSerilog();\n\nbuilder.Services.AddScoped\u003cIRegistrationService, RegistrationService\u003e();\n\nbuilder.Services.AddControllers();\n\nbuilder.Services.AddDbContext\u003cRegistrationDbContext\u003e(x =\u003e\n{\n    var connectionString = builder.Configuration.GetConnectionString(\"Default\");\n\n    x.UseNpgsql(connectionString, options =\u003e\n    {\n        options.MigrationsAssembly(Assembly.GetExecutingAssembly().GetName().Name);\n        options.MigrationsHistoryTable($\"__{nameof(RegistrationDbContext)}\");\n\n        options.EnableRetryOnFailure(5);\n        options.MinBatchSize(1);\n    });\n});\n\nbuilder.Services.AddHostedService\u003cRecreateDatabaseHostedService\u003cRegistrationDbContext\u003e\u003e();\n\nbuilder.Services.AddOpenTelemetry().WithTracing(x =\u003e\n{\n","clipped":false}]}}}