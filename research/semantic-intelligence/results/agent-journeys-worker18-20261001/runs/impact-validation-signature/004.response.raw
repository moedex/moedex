      });\n\n        services.AddOpenTelemetry().WithTracing(x =\u003e\n        {\n            x.SetResourceBuilder(ResourceBuilder.CreateDefault()\n                    .AddService(\"service\")\n                    .AddTelemetrySdk()\n                    .AddEnvironmentVariableDetector())\n                .AddSource(\"MassTransit\")\n                .AddJaegerExporter(o =\u003e\n                {\n                    o.AgentHost = HostMetadataCache.IsRunningInContainer ? \"jaeger\" : \"localhost\";\n                    o.AgentPort = 6831;\n                    o.MaxPayloadSizeInBytes = 4096;\n                    o.ExportProcessorType = ExportProcessorType.Batch;\n                    o.BatchExportProcessorOptions = new BatchExportProcessorOptions\u003cActivity\u003e\n                    {\n                        MaxQueueSize = 2048,\n                        ScheduledDelayMilliseconds = 5000,\n                        ExporterTimeoutMilliseconds = 30000,\n                        MaxExportBatchSize = 512,\n                    };\n                });\n        });\n\n        services.AddScoped\u003cIRegistrationValidationService, RegistrationValidationService\u003e();\n        services.AddMassTransit(x =\u003e\n        {\n            x.AddEntityFrameworkOutbox\u003cRegistrationDbContext\u003e(o =\u003e\n            {\n                o.UsePostgres();\n\n                o.DuplicateDetectionWindow = TimeSpan.FromSeconds(30);\n            });\n\n            x.SetKebabCaseEndpointNameFormatter();\n\n            x.AddConsumer\u003cNotifyRegistrationConsumer\u003e();\n            x.AddConsumer\u003cSendRegistrationEmailConsumer\u003e();\n            x.AddConsumer\u003cAddEventAttendeeConsumer\u003e();\n            x.AddConsumer\u003cValidateRegistrationConsumer, ValidateRegistrationConsumerDefinition\u003e();\n            x.AddSagaStateMachine\u003cRegistrationStateMachine, RegistrationState, RegistrationStateDefinition\u003e()\n                .EntityFrameworkRepository(r =\u003e\n                {\n                    r.ExistingDbContext\u003cRegistrationDbContext\u003e();\n                    r.UsePostgres();\n                });\n\n            x.UsingRabbitMq((context, cfg) =\u003e\n            {\n                cfg.ConfigureEndpoints(context);\n            });\n        });\n","clipped":false},{"blob":7,"blob_sha":"8b48b2f063e02e4eae61bac29ed1fef7c7424b63","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Api/Controllers/RegistrationController.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Api/Controllers/RegistrationController.cs","start_line":9,"end_line":46,"score":0.015151515151515152,"lexical":0.9810850985490911,"dense":0,"text":"public class RegistrationController :\n    ControllerBase\n{\n    readonly IRegistrationService _registrationService;\n\n    public RegistrationController(IRegistrationService registrationService)\n    {\n        _registrationService = registrationService;\n    }\n\n    [HttpPost]\n    public async Task\u003cIActionResult\u003e Submit([FromBody] RegistrationModel model)\n    {\n        if (!ModelState.IsValid)\n            return BadRequest(ModelState);\n\n        try\n        {\n            var registration = await _registrationService.SubmitRegistration(model.EventId, model.MemberId, model.Payment);\n\n            return Ok(new\n            {\n                registration.RegistrationId,\n                registration.RegistrationDate,\n                registration.MemberId,\n                registration.EventId,\n            });\n        }\n        catch (DuplicateRegistrationException)\n        {\n            return Conflict(new\n            {\n                model.MemberId,\n                model.EventId,\n            });\n        }\n    }\n}\n","clipped":false},{"blob":28,"blob_sha":"16d40af749971f67edae3e8ba485b24f5bbaa5e2","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/RegistrationService.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/RegistrationService.cs","start_line":9,"end_line":54,"score":0.014925373134328358,"lexical":0.9743371937025301,"dense":0,"text":"public class RegistrationService :\n    IRegistrationService\n{\n    readonly RegistrationDbContext _dbContext;\n    readonly IPublishEndpoint _publishEndpoint;\n\n    public RegistrationService(RegistrationDbContext dbContext, IPublishEndpoint publishEndpoint)\n    {\n        _dbContext = dbContext;\n        _publishEndpoint = publishEndpoint;\n    }\n\n    public async Task\u003cRegistration\u003e SubmitRegistration(string eventId, string memberId, decimal payment)\n    {\n        var registration = new Registration\n        {\n            RegistrationId = NewId.NextGuid(),\n            RegistrationDate = DateTime.UtcNow,\n            MemberId = memberId,\n            EventId = eventId,\n            Payment = payment\n        };\n\n        await _dbContext.Set\u003cRegistration\u003e().AddAsync(registration);\n\n        await _publishEndpoint.Publish(new RegistrationSubmitted\n        {\n            RegistrationId = registration.RegistrationId,\n            RegistrationDate = registration.RegistrationDate,\n            MemberId = registration.MemberId,\n            EventId = registration.EventId,\n            Payment = payment\n        });\n\n        try\n        {\n            await _dbContext.SaveChangesAsync();\n        }\n        catch (DbUpdateException exception) when (exception.InnerException is PostgresException { SqlState: PostgresErrorCodes.UniqueViolation })\n        {\n            throw new DuplicateRegistrationException(\"Duplicate registration\", exception);\n        }\n\n        return registration;\n    }\n}\n","clipped":false},{"blob":27,"blob_sha":"b0dcb76c7a4bb7b4dd888175c0ed754e63fbaefb","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_