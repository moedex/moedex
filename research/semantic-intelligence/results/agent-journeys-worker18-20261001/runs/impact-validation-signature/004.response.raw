0/corpus/Sample-Outbox/src/Sample.Components/Consumers/NotifyRegistrationConsumer.cs","start_line":8,"end_line":25,"score":0.014492753623188406,"lexical":0.9319511365897076,"dense":0,"text":"public class NotifyRegistrationConsumer :\n    IConsumer\u003cRegistrationSubmitted\u003e\n{\n    readonly ILogger\u003cNotifyRegistrationConsumer\u003e _logger;\n\n    public NotifyRegistrationConsumer(ILogger\u003cNotifyRegistrationConsumer\u003e logger)\n    {\n        _logger = logger;\n    }\n\n    public Task Consume(ConsumeContext\u003cRegistrationSubmitted\u003e context)\n    {\n        _logger.LogInformation(\"Member {MemberId} registered for event {EventId} on {RegistrationDate}\", context.Message.MemberId, context.Message.EventId,\n            context.Message.RegistrationDate);\n\n        return Task.CompletedTask;\n    }\n}\n","clipped":false},{"blob":34,"blob_sha":"c4c0d599e4a84ce476c9263aea320abbc8f98b72","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/StateMachines/RegistrationStateMachine.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/StateMachines/RegistrationStateMachine.cs","start_line":7,"end_line":48,"score":0.014285714285714285,"lexical":0.9286006028008837,"dense":0,"text":"public class RegistrationStateMachine :\n    MassTransitStateMachine\u003cRegistrationState\u003e\n{\n    public RegistrationStateMachine()\n    {\n        InstanceState(x =\u003e x.CurrentState);\n\n        Event(() =\u003e RegistrationSubmitted, x =\u003e x.CorrelateById(m =\u003e m.Message.RegistrationId));\n\n        Initially(\n            When(RegistrationSubmitted)\n                .Then(context =\u003e\n                {\n                    context.Saga.RegistrationDate = context.Message.RegistrationDate;\n                    context.Saga.EventId = context.Message.EventId;\n                    context.Saga.MemberId = context.Message.MemberId;\n                    context.Saga.Payment = context.Message.Payment;\n                })\n                .TransitionTo(Registered)\n                .Publish(context =\u003e new SendRegistrationEmail\n                {\n                    RegistrationId = context.Saga.CorrelationId,\n                    RegistrationDate = context.Saga.RegistrationDate,\n                    EventId = context.Saga.EventId,\n                    MemberId = context.Saga.MemberId\n                })\n                .If(context =\u003e context.Saga.Payment \u003c 50m \u0026\u0026 context.GetRetryAttempt() == 0,\n                    fail =\u003e fail.Then(_ =\u003e throw new ApplicationException(\"Totally random, but you didn't pay enough for quality service\")))\n                .Publish(context =\u003e new AddEventAttendee\n                {\n                    RegistrationId = context.Saga.CorrelationId,\n                    EventId = context.Saga.EventId,\n                    MemberId = context.Saga.MemberId\n                })\n        );\n    }\n\n    //\n    // ReSharper disable MemberCanBePrivate.Global\n    public State Registered { get; } = null!;\n    public Event\u003cRegistrationSubmitted\u003e RegistrationSubmitted { get; } = null!;\n}\n","clipped":false},{"blob":18,"blob_sha":"d3c539a54e03973d42fe8b2a1afeb54874fcbccd","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Consumers/SendRegistrationEmailConsumer.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/Consumers/SendRegistrationEmailConsumer.cs","start_line":8,"end_line":25,"score":0.014084507042253521,"lexical":0.9158523889158618,"dense":0,"text":"public class SendRegistrationEmailConsumer :\n    IConsumer\u003cSendRegistrationEmail\u003e\n{\n    readonly ILogger\u003cSendRegistrationEmailConsumer\u003e _logger;\n\n    public SendRegistrationEmailConsumer(ILogger\u003cSendRegistrationEmailConsumer\u003e logger)\n    {\n        _logger = logger;\n    }\n\n    public Task Consume(ConsumeContext\u003cSendRegistrationEmail\u003e context)\n    {\n        _logger.LogInformation(\"Notifying Member {MemberId} that they registered for event {EventId} on {RegistrationDate}\", context.Message.MemberId,\n            context.Message.EventId, context.Message.RegistrationDate);\n\n        return Task.CompletedTask;\n    }\n}\n","clipped":false},{"blob":24,"blob_sha":"8d3cd2683926f2820c7a98a9305af1ef5d209845","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/DuplicateRegistrationException.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/DuplicateRegistrationException.cs","start_line":4,"end_line":18,"score":0.013888888888888888,"lexical":0.9067209096593783,"dense":0,"text":"public class DuplicateRegistrationException :\n    Exception\n{\n    public DuplicateRegistrationException()\n    {\n    }\n\n    public DuplicateRegistrationException(string? message) : base(message)\n    {\n    }\n\n    public DuplicateRegistrationException(string? message, Exception? innerException) : base(message, innerException)\n    {\n    }\n}\n","clipped":false},{"blob":25,"blob_sha":"0d663b6374eea699b6ebe16271d96f6c9d1b963d","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/IRegistrationService.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/journey-readiness/capture-sdk10/corpus/Sample-Outbox/src/Sample.Components/IRegistrationService.cs","start_line":3,"end_line":6,"score":0.0136986301369863,"lexical":0.9048330253642471,"dense":0,"text":"public interface IRegistrationService\n{\n    Task\u003cRegistration\u003e SubmitRegistration(string eventId, string memberId, decimal payment);\n}\n","clipped":false},{"blob":33,"blob_sha":"4d3aab75d965c2f22497e2ba73f5b851ce1afa78","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src