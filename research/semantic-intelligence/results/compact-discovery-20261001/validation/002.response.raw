                 .AddService(\"service\")\n43 |                     .AddTelemetrySdk()\n44 |                     .AddEnvironmentVariableDetector())\n45 |                 .AddSource(\"MassTransit\")\n46 |                 .AddJaegerExporter(o =\u003e\n47 |                 {\n48 |                     o.AgentHost = HostMetadataCache.IsRunningInContainer ? \"jaeger\" : \"localhost\";\n49 |                     o.AgentPort = 6831;\n50 |                     o.MaxPayloadSizeInBytes = 4096;\n51 |                     o.ExportProcessorType = ExportProcessorType.Batch;\n52 |                     o.BatchExportProcessorOptions = new BatchExportProcessorOptions\u003cActivity\u003e\n53 |                     {\n54 |                         MaxQueueSize = 2048,\n55 |                         ScheduledDelayMilliseconds = 5000,\n56 |                         ExporterTimeoutMilliseconds = 30000,\n57 |                         MaxExportBatchSize = 512,\n58 |                     };\n59 |                 });\n60 |         });\n61 | \n62 |         services.AddScoped\u003cIRegistrationValidationService, RegistrationValidationService\u003e();\n63 |         services.AddMassTransit(x =\u003e\n64 |         {\n65 |             x.AddEntityFrameworkOutbox\u003cRegistrationDbContext\u003e(o =\u003e\n66 |             {\n67 |                 o.UsePostgres();\n68 | \n69 |                 o.DuplicateDetectionWindow = TimeSpan.FromSeconds(30);\n70 |             });\n71 | \n72 |             x.SetKebabCaseEndpointNameFormatter();\n73 | \n74 |             x.AddConsumer\u003cNotifyRegistrationConsumer\u003e();\n75 |             x.AddConsumer\u003cSendRegistrationEmailConsumer\u003e();\n76 |             x.AddConsumer\u003cAddEventAttendeeConsumer\u003e();\n77 |             x.AddConsumer\u003cValidateRegistrationConsumer, ValidateRegistrationConsumerDefinition\u003e();\n78 |             x.AddSagaStateMachine\u003cRegistrationStateMachine, RegistrationState, RegistrationStateDefinition\u003e()\n79 |                 .EntityFrameworkRepository(r =\u003e\n80 |                 {\n81 |                     r.ExistingDbContext\u003cRegistrationDbContext\u003e();\n82 |                     r.UsePostgres();\n83 |                 });\n84 | \n85 |             x.UsingRabbitMq((context, cfg) =\u003e\n86 |             {\n87 |                 cfg.ConfigureEndpoints(context);\n88 |             });\n89 |         });\n90 |     })\n91 |     .UseSerilog()\n92 |     .Build();\n93 | \n94 | await host.RunAsync();\n"}],"structuredContent":{"repo":"Sample-Outbox","path":"src/Sample.Worker/Program.cs","blob_sha":"747277d2ae2a7eba0f6a3062b35f920f46c0fac2","lines":94,"start_line":1,"end_line":94,"truncated":false,"content":"using System.Diagnostics;\nusing MassTransit;\nusing MassTransit.Metadata;\nusing Microsoft.EntityFrameworkCore;\nusing OpenTelemetry;\nusing OpenTelemetry.Resources;\nusing OpenTelemetry.Trace;\nusing Sample.Components;\nusing Sample.Components.Consumers;\nusing Sample.Components.Services;\nusing Sample.Components.StateMachines;\nusing Serilog;\nusing Serilog.Events;\n\nLog.Logger = new LoggerConfiguration()\n    .MinimumLevel.Information()\n    .MinimumLevel.Override(\"MassTransit\", LogEventLevel.Debug)\n    .MinimumLevel.Override(\"Microsoft\", LogEventLevel.Warning)\n    .MinimumLevel.Override(\"Microsoft.EntityFrameworkCore\", LogEventLevel.Warning)\n    .MinimumLevel.Override(\"Microsoft.EntityFrameworkCore.Database.Command\", LogEventLevel.Warning)\n    .Enrich.FromLogContext()\n    .WriteTo.Console()\n    .CreateLogger();\n\n\nvar host = Host.CreateDefaultBuilder(args)\n    .ConfigureServices((hostContext, services) =\u003e\n    {\n        services.AddDbContext\u003cRegistrationDbContext\u003e(x =\u003e\n        {\n            var connectionString = hostContext.Configuration.GetConnectionString(\"Default\");\n\n            x.UseNpgsql(connectionString, options =\u003e\n            {\n                options.MinBatchSize(1);\n            });\n        });\n\n        services.AddOpenTelemetry().WithTracing(x =\u003e\n        {\n            x.SetResourceBuilder(ResourceBuilder.CreateDefault()\n                    .AddService(\"service\")\n                    .AddTelemetrySdk()\n                    .AddEnvironmentVariableDetector())\n                .AddSource(\"MassTransit\")\n                .AddJaegerExporter(o =\u003e\n                {\n                    o.AgentHost = HostMetadataCache.IsRunningInContainer ? \"jaeger\" : \"localhost\";\n                    o.AgentPort = 6831;\n                    o.MaxPayloadSizeInBytes = 4096;\n                    o.ExportProcessorType = ExportProcessorType.Batch;\n                    o.BatchExportProcessorOptions = new BatchExportProcessorOptions\u003cActivity\u003e\n                    {\n                        MaxQueueSize = 2048,\n                        ScheduledDelayMilliseconds = 5000,\n                        ExporterTimeoutMilliseconds = 30000,\n                        MaxExportBatchSize = 512,\n                    };\n                });\n        });\n\n        services.AddScoped\u003cIRegistrationValidationService, RegistrationValidationService\u003e();\n        services.AddMassTransit(x =\u003e\n        {\n            x.AddEntityFrameworkOutbox\u003cRegistrationDbContext\u003e(o =\u003e\n            {\n                o.UsePostgres();\n\n                o.DuplicateDetectionWindow = TimeSpan.FromSeconds(30);\n            });\n\n            x.SetKebabCaseEndpointNameFormatter();\n\n            x.AddConsumer\u003cNotifyRegistrationConsumer\u003e();\n            x.AddConsumer\u003cSendRegistrationEmailConsumer\u003e();\n            x.AddConsumer\u003cAddEventAttendeeConsumer\u003e();\n            x.AddConsumer\u003cValidateRegistrationConsumer, ValidateRegistrationConsumerDefinition\u003e();\n            x.AddSagaStateMachine\u003cRegistrationStateMachine, RegistrationState, RegistrationStateDefinition\u003e()\n                .EntityFrameworkRepository(r =\u003e\n                {\n                    r.ExistingDbContext\u003cRegistrationDbContext\u003e();\n                    r.UsePostgres();\n                });\n\n            x.UsingRabbitMq((context, cfg) =\u003e\n            {\n                cfg.ConfigureEndpoints(context);\n            });\n        });\n    })\n    .UseSerilog()\n    .Build();\n\nawait host.RunAsync();"}}}