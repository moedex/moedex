ntext.Configuration.GetConnectionString(\"Default\");\n\n            x.UseNpgsql(connectionString, options =\u003e\n            {\n                options.MinBatchSize(1);\n            });\n        });\n\n        services.AddOpenTelemetry().WithTracing(x =\u003e\n        {\n            x.SetResourceBuilder(ResourceBuilder.CreateDefault()\n                    .AddService(\"service\")\n                    .AddTelemetrySdk()\n                    .AddEnvironmentVariableDetector())\n                .AddSource(\"MassTransit\")\n                .AddJaegerExporter(o =\u003e\n                {\n                    o.AgentHost = HostMetadataCache.IsRunningInContainer ? \"jaeger\" : \"localhost\";\n                    o.AgentPort = 6831;\n                    o.MaxPayloadSizeInBytes = 4096;\n                    o.ExportProcessorType = ExportProcessorType.Batch;\n                    o.BatchExportProcessorOptions = new BatchExportProcessorOptions\u003cActivity\u003e\n                    {\n                        MaxQueueSize = 2048,\n                        ScheduledDelayMilliseconds = 5000,\n                        ExporterTimeoutMilliseconds = 30000,\n                        MaxExportBatchSize = 512,\n                    };\n                });\n        });\n\n        services.AddScoped\u003cIRegistrationValidationService, RegistrationValidationService\u003e();\n        services.AddMassTransit(x =\u003e\n        {\n            x.AddEntityFrameworkOutbox\u003cRegistrationDbContext\u003e(o =\u003e\n            {\n                o.UsePostgres();\n\n                o.DuplicateDetectionWindow = TimeSpan.FromSeconds(30);\n            });\n\n            x.SetKebabCaseEndpointNameFormatter();\n\n            x.AddConsumer\u003cNotifyRegistrationConsumer\u003e();\n            x.AddConsumer\u003cSendRegistrationEmailConsumer\u003e();\n            x.AddConsumer\u003cAddEventAttendeeConsumer\u003e();\n            x.AddConsumer\u003cValidateRegistrationConsumer, ValidateRegistrationConsumerDefinition\u003e();\n            x.AddSagaStateMachine\u003cRegistrationStateMachine, RegistrationState, RegistrationStateDefinition\u003e()\n                .EntityFrameworkRepository(r =\u003e\n                {\n                    r.ExistingDbContext\u003cRegistrationDbContext\u003e();\n                    r.UsePostgres();\n                });\n\n            x.UsingRabbitMq((context, cfg) =\u003e\n            {\n                cfg.ConfigureEndpoints(context);\n            });\n        });\n    })\n    .UseSerilog()\n    .Build();\n","clipped":false},{"blob":10,"blob_sha":"6cf9165ffb74f0dc7e11df6b5d59ff911059d146","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Api/RecreateDatabaseHostedService.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Api/RecreateDatabaseHostedService.cs","start_line":8,"end_line":53,"score":0.014925373134328358,"lexical":8.323547204608802,"dense":0,"text":"public class RecreateDatabaseHostedService\u003cTDbContext\u003e :\n    IHostedService\n    where TDbContext : DbContext\n{\n    readonly ILogger\u003cRecreateDatabaseHostedService\u003cTDbContext\u003e\u003e _logger;\n    readonly IServiceScopeFactory _scopeFactory;\n    TDbContext? _context;\n\n    public RecreateDatabaseHostedService(IServiceScopeFactory scopeFactory, ILogger\u003cRecreateDatabaseHostedService\u003cTDbContext\u003e\u003e logger)\n    {\n        _scopeFactory = scopeFactory;\n        _logger = logger;\n    }\n\n    public async Task StartAsync(CancellationToken cancellationToken)\n    {\n        _logger.LogInformation(\"Applying migrations for {DbContext}\", TypeCache\u003cTDbContext\u003e.ShortName);\n\n        await Retry.Interval(20, TimeSpan.FromSeconds(3)).Retry(async () =\u003e\n        {\n            var scope = _scopeFactory.CreateScope();\n\n            try\n            {\n                _context = scope.ServiceProvider.GetRequiredService\u003cTDbContext\u003e();\n\n                await _context.Database.EnsureDeletedAsync(cancellationToken);\n                await _context.Database.EnsureCreatedAsync(cancellationToken);\n\n                _logger.LogInformation(\"Migrations completed for {DbContext}\", TypeCache\u003cTDbContext\u003e.ShortName);\n            }\n            finally\n            {\n                if (scope is IAsyncDisposable asyncDisposable)\n                    await asyncDisposable.DisposeAsync();\n                else\n                    scope.Dispose();\n            }\n        }, cancellationToken);\n    }\n\n    public Task StopAsync(CancellationToken cancellationToken)\n    {\n        return Task.CompletedTask;\n    }\n}\n","clipped":false},{"blob":34,"blob_sha":"c4c0d599e4a84ce476c9263aea320abbc8f98b72","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/StateMachines/RegistrationStateMachine.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Components/StateMachines/RegistrationStateMachine.cs","start_line":7,"end_line":48,"score":0.014705882352941176,"lexical":3.1720757733010867,"dense":0,"text":"public class RegistrationStateMachine :\n    MassTransitStateMachine\u003cRegistrationState\u003e\n{\n    public RegistrationStateMachine()\n    {\n        InstanceState(x =\u003e x.CurrentState);\n\n        Event(() =\u003e RegistrationSubmitted, x =\u003e x.CorrelateById(m =\u003e m.Message.RegistrationId));\n\n        Initially(\n            When(RegistrationSubmitted)\n                .Then(context =\u003e\n                {\n                    context.Saga.RegistrationDate = context.Message.RegistrationDate;\n                    context.Saga.EventId = context.Message.EventId;\n                    context.Saga.MemberId = context.Message.MemberId;\n                    context.Saga.Payment = context.Message.Payment;\n                })\n                .TransitionTo(Registered)\n                .Publish(context =\u003e new SendRegistrationEmail\n                {\n                    RegistrationId = context.Saga.CorrelationId,\n                    RegistrationDate = context.Saga.RegistrationDate,\n                    EventId = context.Saga.EventId,\n                    MemberId = context.Saga.MemberId\n                })\n                .If(context =\u003e context.Saga.Payment \u003c 50m \u0026\u0026 context.GetRetryAttempt() == 0,\n                    fail =\u003e fail.Then(_ =\u003e throw new ApplicationException(\"Totally random, but you didn't pay enough for quality service\")))\n                .Publish(context =\u003e new AddEventAttendee\n                {\n                    RegistrationId = context.Saga.CorrelationId,\n                    EventId = context.Saga.EventId,\n                    MemberId = context.Saga.MemberId\n                })\n        );\n    }\n\n    //\n    // ReSharper disable MemberCanBePrivate.Global\n    public State Registered { get; } = null!;\n    public Event\u003cRegistrationSubmitted\u003e RegistrationSubmitted { get; } = null!;\n}\n","clipped":false},{"blob":16,"blob_sha":"c921fa19ce379bd6ae59f5b334d022e6b8e0a4fa","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Consumers/NotifyRegistrationConsumer.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Components/Consumers/NotifyRegistrationConsumer.cs","start_line":8,"end_line":25,"score":0.014492753623188406,"lexical":2.979345539332644,"dense":0,"text":"public class NotifyRegistrationConsumer :\n    IConsumer\u003cRegistrationSubmitted\u003e\n{\n    readonly ILogger\u003cNotifyRegistrationConsumer\u003e _logger;\n\n    public NotifyRegistrationConsumer(ILogger\u003cNotifyRegistrationConsumer\u003e logger)\n    {\n        _logger = logger;\n    }\n\n    public Task Consume(ConsumeContext\u003cRegistrationSubmitted\u003e context)\n    {\n        _logger.LogInformation(\"Member {MemberId} registered for event {EventId} on {RegistrationDate}\", context.Message.MemberId, context.Message.EventId,\n            context.Message.RegistrationDate);\n\n        return Task.CompletedTask;\n    }\n}\n","clipped":false},{"blob":18,"blob_sha":"d3c539a54e03973d42fe8b2a1afeb54874fcbccd","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Consumers/SendRegistrationEmailConsumer.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Components/Consumers/SendRegistrationEmailConsumer.cs","start_line":8,"end_line":25,"score":0.014285714285714285,"lexical":2.9105599165935736,"dense":0,"text":"public class SendRegistrationEmailConsumer :\n    IConsumer\u003cSendRegistrationEmail\u003e\n{\n    readonly ILogger\u003cSendRegistrationEmailConsumer\u003e _logger;\n\n    public SendRegistrationEmailConsumer(ILogger\u003cSendRegistrationEmailConsumer\u003e logger)\n    {\n        _logger = logger;\n    }\n\n    public Task Consume(ConsumeContext\u003cSendRegistrationEmail\u003e context)\n    {\n        _logger.LogInformation(\"Notifying Member {MemberId} that they registered for event {EventId} on {RegistrationDate}\", context.Message.MemberId,\n            context.Message.EventId, context.Message.RegistrationDate);\n\n        return Task.CompletedTask;\n    }\n}\n","clipped":false}]}}}