{"jsonrpc":"2.0","id":3,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"c08c410b6f87d0fb57705d2e42bc232af92a29cc4c27aaf8a3a1a8b926b94434","blob_shas":["0d663b6374eea699b6ebe16271d96f6c9d1b963d","143941df6aeb8ccde274c49681290f3a74f5ddfa","16d40af749971f67edae3e8ba485b24f5bbaa5e2","8b48b2f063e02e4eae61bac29ed1fef7c7424b63","c93fe4e3aa5df3627a3c62f3569935bc1a070b3c"]}},"content":[{"type":"text","text":"5 context block(s), ~968 tokens\n\n--- src/Sample.Components/IRegistrationService.cs:1-6 (score 0.0489) ---\nnamespace Sample.Components;\n\npublic interface IRegistrationService\n{\n    Task\u003cRegistration\u003e SubmitRegistration(string eventId, string memberId, decimal payment);\n}\n\n--- src/Sample.Components/Services/IRegistrationValidationService.cs:1-6 (score 0.0313) ---\nnamespace Sample.Components.Services;\n\npublic interface IRegistrationValidationService\n{\n    Task ValidateRegistration(string eventId, string memberId, Guid registrationId);\n}\n\n--- src/Sample.Api/Controllers/RegistrationController.cs:1-46 (score 0.0164) ---\nnamespace Sample.Api.Controllers;\n\nusing Components;\nusing Microsoft.AspNetCore.Mvc;\n\n\n[ApiController]\n[Route(\"[controller]\")]\npublic class RegistrationController :\n    ControllerBase\n{\n    readonly IRegistrationService _registrationService;\n\n    public RegistrationController(IRegistrationService registrationService)\n    {\n        _registrationService = registrationService;\n    }\n\n    [HttpPost]\n    public async Task\u003cIActionResult\u003e Submit([FromBody] RegistrationModel model)\n    {\n        if (!ModelState.IsValid)\n            return BadRequest(ModelState);\n\n        try\n        {\n            var registration = await _registrationService.SubmitRegistration(model.EventId, model.MemberId, model.Payment);\n\n            return Ok(new\n            {\n                registration.RegistrationId,\n                registration.RegistrationDate,\n                registration.MemberId,\n                registration.EventId,\n            });\n        }\n        catch (DuplicateRegistrationException)\n        {\n            return Conflict(new\n            {\n                model.MemberId,\n                model.EventId,\n            });\n        }\n    }\n}\n\n--- src/Sample.Components/RegistrationService.cs:1-54 (score 0.0159) ---\nnamespace Sample.Components;\n\nusing Contracts;\nusing MassTransit;\nusing Microsoft.EntityFrameworkCore;\nusing Npgsql;\n\n\npublic class RegistrationService :\n    IRegistrationService\n{\n    readonly RegistrationDbContext _dbContext;\n    readonly IPublishEndpoint _publishEndpoint;\n\n    public RegistrationService(RegistrationDbContext dbContext, IPublishEndpoint publishEndpoint)\n    {\n        _dbContext = dbContext;\n        _publishEndpoint = publishEndpoint;\n    }\n\n    public async Task\u003cRegistration\u003e SubmitRegistration(string eventId, string memberId, decimal payment)\n    {\n        var registration = new Registration\n        {\n            RegistrationId = NewId.NextGuid(),\n            RegistrationDate = DateTime.UtcNow,\n            MemberId = memberId,\n            EventId = eventId,\n            Payment = payment\n        };\n\n        await _dbContext.Set\u003cRegistration\u003e().AddAsync(registration);\n\n        await _publishEndpoint.Publish(new RegistrationSubmitted\n        {\n            RegistrationId = registration.RegistrationId,\n            RegistrationDate = registration.RegistrationDate,\n            MemberId = registration.MemberId,\n            EventId = registration.EventId,\n            Payment = payment\n        });\n\n        try\n        {\n            await _dbContext.SaveChangesAsync();\n        }\n        catch (DbUpdateException exception) when (exception.InnerException is PostgresException { SqlState: PostgresErrorCodes.UniqueViolation })\n        {\n            throw new DuplicateRegistrationException(\"Duplicate registration\", exception);\n        }\n\n        return registration;\n    }\n}\n\n--- src/Sample.Components/Consumers/ValidateRegistrationConsumer.cs:1-25 (score 0.0156) ---\nnamespace Sample.Components.Consumers;\n\nusing Contracts;\nusing MassTransit;\nusing Microsoft.Extensions.Logging;\nusing Services;\n\n\npublic class ValidateRegistrationConsumer :\n    IConsumer\u003cAddEventAttendee\u003e\n{\n    readonly ILogger\u003cValidateRegistrationConsumer\u003e _logger;\n    readonly IRegistrationValidationService _validationService;\n\n    public ValidateRegistrationConsumer(ILogger\u003cValidateRegistrationConsumer\u003e logger, IRegistrationValidationService validationService)\n    {\n        _logger = logger;\n        _validationService = validationService;\n    }\n\n    public async Task Consume(ConsumeContext\u003cAddEventAttendee\u003e context)\n    {\n        await _validationService.ValidateRegistration(context.Message.EventId, context.Message.MemberId, context.Message.RegistrationId);\n    }\n}\n"}],"structuredContent":{"summary":{"scope":{"repo":"Sample-Outbox"},"blocks":5,"token_estimate":968,"truncated":false,"clipped":false},"blocks":[{"blob":25,"blob_sha":"0d663b6374eea699b6ebe16271d96f6c9d1b963d","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/IRegistrationService.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Components/IRegistrationService.cs","start_line":1,"end_line":6,"score":0.048915917503966164,"lexical":12.629958246732139,"dense":0,"text":"namespace Sample.Components;\n\npublic interface IRegistrationService\n{\n    Task\u003cRegistration\u003e SubmitRegistration(string eventId, string memberId, decimal payment);\n}\n","clipped":false},{"blob":30,"blob_sha":"c93fe4e3aa5df3627a3c62f3569935bc1a070b3c","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Services/IRegistrationVal