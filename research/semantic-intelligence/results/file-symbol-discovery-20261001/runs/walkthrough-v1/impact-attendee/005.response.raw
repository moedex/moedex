{"jsonrpc":"2.0","id":5,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"c08c410b6f87d0fb57705d2e42bc232af92a29cc4c27aaf8a3a1a8b926b94434","blob_shas":["143941df6aeb8ccde274c49681290f3a74f5ddfa","747277d2ae2a7eba0f6a3062b35f920f46c0fac2","8da055f13ea33f1c57870da5917481d7dfa94dcf","c921fa19ce379bd6ae59f5b334d022e6b8e0a4fa","c93fe4e3aa5df3627a3c62f3569935bc1a070b3c"]}},"content":[{"type":"text","text":"8 context block(s), ~1211 tokens\n\n--- src/Sample.Components/Consumers/ValidateRegistrationConsumer.cs:1-4 (score 0.0492) ---\nnamespace Sample.Components.Consumers;\n\nusing Contracts;\nusing MassTransit;\n\n--- src/Sample.Components/Consumers/ValidateRegistrationConsumer.cs:9-25 (score 0.0492) ---\npublic class ValidateRegistrationConsumer :\n    IConsumer\u003cAddEventAttendee\u003e\n{\n    readonly ILogger\u003cValidateRegistrationConsumer\u003e _logger;\n    readonly IRegistrationValidationService _validationService;\n\n    public ValidateRegistrationConsumer(ILogger\u003cValidateRegistrationConsumer\u003e logger, IRegistrationValidationService validationService)\n    {\n        _logger = logger;\n        _validationService = validationService;\n    }\n\n    public async Task Consume(ConsumeContext\u003cAddEventAttendee\u003e context)\n    {\n        await _validationService.ValidateRegistration(context.Message.EventId, context.Message.MemberId, context.Message.RegistrationId);\n    }\n}\n\n--- src/Sample.Components/Consumers/ValidateRegistrationConsumerDefinition.cs:1-16 (score 0.0484) ---\nnamespace Sample.Components.Consumers;\n\nusing MassTransit;\n\n\npublic class ValidateRegistrationConsumerDefinition :\n    ConsumerDefinition\u003cValidateRegistrationConsumer\u003e\n{\n    protected override void ConfigureConsumer(IReceiveEndpointConfigurator endpointConfigurator,\n        IConsumerConfigurator\u003cValidateRegistrationConsumer\u003e consumerConfigurator, IRegistrationContext context)\n    {\n        endpointConfigurator.UseMessageRetry(r =\u003e r.Intervals(10, 50, 100, 1000, 1000, 1000, 1000, 1000));\n\n        endpointConfigurator.UseEntityFrameworkOutbox\u003cRegistrationDbContext\u003e(context);\n    }\n}\n\n--- src/Sample.Worker/Program.cs:26-89 (score 0.0159) ---\nvar host = Host.CreateDefaultBuilder(args)\n    .ConfigureServices((hostContext, services) =\u003e\n    {\n        services.AddDbContext\u003cRegistrationDbContext\u003e(x =\u003e\n        {\n            var connectionString = hostContext.Configuration.GetConnectionString(\"Default\");\n\n            x.UseNpgsql(connectionString, options =\u003e\n            {\n                options.MinBatchSize(1);\n            });\n        });\n\n        services.AddOpenTelemetry().WithTracing(x =\u003e\n        {\n            x.SetResourceBuilder(ResourceBuilder.CreateDefault()\n                    .AddService(\"service\")\n                    .AddTelemetrySdk()\n                    .AddEnvironmentVariableDetector())\n                .AddSource(\"MassTransit\")\n                .AddJaegerExporter(o =\u003e\n                {\n                    o.AgentHost = HostMetadataCache.IsRunningInContainer ? \"jaeger\" : \"localhost\";\n                    o.AgentPort = 6831;\n                    o.MaxPayloadSizeInBytes = 4096;\n                    o.ExportProcessorType = ExportProcessorType.Batch;\n                    o.BatchExportProcessorOptions = new BatchExportProcessorOptions\u003cActivity\u003e\n                    {\n                        MaxQueueSize = 2048,\n                        ScheduledDelayMilliseconds = 5000,\n                        ExporterTimeoutMilliseconds = 30000,\n                        MaxExportBatchSize = 512,\n                    };\n                });\n        });\n\n        services.AddScoped\u003cIRegistrationValidationService, RegistrationValidationService\u003e();\n        services.AddMassTransit(x =\u003e\n        {\n            x.AddEntityFrameworkOutbox\u003cRegistrationDbContext\u003e(o =\u003e\n            {\n                o.UsePostgres();\n\n                o.DuplicateDetectionWindow = TimeSpan.FromSeconds(30);\n            });\n\n            x.SetKebabCaseEndpointNameFormatter();\n\n            x.AddConsumer\u003cNotifyRegistrationConsumer\u003e();\n            x.AddConsumer\u003cSendRegistrationEmailConsumer\u003e();\n            x.AddConsumer\u003cAddEventAttendeeConsumer\u003e();\n            x.AddConsumer\u003cValidateRegistrationConsumer, ValidateRegistrationConsumerDefinition\u003e();\n            x.AddSagaStateMachine\u003cRegistrationStateMachine, RegistrationState, RegistrationStateDefinition\u003e()\n                .EntityFrameworkRepository(r =\u003e\n                {\n                    r.ExistingDbContext\u003cRegistrationDbContext\u003e();\n                    r.UsePostgres();\n                });\n\n            x.UsingRabbitMq((context, cfg) =\u003e\n            {\n                cfg.ConfigureEndpoints(context);\n            });\n        });\n\n--- src/Sample.Components/Consumers/NotifyRegistrationConsumer.cs:1-4 (score 0.0156) ---\nnamespace Sample.Components.Consumers;\n\nusing Contracts;\nusing MassTransit;\n\n--- src/Sample.Components/Consumers/NotifyRegistrationConsumer.cs:8-25 (score 0.0156) ---\npublic class NotifyRegistrationConsumer :\n    IConsumer\u003cRegistrationSubmitted\u003e\n{\n    readonly ILogger\u003cNotifyRegistrationConsumer\u003e _logger;\n\n    public NotifyRegistrationConsumer(ILogger\u003cNotifyRegistrationConsumer\u003e logger)\n    {\n        _logger = logger;\n    }\n\n    public Task Consume(ConsumeContext\u003cRegistrationSubmitted\u003e context)\n    {\n        _logger.LogInformation(\"Member {MemberId} registered for event {EventId} on {RegistrationDate}\", context.Message.MemberId, context.Message.EventId,\n            context.Message.RegistrationDate);\n\n        return Task.CompletedTask;\n    }\n}\n\n--- src/Sample.Components/Services/IRegistrationValidationService.cs:3-6 (score 0.0154) ---\npublic interface IRegistrationValidationService\n{\n    Task ValidateRegistration(string eventId, string memberId, Guid registrationId);\n}\n\n--- src/Sample.Worker/Program.cs:6-12 (score 0.0159) ---\nusing OpenTelemetry.Resources;\nusing OpenTelemetry.Trace;\nusing Sample.Components;\nusing Sample.Components.Consumers;\nusing Sample.Components.Services;\nusing Sample.Components.StateMachines;\nusing Serilog;\n"}],"structuredContent":{"summary":{"scope":{"repo":"Sample-Outbox"},"blocks":8,"token_estimate":1211,"truncated":false,"clipped":false},"blocks":[{"blob":19,"blob_sha":"143941df6aeb8ccde274c49681290f3a74f5ddfa","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Consumers/ValidateRegistrationConsumer.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Components/Consumers/ValidateRegistrationConsumer.cs","start_line":1,"end_line":4,"score":0.04918032786885246,"lexical":19.176658731117087,"dense":0,"text":"namespace Sample.Components.Consumers;\n\nusing Contracts;\nusing MassTransit;\n","clipped":false},{"blob":19,"blob_sha":"143941df6aeb8ccde274c49681290f3a74f5ddfa","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Consumers/ValidateRegistrationConsumer.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Components/Consumers/ValidateRegistrationConsumer.cs","start_line":9,"end_line":25,"score":0.04918032786885246,"lexical":19.176658731117087,"dense":0,"text":"public class ValidateRegistrationConsumer :\n    IConsumer\u003cAddEventAttendee\u003e\n{\n    readonly ILogger\u003cValidateRegistrationConsumer\u003e _logger;\n    readonly IRegistrationValidationService _validationService;\n\n    public ValidateRegistrationConsumer(ILogger\u003cValidateRegistrationConsumer\u003e logger, IRegistrationValidationService v