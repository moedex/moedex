{"jsonrpc":"2.0","id":3,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"c08c410b6f87d0fb57705d2e42bc232af92a29cc4c27aaf8a3a1a8b926b94434","blob_shas":["0d663b6374eea699b6ebe16271d96f6c9d1b963d","16d40af749971f67edae3e8ba485b24f5bbaa5e2","47da061667feacc754e973305717e82098e67136","8b48b2f063e02e4eae61bac29ed1fef7c7424b63","c93fe4e3aa5df3627a3c62f3569935bc1a070b3c"]}},"content":[{"type":"text","text":"7 context block(s), ~869 tokens\n\n--- src/Sample.Components/IRegistrationService.cs:1-6 (score 0.0487) ---\nnamespace Sample.Components;\n\npublic interface IRegistrationService\n{\n    Task\u003cRegistration\u003e SubmitRegistration(string eventId, string memberId, decimal payment);\n}\n\n--- src/Sample.Components/RegistrationService.cs:1-4 (score 0.0484) ---\nnamespace Sample.Components;\n\nusing Contracts;\nusing MassTransit;\n\n--- src/Sample.Components/RegistrationService.cs:9-54 (score 0.0484) ---\npublic class RegistrationService :\n    IRegistrationService\n{\n    readonly RegistrationDbContext _dbContext;\n    readonly IPublishEndpoint _publishEndpoint;\n\n    public RegistrationService(RegistrationDbContext dbContext, IPublishEndpoint publishEndpoint)\n    {\n        _dbContext = dbContext;\n        _publishEndpoint = publishEndpoint;\n    }\n\n    public async Task\u003cRegistration\u003e SubmitRegistration(string eventId, string memberId, decimal payment)\n    {\n        var registration = new Registration\n        {\n            RegistrationId = NewId.NextGuid(),\n            RegistrationDate = DateTime.UtcNow,\n            MemberId = memberId,\n            EventId = eventId,\n            Payment = payment\n        };\n\n        await _dbContext.Set\u003cRegistration\u003e().AddAsync(registration);\n\n        await _publishEndpoint.Publish(new RegistrationSubmitted\n        {\n            RegistrationId = registration.RegistrationId,\n            RegistrationDate = registration.RegistrationDate,\n            MemberId = registration.MemberId,\n            EventId = registration.EventId,\n            Payment = payment\n        });\n\n        try\n        {\n            await _dbContext.SaveChangesAsync();\n        }\n        catch (DbUpdateException exception) when (exception.InnerException is PostgresException { SqlState: PostgresErrorCodes.UniqueViolation })\n        {\n            throw new DuplicateRegistrationException(\"Duplicate registration\", exception);\n        }\n\n        return registration;\n    }\n}\n\n--- src/Sample.Components/Services/RegistrationValidationService.cs:1-4 (score 0.0308) ---\nnamespace Sample.Components.Services;\n\nusing Consumers;\nusing MassTransit;\n\n--- src/Sample.Components/Services/RegistrationValidationService.cs:7-21 (score 0.0308) ---\npublic class RegistrationValidationService :\n    IRegistrationValidationService\n{\n    readonly IPublishEndpoint _publishEndpoint;\n\n    public RegistrationValidationService(IPublishEndpoint publishEndpoint)\n    {\n        _publishEndpoint = publishEndpoint;\n    }\n\n    public async Task ValidateRegistration(string eventId, string memberId, Guid registrationId)\n    {\n        await _publishEndpoint.Publish(new RegistrationValidated { RegistrationId = registrationId });\n    }\n}\n\n--- src/Sample.Components/Services/IRegistrationValidationService.cs:1-6 (score 0.0306) ---\nnamespace Sample.Components.Services;\n\npublic interface IRegistrationValidationService\n{\n    Task ValidateRegistration(string eventId, string memberId, Guid registrationId);\n}\n\n--- src/Sample.Api/Controllers/RegistrationController.cs:9-46 (score 0.0164) ---\npublic class RegistrationController :\n    ControllerBase\n{\n    readonly IRegistrationService _registrationService;\n\n    public RegistrationController(IRegistrationService registrationService)\n    {\n        _registrationService = registrationService;\n    }\n\n    [HttpPost]\n    public async Task\u003cIActionResult\u003e Submit([FromBody] RegistrationModel model)\n    {\n        if (!ModelState.IsValid)\n            return BadRequest(ModelState);\n\n        try\n        {\n            var registration = await _registrationService.SubmitRegistration(model.EventId, model.MemberId, model.Payment);\n\n            return Ok(new\n            {\n                registration.RegistrationId,\n                registration.RegistrationDate,\n                registration.MemberId,\n                registration.EventId,\n            });\n        }\n        catch (DuplicateRegistrationException)\n        {\n            return Conflict(new\n            {\n                model.MemberId,\n                model.EventId,\n            });\n        }\n    }\n}\n"}],"structuredContent":{"summary":{"scope":{"repo":"Sample-Outbox"},"blocks":7,"token_estimate":869,"truncated":false,"clipped":false},"blocks":[{"blob":25,"blob_sha":"0d663b6374eea699b6ebe16271d96f6c9d1b963d","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/IRegistrationService.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Components/IRegistrationService.cs","start_line":1,"end_line":6,"score":0.048651507139079855,"lexical":5.894635445588773,"dense":0,"text":"namespace Sample.Components;\n\npublic interface IRegistrationService\n{\n    Task\u003cRegistration\u003e SubmitRegistration(string eventId, string memberId, decimal payment);\n}\n","clipped":false},{"blob":28,"blob_sha":"16d40af749971f67edae3e8ba485b24f5bbaa5e2","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/RegistrationService.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Components/RegistrationService.cs","start_line":1,"end_line":4,"score":0.04839549075403121,"lexical":5.533118081940324,"dense":0,"text":"namespace Sample.Components;\n\nusing Contracts;\nu