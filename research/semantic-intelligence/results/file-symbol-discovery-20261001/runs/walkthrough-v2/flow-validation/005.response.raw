{"jsonrpc":"2.0","id":5,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"c08c410b6f87d0fb57705d2e42bc232af92a29cc4c27aaf8a3a1a8b926b94434","blob_shas":["143941df6aeb8ccde274c49681290f3a74f5ddfa","47da061667feacc754e973305717e82098e67136","747277d2ae2a7eba0f6a3062b35f920f46c0fac2","8b48b2f063e02e4eae61bac29ed1fef7c7424b63","c93fe4e3aa5df3627a3c62f3569935bc1a070b3c"]}},"content":[{"type":"text","text":"7 context block(s), ~1312 tokens\n\n--- src/Sample.Components/Services/RegistrationValidationService.cs:1-4 (score 0.0489) ---\nnamespace Sample.Components.Services;\n\nusing Consumers;\nusing MassTransit;\n\n--- src/Sample.Components/Services/RegistrationValidationService.cs:7-21 (score 0.0489) ---\npublic class RegistrationValidationService :\n    IRegistrationValidationService\n{\n    readonly IPublishEndpoint _publishEndpoint;\n\n    public RegistrationValidationService(IPublishEndpoint publishEndpoint)\n    {\n        _publishEndpoint = publishEndpoint;\n    }\n\n    public async Task ValidateRegistration(string eventId, string memberId, Guid registrationId)\n    {\n        await _publishEndpoint.Publish(new RegistrationValidated { RegistrationId = registrationId });\n    }\n}\n\n--- src/Sample.Components/Services/IRegistrationValidationService.cs:1-6 (score 0.0484) ---\nnamespace Sample.Components.Services;\n\npublic interface IRegistrationValidationService\n{\n    Task ValidateRegistration(string eventId, string memberId, Guid registrationId);\n}\n\n--- src/Sample.Components/Consumers/ValidateRegistrationConsumer.cs:3-25 (score 0.0161) ---\nusing Contracts;\nusing MassTransit;\nusing Microsoft.Extensions.Logging;\nusing Services;\n\n\npublic class ValidateRegistrationConsumer :\n    IConsumer\u003cAddEventAttendee\u003e\n{\n    readonly ILogger\u003cValidateRegistrationConsumer\u003e _logger;\n    readonly IRegistrationValidationService _validationService;\n\n    public ValidateRegistrationConsumer(ILogger\u003cValidateRegistrationConsumer\u003e logger, IRegistrationValidationService validationService)\n    {\n        _logger = logger;\n        _validationService = validationService;\n    }\n\n    public async Task Consume(ConsumeContext\u003cAddEventAttendee\u003e context)\n    {\n        await _validationService.ValidateRegistration(context.Message.EventId, context.Message.MemberId, context.Message.RegistrationId);\n    }\n}\n\n--- src/Sample.Worker/Program.cs:24-92 (score 0.0156) ---\n\n\nvar host = Host.CreateDefaultBuilder(args)\n    .ConfigureServices((hostContext, services) =\u003e\n    {\n        services.AddDbContext\u003cRegistrationDbContext\u003e(x =\u003e\n        {\n            var connectionString = hostContext.Configuration.GetConnectionString(\"Default\");\n\n            x.UseNpgsql(connectionString, options =\u003e\n            {\n                options.MinBatchSize(1);\n            });\n        });\n\n        services.AddOpenTelemetry().WithTracing(x =\u003e\n        {\n            x.SetResourceBuilder(ResourceBuilder.CreateDefault()\n                    .AddService(\"service\")\n                    .AddTelemetrySdk()\n                    .AddEnvironmentVariableDetector())\n                .AddSource(\"MassTransit\")\n                .AddJaegerExporter(o =\u003e\n                {\n                    o.AgentHost = HostMetadataCache.IsRunningInContainer ? \"jaeger\" : \"localhost\";\n                    o.AgentPort = 6831;\n                    o.MaxPayloadSizeInBytes = 4096;\n                    o.ExportProcessorType = ExportProcessorType.Batch;\n                    o.BatchExportProcessorOptions = new BatchExportProcessorOptions\u003cActivity\u003e\n                    {\n                        MaxQueueSize = 2048,\n                        ScheduledDelayMilliseconds = 5000,\n                        ExporterTimeoutMilliseconds = 30000,\n                        MaxExportBatchSize = 512,\n                    };\n                });\n        });\n\n        services.AddScoped\u003cIRegistrationValidationService, RegistrationValidationService\u003e();\n        services.AddMassTransit(x =\u003e\n        {\n            x.AddEntityFrameworkOutbox\u003cRegistrationDbContext\u003e(o =\u003e\n            {\n                o.UsePostgres();\n\n                o.DuplicateDetectionWindow = TimeSpan.FromSeconds(30);\n            });\n\n            x.SetKebabCaseEndpointNameFormatter();\n\n            x.AddConsumer\u003cNotifyRegistrationConsumer\u003e();\n            x.AddConsumer\u003cSendRegistrationEmailConsumer\u003e();\n            x.AddConsumer\u003cAddEventAttendeeConsumer\u003e();\n            x.AddConsumer\u003cValidateRegistrationConsumer, ValidateRegistrationConsumerDefinition\u003e();\n            x.AddSagaStateMachine\u003cRegistrationStateMachine, RegistrationState, RegistrationStateDefinition\u003e()\n                .EntityFrameworkRepository(r =\u003e\n                {\n                    r.ExistingDbContext\u003cRegistrationDbContext\u003e();\n                    r.UsePostgres();\n                });\n\n            x.UsingRabbitMq((context, cfg) =\u003e\n            {\n                cfg.ConfigureEndpoints(context);\n            });\n        });\n    })\n    .UseSerilog()\n    .Build();\n\n--- src/Sample.Api/Controllers/RegistrationController.cs:9-46 (score 0.0154) ---\npublic class RegistrationController :\n    ControllerBase\n{\n    readonly IRegistrationService _registrationService;\n\n    public RegistrationController(IRegistrationService registrationService)\n    {\n        _registrationService = registrationService;\n    }\n\n    [HttpPost]\n    public async Task\u003cIActionResult\u003e Submit([FromBody] RegistrationModel model)\n    {\n        if (!ModelState.IsValid)\n            return BadRequest(ModelState);\n\n        try\n        {\n            var registration = await _registrationService.SubmitRegistration(model.EventId, model.MemberId, model.Payment);\n\n            return Ok(new\n            {\n                registration.RegistrationId,\n                registration.RegistrationDate,\n                registration.MemberId,\n                registration.EventId,\n            });\n        }\n        catch (DuplicateRegistrationException)\n        {\n            return Conflict(new\n            {\n                model.MemberId,\n                model.EventId,\n            });\n        }\n    }\n}\n\n--- src/Sample.Worker/Program.cs:7-13 (score 0.0156) ---\nusing OpenTelemetry.Trace;\nusing Sample.Components;\nusing Sample.Components.Consumers;\nusing Sample.Components.Services;\nusing Sample.Components.StateMachines;\nusing Serilog;\nusing Serilog.Events;\n"}],"structuredContent":{"summary":{"scope":{"repo":"Sample-Outbox"},"blocks":7,"token_estimate":1312,"truncated":false,"clipped":false},"blocks":[{"blob":31,"blob_sha":"47da061667feacc754e973305717e82098e67136","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Services/RegistrationValidationService.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Components/Services/RegistrationValidationService.cs","start_line":1,"end_line":4,"score":0.04891591750396616,"lexical":17.835815210612235,"dense":0,"text":"namespace Sample.Components.Services;\n\nusing Consumers;\nusing MassTransit;\n","clipped":false},{"blob":31,"blob_sha":"47da061667feacc754e973305717e82098e67136","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Services/RegistrationValidationService.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Components/Services/RegistrationValidationService.cs","start_line":7,"end_line":21,"score":0.04891591750396616,"lexical":17.835815210612235,"dense":0,"text":"public class RegistrationValidationService :\n    IRegistrationValidationService\n{\n    readonly IPubl