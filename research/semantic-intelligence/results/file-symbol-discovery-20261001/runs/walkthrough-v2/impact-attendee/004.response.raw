{"jsonrpc":"2.0","id":4,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"c08c410b6f87d0fb57705d2e42bc232af92a29cc4c27aaf8a3a1a8b926b94434","blob_shas":["66615dda8394e057f9e65c6968635cd831caf7bb"]}},"content":[{"type":"text","text":"namespace Sample.Components.Consumers;\n\nusing Contracts;\nusing MassTransit;\nusing Microsoft.Extensions.Logging;\n\n\npublic class AddEventAttendeeConsumer :\n    IConsumer\u003cAddEventAttendee\u003e\n{\n    readonly ILogger\u003cAddEventAttendeeConsumer\u003e _logger;\n\n    public AddEventAttendeeConsumer(ILogger\u003cAddEventAttendeeConsumer\u003e logger)\n    {\n        _logger = logger;\n    }\n\n    public Task Consume(ConsumeContext\u003cAddEventAttendee\u003e context)\n    {\n        _logger.LogInformation(\"Adding Member {MemberId} as an attendee for event {EventId}\", context.Message.MemberId, context.Message.EventId);\n\n        return Task.CompletedTask;\n    }\n}"}],"structuredContent":{"repo":"Sample-Outbox","path":"src/Sample.Components/Consumers/AddEventAttendeeConsumer.cs","blob_sha":"66615dda8394e057f9e65c6968635cd831caf7bb","lines":24,"start_line":1,"end_line":24,"truncated":false,"content":"namespace Sample.Components.Consumers;\n\nusing Contracts;\nusing MassTransit;\nusing Microsoft.Extensions.Logging;\n\n\npublic class AddEventAttendeeConsumer :\n    IConsumer\u003cAddEventAttendee\u003e\n{\n    readonly ILogger\u003cAddEventAttendeeConsumer\u003e _logger;\n\n    public AddEventAttendeeConsumer(ILogger\u003cAddEventAttendeeConsumer\u003e logger)\n    {\n        _logger = logger;\n    }\n\n    public Task Consume(ConsumeContext\u003cAddEventAttendee\u003e context)\n    {\n        _logger.LogInformation(\"Adding Member {MemberId} as an attendee for event {EventId}\", context.Message.MemberId, context.Message.EventId);\n\n        return Task.CompletedTask;\n    }\n}"}}}