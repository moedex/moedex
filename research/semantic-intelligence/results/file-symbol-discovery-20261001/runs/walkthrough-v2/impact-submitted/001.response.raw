{"jsonrpc":"2.0","id":1,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"c08c410b6f87d0fb57705d2e42bc232af92a29cc4c27aaf8a3a1a8b926b94434","blob_shas":["16d40af749971f67edae3e8ba485b24f5bbaa5e2","347216cd4e227674dc5cfac032b4bfc2e8fa36ec","8b48b2f063e02e4eae61bac29ed1fef7c7424b63","c4c0d599e4a84ce476c9263aea320abbc8f98b72","c921fa19ce379bd6ae59f5b334d022e6b8e0a4fa"]}},"content":[{"type":"text","text":"5 context block(s), ~1300 tokens\n\n--- src/Sample.Components/Contracts/RegistrationSubmitted.cs:1-10 (score 0.0487) ---\nnamespace Sample.Components.Contracts;\n\npublic record RegistrationSubmitted\n{\n    public Guid RegistrationId { get; init; }\n    public DateTime RegistrationDate { get; init; }\n    public string MemberId { get; init; } = null!;\n    public string EventId { get; init; } = null!;\n    public decimal Payment { get; init; }\n}\n\n--- src/Sample.Components/StateMachines/RegistrationStateMachine.cs:7-48 (score 0.0164) ---\npublic class RegistrationStateMachine :\n    MassTransitStateMachine\u003cRegistrationState\u003e\n{\n    public RegistrationStateMachine()\n    {\n        InstanceState(x =\u003e x.CurrentState);\n\n        Event(() =\u003e RegistrationSubmitted, x =\u003e x.CorrelateById(m =\u003e m.Message.RegistrationId));\n\n        Initially(\n            When(RegistrationSubmitted)\n                .Then(context =\u003e\n                {\n                    context.Saga.RegistrationDate = context.Message.RegistrationDate;\n                    context.Saga.EventId = context.Message.EventId;\n                    context.Saga.MemberId = context.Message.MemberId;\n                    context.Saga.Payment = context.Message.Payment;\n                })\n                .TransitionTo(Registered)\n                .Publish(context =\u003e new SendRegistrationEmail\n                {\n                    RegistrationId = context.Saga.CorrelationId,\n                    RegistrationDate = context.Saga.RegistrationDate,\n                    EventId = context.Saga.EventId,\n                    MemberId = context.Saga.MemberId\n                })\n                .If(context =\u003e context.Saga.Payment \u003c 50m \u0026\u0026 context.GetRetryAttempt() == 0,\n                    fail =\u003e fail.Then(_ =\u003e throw new ApplicationException(\"Totally random, but you didn't pay enough for quality service\")))\n                .Publish(context =\u003e new AddEventAttendee\n                {\n                    RegistrationId = context.Saga.CorrelationId,\n                    EventId = context.Saga.EventId,\n                    MemberId = context.Saga.MemberId\n                })\n        );\n    }\n\n    //\n    // ReSharper disable MemberCanBePrivate.Global\n    public State Registered { get; } = null!;\n    public Event\u003cRegistrationSubmitted\u003e RegistrationSubmitted { get; } = null!;\n}\n\n--- src/Sample.Components/Consumers/NotifyRegistrationConsumer.cs:8-25 (score 0.0161) ---\npublic class NotifyRegistrationConsumer :\n    IConsumer\u003cRegistrationSubmitted\u003e\n{\n    readonly ILogger\u003cNotifyRegistrationConsumer\u003e _logger;\n\n    public NotifyRegistrationConsumer(ILogger\u003cNotifyRegistrationConsumer\u003e logger)\n    {\n        _logger = logger;\n    }\n\n    public Task Consume(ConsumeContext\u003cRegistrationSubmitted\u003e context)\n    {\n        _logger.LogInformation(\"Member {MemberId} registered for event {EventId} on {RegistrationDate}\", context.Message.MemberId, context.Message.EventId,\n            context.Message.RegistrationDate);\n\n        return Task.CompletedTask;\n    }\n}\n\n--- src/Sample.Components/RegistrationService.cs:9-54 (score 0.0156) ---\npublic class RegistrationService :\n    IRegistrationService\n{\n    readonly RegistrationDbContext _dbContext;\n    readonly IPublishEndpoint _publishEndpoint;\n\n    public RegistrationService(RegistrationDbContext dbContext, IPublishEndpoint publishEndpoint)\n    {\n        _dbContext = dbContext;\n        _publishEndpoint = publishEndpoint;\n    }\n\n    public async Task\u003cRegistration\u003e SubmitRegistration(string eventId, string memberId, decimal payment)\n    {\n        var registration = new Registration\n        {\n            RegistrationId = NewId.NextGuid(),\n            RegistrationDate = DateTime.UtcNow,\n            MemberId = memberId,\n            EventId = eventId,\n            Payment = payment\n        };\n\n        await _dbContext.Set\u003cRegistration\u003e().AddAsync(registration);\n\n        await _publishEndpoint.Publish(new RegistrationSubmitted\n        {\n            RegistrationId = registration.RegistrationId,\n            RegistrationDate = registration.RegistrationDate,\n            MemberId = registration.MemberId,\n            EventId = registration.EventId,\n            Payment = payment\n        });\n\n        try\n        {\n            await _dbContext.SaveChangesAsync();\n        }\n        catch (DbUpdateException exception) when (exception.InnerException is PostgresException { SqlState: PostgresErrorCodes.UniqueViolation })\n        {\n            throw new DuplicateRegistrationException(\"Duplicate registration\", exception);\n        }\n\n        return registration;\n    }\n}\n\n--- src/Sample.Api/Controllers/RegistrationController.cs:9-46 (score 0.0154) ---\npublic class RegistrationController :\n    ControllerBase\n{\n    readonly IRegistrationService _registrationService;\n\n    public RegistrationController(IRegistrationService registrationService)\n    {\n        _registrationService = registrationService;\n    }\n\n    [HttpPost]\n    public async Task\u003cIActionResult\u003e Submit([FromBody] RegistrationModel model)\n    {\n        if (!ModelState.IsValid)\n            return BadRequest(ModelState);\n\n        try\n        {\n            var registration = await _registrationService.SubmitRegistration(model.EventId, model.MemberId, model.Payment);\n\n            return Ok(new\n            {\n                registration.RegistrationId,\n                registration.RegistrationDate,\n                registration.MemberId,\n                registration.EventId,\n            });\n        }\n        catch (DuplicateRegistrationException)\n        {\n            return Conflict(new\n            {\n                model.MemberId,\n                model.EventId,\n            });\n        }\n    }\n}\n"}],"structuredContent":{"summary":{"scope":{"repo":"Sample-Outbox"},"blocks":5,"token_estimate":1300,"truncated":false,"clipped":false},"blocks":[{"blob":22,"blob_sha":"347216cd4e227674dc5cfac032b4bfc2e8fa36ec","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Contracts/RegistrationSubmitted.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Components/Contracts/RegistrationSubmitted.cs","start_line":1,"end_line":10,"score":0.04865990111891752,"lexical":6.987109043179598,"dense":0,"text":"namespace Sample.Components.Contracts;\n\npublic record RegistrationSubmitted\n{\n    public Guid RegistrationId { get; init; }\n    public DateTime RegistrationDate { get; init; }\n    public string MemberId { get; init; } = null!;\n    public string EventId { get; init; } = null!;\n    public decimal Payment { get; init; }\n}\n","clipped":false},{"blob":34,"blob_sha":"c4c0d599e4a84ce476c9263aea320abbc8f98b72","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/StateMachines/RegistrationStateMachine.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/application-impact/run-wrapper-v1/corpus/Sample-Outbox/src/Sample.Components/StateMachines/RegistrationStateMachine.cs","start_line":7,"end_line":48,"score":0.01639344262295082,"lexical":7.546040004115897,"dense":0,"text":"public class RegistrationStateMachine :\n    MassTransitStateMachine\u003cRegistrationState\u003e\n{\n    public RegistrationStateMachine()\n    {\n        InstanceState(x =\u003e x.CurrentState);\n\n        Event(() =\u003e RegistrationSubmitted, x =\u003e x.CorrelateById(m =\u003e m.Message.RegistrationId));\n\n        Initially(\n            When(RegistrationSubmitted)\n                .Then(context =\u003e\n                {\n                    context.Saga.RegistrationDate = context.Message.RegistrationDate;\n                    context.Saga.EventId = context.Message.EventId;\n                    context.Saga.MemberId = context.Message.MemberId;\n                    context.Saga.Payment = context.Message.Payment;\n                })\n                .TransitionTo(Registered)\n                .Publish(context =\u003e new SendRegistrationEmail\n                {\n                    RegistrationId = context.Saga.CorrelationId,\n                    RegistrationDate = context.Saga.RegistrationDate,\n                    EventId = context.Saga.EventId,\n                    MemberId = context.Saga.MemberId\n                })\n                .If(context =\u003e context.Saga.Payment \u003c 50m \u0026\u0026 context.GetRetryAttempt() == 0,\n                    fail =\u003e fail.Then(_ =\u003e throw new ApplicationException(\"Totally random, but you didn't pay enough for quality service\")))\n                .Publish(context =\u003e new AddEventAttendee\n                {\n                    RegistrationId = context.Saga.CorrelationId,\n                    EventId = context.Saga.EventId,\n                    MemberId = context.Saga.MemberId\n                })\n        );\n    }\n\n    //\n    // ReSharper disable MemberCanBePrivate.Global\n    public State Registered { get; } = null!;\n    public Event\u003cRegistrationSubmitted\u003e RegistrationSubmitted { get; } = null!;\n}\n","clipped":false},{"blob":16,"blob_sha":"c921fa19ce379bd6ae59f5b334d022e6b8e0a4fa","repo":"Sample-Outbox","path_with_namespace":"Sample-Outbox","rel_path":"src/Sample.Components/Consumers/NotifyRegistration