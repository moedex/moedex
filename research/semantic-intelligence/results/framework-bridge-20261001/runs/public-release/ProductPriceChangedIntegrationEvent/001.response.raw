{"jsonrpc":"2.0","id":1,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"750617e80283ae1535ae4dd90239d2fa5ce9c1d0d673b202bf0ca079c7467300","blob_shas":["021ad20ee232a6ec6a5982bafc2650481bd54eb8","a09b1d20bc4db7b2843a1c35e07ea0c4e26f9ca2","bb164c0d1cc029beb66dee3cde7998edbddd5904","be15b0bb01265637ed542535d33caafa871c9334","ea73d5ca4315927390e2022c316be46a1bbbf194"]}},"content":[{"type":"text","text":"5 context block(s), ~935 tokens\n\n--- src/Webhooks.API/IntegrationEvents/ProductPriceChangedIntegrationEventHandler.cs:1-9 (score 0.0492) ---\nnamespace Webhooks.API.IntegrationEvents;\n\npublic class ProductPriceChangedIntegrationEventHandler : IIntegrationEventHandler\u003cProductPriceChangedIntegrationEvent\u003e\n{\n    public Task Handle(ProductPriceChangedIntegrationEvent @event)\n    {\n        return Task.CompletedTask;\n    }\n}\n\n--- src/Catalog.API/IntegrationEvents/Events/ProductPriceChangedIntegrationEvent.cs:1-6 (score 0.0479) ---\nnamespace eShop.Catalog.API.IntegrationEvents.Events;\n\n// Integration Events notes: \n// An Event is “something that has happened in the past”, therefore its name has to be past tense\n// An Integration Event is an event that can cause side effects to other microservices, Bounded-Contexts or external systems.\npublic record ProductPriceChangedIntegrationEvent(int ProductId, decimal NewPrice, decimal OldPrice) : IntegrationEvent;\n\n--- src/Webhooks.API/IntegrationEvents/ProductPriceChangedIntegrationEvent.cs:1-3 (score 0.0476) ---\nnamespace Webhooks.API.IntegrationEvents;\n\npublic record ProductPriceChangedIntegrationEvent(int ProductId, decimal NewPrice, decimal OldPrice) : IntegrationEvent;\n\n--- src/Webhooks.API/Extensions/Extensions.cs:3-24 (score 0.0161) ---\n    public static void AddApplicationServices(this IHostApplicationBuilder builder)\n    {\n        builder.AddDefaultAuthentication();\n\n        builder.AddRabbitMqEventBus(\"eventbus\")\n               .AddEventBusSubscriptions();\n\n        builder.AddNpgsqlDbContext\u003cWebhooksContext\u003e(\"webhooksdb\");\n\n        builder.Services.AddMigration\u003cWebhooksContext\u003e();\n\n        builder.Services.AddTransient\u003cIGrantUrlTesterService, GrantUrlTesterService\u003e();\n        builder.Services.AddTransient\u003cIWebhooksRetriever, WebhooksRetriever\u003e();\n        builder.Services.AddTransient\u003cIWebhooksSender, WebhooksSender\u003e();\n    }\n\n    private static void AddEventBusSubscriptions(this IEventBusBuilder eventBus)\n    {\n        eventBus.AddSubscription\u003cProductPriceChangedIntegrationEvent, ProductPriceChangedIntegrationEventHandler\u003e();\n        eventBus.AddSubscription\u003cOrderStatusChangedToShippedIntegrationEvent, OrderStatusChangedToShippedIntegrationEventHandler\u003e();\n        eventBus.AddSubscription\u003cOrderStatusChangedToPaidIntegrationEvent, OrderStatusChangedToPaidIntegrationEventHandler\u003e();\n    }\n\n--- src/Catalog.API/Apis/CatalogApi.cs:221-256 (score 0.0154) ---\n    public static async Task\u003cResults\u003cCreated, NotFound\u003cstring\u003e\u003e\u003e UpdateItem(\n        [AsParameters] CatalogServices services,\n        CatalogItem productToUpdate)\n    {\n        var catalogItem = await services.Context.CatalogItems.SingleOrDefaultAsync(i =\u003e i.Id == productToUpdate.Id);\n\n        if (catalogItem == null)\n        {\n            return TypedResults.NotFound($\"Item with id {productToUpdate.Id} not found.\");\n        }\n\n        // Update current product\n        var catalogEntry = services.Context.Entry(catalogItem);\n        catalogEntry.CurrentValues.SetValues(productToUpdate);\n\n        catalogItem.Embedding = await services.CatalogAI.GetEmbeddingAsync(catalogItem);\n\n        var priceEntry = catalogEntry.Property(i =\u003e i.Price);\n\n        if (priceEntry.IsModified) // Save product's data and publish integration event through the Event Bus if price has changed\n        {\n            //Create Integration Event to be published through the Event Bus\n            var priceChangedEvent = new ProductPriceChangedIntegrationEvent(catalogItem.Id, productToUpdate.Price, priceEntry.OriginalValue);\n\n            // Achieving atomicity between original Catalog database operation and the IntegrationEventLog thanks to a local transaction\n            await services.EventService.SaveEventAndCatalogContextChangesAsync(priceChangedEvent);\n\n            // Publish through the Event Bus and mark the saved event as published\n            await services.EventService.PublishThroughEventBusAsync(priceChangedEvent);\n        }\n        else // Just save the updated product because the Product's Price hasn't changed.\n        {\n            await services.Context.SaveChangesAsync();\n        }\n        return TypedResults.Created($\"/api/catalog/items/{productToUpdate.Id}\");\n    }\n"}],"structuredContent":{"summary":{"scope":{"repo":"eShop"},"blocks":5,"token_estimate":935,"truncated":false,"clipped":false},"blocks":[{"blob":729,"blob_sha":"bb164c0d1cc029beb66dee3cde7998edbddd5904","repo":"eShop","path_with_namespace":"eShop","rel_path":"src/Webhooks.API/IntegrationEvents/ProductPriceChangedIntegrationEventHandler.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/framework-bridge/eshop-release/corpus/eShop/src/Webhooks.API/IntegrationEvents/ProductPriceChangedIntegrationEventHandler.cs","start_line":1,"end_line":9,"score":0.04918032786885246,"lexical":136.808643973147,"dense":0,"text":"namespace Webhooks.API.IntegrationEvents;\n\npublic class ProductPriceChangedIntegrationEventHandler : IIntegrationEventHandler\u003cProductPriceChangedIntegrationEvent\u003e\n{\n    public Task Handle(ProductPriceChangedIntegrationEvent @event)\n    {\n        return Task.CompletedTask;\n    }\n}\n","clipped":false},{"blob":79,"blob_sha":"a09b1d20bc4db7b2843a1c35e07ea0c4e26f9ca2","repo":"eShop","path_with_namespace":"eShop","rel_path":"src/Catalog.API/Int