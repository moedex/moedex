{"jsonrpc":"2.0","id":1,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"f511a5507789afaab5d335b461107168cc095d8812e660fbdfa51f680bfe4964","blob_shas":["1d6c5388aa9cdd9f8deb2791ee179501ac9cd15b","76367c3aff3b1a5d948f7e8008df6f0168eef809","a503b4e4d5de5c2b2c99f6bbaddcbc5836d6c226","a9aec956f9d40894d1f5ebee7732152825c0075d","f83891b1398b74f31f0e5f055d71297a8e94dd19"]}},"content":[{"type":"text","text":"5 context block(s), ~996 tokens\n\n--- src/EventBus/Abstractions/IIntegrationEventHandler.cs:1-14 (score 0.0492) ---\nnamespace eShop.EventBus.Abstractions;\n\npublic interface IIntegrationEventHandler\u003cin TIntegrationEvent\u003e : IIntegrationEventHandler\n    where TIntegrationEvent : IntegrationEvent\n{\n    Task Handle(TIntegrationEvent @event);\n\n    Task IIntegrationEventHandler.Handle(IntegrationEvent @event) =\u003e Handle((TIntegrationEvent)@event);\n}\n\npublic interface IIntegrationEventHandler\n{\n    Task Handle(IntegrationEvent @event);\n}\n\n--- src/Basket.API/IntegrationEvents/EventHandling/OrderStartedIntegrationEventHandler.cs:1-16 (score 0.0320) ---\nusing eShop.Basket.API.Repositories;\nusing eShop.Basket.API.IntegrationEvents.EventHandling.Events;\n\nnamespace eShop.Basket.API.IntegrationEvents.EventHandling;\n\npublic class OrderStartedIntegrationEventHandler(\n    IBasketRepository repository,\n    ILogger\u003cOrderStartedIntegrationEventHandler\u003e logger) : IIntegrationEventHandler\u003cOrderStartedIntegrationEvent\u003e\n{\n    public async Task Handle(OrderStartedIntegrationEvent @event)\n    {\n        logger.LogInformation(\"Handling integration event: {IntegrationEventId} - ({@IntegrationEvent})\", @event.Id, @event);\n\n        await repository.DeleteBasketAsync(@event.UserId);\n    }\n}\n\n--- src/Ordering.API/Application/IntegrationEvents/EventHandling/OrderPaymentFailedIntegrationEventHandler.cs:1-23 (score 0.0301) ---\nnamespace eShop.Ordering.API.Application.IntegrationEvents.EventHandling;\n\npublic class OrderPaymentFailedIntegrationEventHandler(\n    IMediator mediator,\n    ILogger\u003cOrderPaymentFailedIntegrationEventHandler\u003e logger) :\n    IIntegrationEventHandler\u003cOrderPaymentFailedIntegrationEvent\u003e\n{\n    public async Task Handle(OrderPaymentFailedIntegrationEvent @event)\n    {\n        logger.LogInformation(\"Handling integration event: {IntegrationEventId} - ({@IntegrationEvent})\", @event.Id, @event);\n\n        var command = new CancelOrderCommand(@event.OrderId);\n\n        logger.LogInformation(\n            \"Sending command: {CommandName} - {IdProperty}: {CommandId} ({@Command})\",\n            command.GetGenericTypeName(),\n            nameof(command.OrderNumber),\n            command.OrderNumber,\n            command);\n\n        await mediator.Send(command);\n    }\n}\n\n--- src/Ordering.API/Application/IntegrationEvents/EventHandling/OrderPaymentSucceededIntegrationEventHandler.cs:1-23 (score 0.0296) ---\nnamespace eShop.Ordering.API.Application.IntegrationEvents.EventHandling;\n\npublic class OrderPaymentSucceededIntegrationEventHandler(\n    IMediator mediator,\n    ILogger\u003cOrderPaymentSucceededIntegrationEventHandler\u003e logger) :\n    IIntegrationEventHandler\u003cOrderPaymentSucceededIntegrationEvent\u003e\n{\n    public async Task Handle(OrderPaymentSucceededIntegrationEvent @event)\n    {\n        logger.LogInformation(\"Handling integration event: {IntegrationEventId} - ({@IntegrationEvent})\", @event.Id, @event);\n\n        var command = new SetPaidOrderStatusCommand(@event.OrderId);\n\n        logger.LogInformation(\n            \"Sending command: {CommandName} - {IdProperty}: {CommandId} ({@Command})\",\n            command.GetGenericTypeName(),\n            nameof(command.OrderNumber),\n            command.OrderNumber,\n            command);\n\n        await mediator.Send(command);\n    }\n}\n\n--- src/Ordering.API/Application/IntegrationEvents/EventHandling/GracePeriodConfirmedIntegrationEventHandler.cs:1-30 (score 0.0296) ---\nnamespace eShop.Ordering.API.Application.IntegrationEvents.EventHandling;\n\npublic class GracePeriodConfirmedIntegrationEventHandler(\n    IMediator mediator,\n    ILogger\u003cGracePeriodConfirmedIntegrationEventHandler\u003e logger) : IIntegrationEventHandler\u003cGracePeriodConfirmedIntegrationEvent\u003e\n{\n    /// \u003csummary\u003e\n    /// Event handler which confirms that the grace period\n    /// has been completed and order will not initially be cancelled.\n    /// Therefore, the order process continues for validation. \n    /// \u003c/summary\u003e\n    /// \u003cparam name=\"event\"\u003e       \n    /// \u003c/param\u003e\n    /// \u003creturns\u003e\u003c/returns\u003e\n    public async Task Handle(GracePeriodConfirmedIntegrationEvent @event)\n    {\n        logger.LogInformation(\"Handling integration event: {IntegrationEventId} - ({@IntegrationEvent})\", @event.Id, @event);\n\n        var command = new SetAwaitingValidationOrderStatusCommand(@event.OrderId);\n\n        logger.LogInformation(\n            \"Sending command: {CommandName} - {IdProperty}: {CommandId} ({@Command})\",\n            command.GetGenericTypeName(),\n            nameof(command.OrderNumber),\n            command.OrderNumber,\n            command);\n\n        await mediator.Send(command);\n    }\n}\n"}],"structuredContent":{"summary":{"scope":{"repo":"eShop"},"blocks":5,"token_estimate":996,"truncated":false,"clipped":false},"blocks":[{"blob":278,"blob_sha":"a9aec956f9d40894d1f5ebee7732152825c0075d","repo":"eShop","path_with_namespace":"eShop","rel_path":"src/EventBus/Abstractions/IIntegrationEventHandler.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/framework-bridge/eshop-final/corpus/eShop/src/EventBus/Abstractions/IIntegrationEventHandler.cs","start_line":1,"end_line":14,"score":0.04918032786885246,"lexical":52.47512959050632,"dense":0,"text":"namespace eShop.EventBus.Abstractions;\n\npublic in