{
  "task": {
    "id": "flow-validation-error",
    "prompt": "Trace request validation failures through the application pipeline to the configured HTTP error response. What happens before the next handler is called, and what evidence connects the web exception handler? Cite precise checked-in source ranges and separate configuration from observed runtime behavior.",
    "atoms": [
      {
        "id": "flow-validation-error.1",
        "requirement": "ValidationBehaviour receives IEnumerable<IValidator<TRequest>> and runs async validators with the cancellation token.",
        "evidence": [
          {
            "path": "src/Application/Common/Behaviours/ValidationBehaviour.cs",
            "start_line": 8,
            "end_line": 21,
            "raw_sha256": "1b93f144bfb1b432578d73d8cb49a4157a5d69631210c28bcaab00a9b47004f3",
            "excerpt": "    private readonly IEnumerable<IValidator<TRequest>> _validators;\n\n    public ValidationBehaviour(IEnumerable<IValidator<TRequest>> validators)\n    {\n        _validators = validators;\n    }\n\n    public async Task<TResponse> Handle(TRequest request, RequestHandlerDelegate<TResponse> next, CancellationToken cancellationToken)\n    {\n        if (_validators.Any())\n        {\n            var validationResults = await Task.WhenAll(\n                _validators.Select(v =>\n                    v.ValidateAsync(new ValidationContext<TRequest>(request), cancellationToken)));"
          }
        ]
      },
      {
        "id": "flow-validation-error.2",
        "requirement": "It aggregates errors, throws the application ValidationException when failures exist, and only otherwise invokes next.",
        "evidence": [
          {
            "path": "src/Application/Common/Behaviours/ValidationBehaviour.cs",
            "start_line": 23,
            "end_line": 32,
            "raw_sha256": "1b93f144bfb1b432578d73d8cb49a4157a5d69631210c28bcaab00a9b47004f3",
            "excerpt": "            var failures = validationResults\n                .Where(r => r.Errors.Any())\n                .SelectMany(r => r.Errors)\n                .ToList();\n\n            if (failures.Count != 0)\n                throw new ValidationException(failures);\n        }\n\n        return await next();"
          },
          {
            "path": "src/Application/Common/Behaviours/ValidationBehaviour.cs",
            "start_line": 1,
            "end_line": 1,
            "raw_sha256": "1b93f144bfb1b432578d73d8cb49a4157a5d69631210c28bcaab00a9b47004f3",
            "excerpt": "using ValidationException = CleanArchitecture.Application.Common.Exceptions.ValidationException;"
          }
        ]
      },
      {
        "id": "flow-validation-error.3",
        "requirement": "ValidationException groups messages by property name into Errors.",
        "evidence": [
          {
            "path": "src/Application/Common/Exceptions/ValidationException.cs",
            "start_line": 13,
            "end_line": 21,
            "raw_sha256": "fe225cf01db9b9e99cb50814b99c855fb963c4428cd3a1c4a50b4337185241c7",
            "excerpt": "    public ValidationException(IEnumerable<ValidationFailure> failures)\n        : this()\n    {\n        Errors = failures\n            .GroupBy(e => e.PropertyName, e => e.ErrorMessage)\n            .ToDictionary(failureGroup => failureGroup.Key, failureGroup => failureGroup.ToArray());\n    }\n\n    public IDictionary<string, string[]> Errors { get; }"
          }
        ]
      },
      {
        "id": "flow-validation-error.4",
        "requirement": "ProblemDetailsExceptionHandler maps that exception to HTTP400 ValidationProblemDetails and writes the response.",
        "evidence": [
          {
            "path": "src/Web/Infrastructure/ProblemDetailsExceptionHandler.cs",
            "start_line": 17,
            "end_line": 23,
            "raw_sha256": "7b9ed673cd416d1b0c17088883ee1764fa22efc018fb6b2691cc2a51e8c9c925",
            "excerpt": "        var (statusCode, problemDetails) = exception switch\n        {\n            ValidationException ve => (StatusCodes.Status400BadRequest, (ProblemDetails)new ValidationProblemDetails(ve.Errors)\n            {\n                Status = StatusCodes.Status400BadRequest,\n                Type = \"https://tools.ietf.org/html/rfc9110#section-15.5.1\"\n            }),"
          },
          {
            "path": "src/Web/Infrastructure/ProblemDetailsExceptionHandler.cs",
            "start_line": 46,
            "end_line": 50,
            "raw_sha256": "7b9ed673cd416d1b0c17088883ee1764fa22efc018fb6b2691cc2a51e8c9c925",
            "excerpt": "        if (problemDetails is null) return false;\n\n        httpContext.Response.StatusCode = statusCode;\n        await httpContext.Response.WriteAsJsonAsync(problemDetails, cancellationToken);\n        return true;"
          },
          {
            "path": "src/Web/Infrastructure/ProblemDetailsExceptionHandler.cs",
            "start_line": 1,
            "end_line": 3,
            "raw_sha256": "7b9ed673cd416d1b0c17088883ee1764fa22efc018fb6b2691cc2a51e8c9c925",
            "excerpt": "using CleanArchitecture.Application.Common.Exceptions;\nusing Microsoft.AspNetCore.Diagnostics;\nusing Microsoft.AspNetCore.Mvc;"
          }
        ]
      },
      {
        "id": "flow-validation-error.5",
        "requirement": "Web DI registers the exception handler, startup invokes Web services and enables exception middleware; application registers validation behavior.",
        "evidence": [
          {
            "path": "src/Web/DependencyInjection.cs",
            "start_line": 19,
            "end_line": 19,
            "raw_sha256": "5108eedecf1ec69b0d5f9a9431c64ea5e743b50cd0577ef9766ecdc909672968",
            "excerpt": "        builder.Services.AddExceptionHandler<ProblemDetailsExceptionHandler>();"
          },
          {
            "path": "src/Web/Program.cs",
            "start_line": 10,
            "end_line": 12,
            "raw_sha256": "a2374af31194bdd866e30cacbdc7c4a0ea7ed485eddd28a757b5e60206681a2e",
            "excerpt": "builder.AddApplicationServices();\nbuilder.AddInfrastructureServices();\nbuilder.AddWebServices();"
          },
          {
            "path": "src/Web/Program.cs",
            "start_line": 38,
            "end_line": 38,
            "raw_sha256": "a2374af31194bdd866e30cacbdc7c4a0ea7ed485eddd28a757b5e60206681a2e",
            "excerpt": "app.UseExceptionHandler(options => { });"
          },
          {
            "path": "src/Application/DependencyInjection.cs",
            "start_line": 21,
            "end_line": 21,
            "raw_sha256": "55deb255ce0c1f774d42964b1362c1d7b6aeaf7e93d7f78e95b96eb936b396da",
            "excerpt": "            cfg.AddOpenBehavior(typeof(ValidationBehaviour<,>));"
          }
        ]
      }
    ]
  },
