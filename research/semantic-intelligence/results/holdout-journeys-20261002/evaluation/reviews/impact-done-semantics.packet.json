{
  "task": {
    "id": "impact-done-semantics",
    "prompt": "If the semantics of TodoItem.Done change, which endpoint, request handler, event trigger, and notification consumers should be reviewed along the update/completion path? Explain why static declarations alone cannot establish successful delivery. Cite precise checked-in source ranges and separate configuration from observed runtime behavior.",
    "atoms": [
      {
        "id": "impact-done-semantics.1",
        "requirement": "TodoItems maps the authorized PUT update endpoint, rejects mismatched URL/payload IDs and sends the update command.",
        "evidence": [
          {
            "path": "src/Web/Endpoints/TodoItems.cs",
            "start_line": 11,
            "end_line": 18,
            "raw_sha256": "3b87bb21953a54b5933c8b13efb508dbf9b67b108405cce0acb27b7d5915ef4b",
            "excerpt": "    public static void Map(RouteGroupBuilder groupBuilder)\n    {\n        groupBuilder.RequireAuthorization();\n\n        groupBuilder.MapPost(CreateTodoItem);\n        groupBuilder.MapPut(UpdateTodoItem, \"{id}\");\n        groupBuilder.MapPatch(UpdateTodoItemDetail, \"UpdateDetail/{id}\");\n        groupBuilder.MapDelete(DeleteTodoItem, \"{id}\");"
          },
          {
            "path": "src/Web/Endpoints/TodoItems.cs",
            "start_line": 32,
            "end_line": 39,
            "raw_sha256": "3b87bb21953a54b5933c8b13efb508dbf9b67b108405cce0acb27b7d5915ef4b",
            "excerpt": "    public static async Task<Results<NoContent, BadRequest>> UpdateTodoItem(ISender sender, int id, UpdateTodoItemCommand command)\n    {\n        if (id != command.Id)\n            return TypedResults.BadRequest();\n\n        await sender.Send(command);\n\n        return TypedResults.NoContent();"
          }
        ]
      },
      {
        "id": "impact-done-semantics.2",
        "requirement": "UpdateTodoItemCommand has Done and its handler copies it into entity.Done before SaveChangesAsync.",
        "evidence": [
          {
            "path": "src/Application/TodoItems/Commands/UpdateTodoItem/UpdateTodoItem.cs",
            "start_line": 5,
            "end_line": 11,
            "raw_sha256": "a0a8174c7874e653de8a3c89b19a299cbada3548b46f20c25265dcb016132403",
            "excerpt": "public record UpdateTodoItemCommand : IRequest\n{\n    public int Id { get; init; }\n\n    public string? Title { get; init; }\n\n    public bool Done { get; init; }"
          },
          {
            "path": "src/Application/TodoItems/Commands/UpdateTodoItem/UpdateTodoItem.cs",
            "start_line": 23,
            "end_line": 33,
            "raw_sha256": "a0a8174c7874e653de8a3c89b19a299cbada3548b46f20c25265dcb016132403",
            "excerpt": "    public async Task Handle(UpdateTodoItemCommand request, CancellationToken cancellationToken)\n    {\n        var entity = await _context.TodoItems\n            .FindAsync([request.Id], cancellationToken);\n\n        Guard.Against.NotFound(request.Id, entity);\n\n        entity.Title = request.Title;\n        entity.Done = request.Done;\n\n        await _context.SaveChangesAsync(cancellationToken);"
          }
        ]
      },
      {
        "id": "impact-done-semantics.3",
        "requirement": "Review false-to-true emission in entity.Done and the event item payload.",
        "evidence": [
          {
            "path": "src/Domain/Entities/TodoItem.cs",
            "start_line": 13,
            "end_line": 25,
            "raw_sha256": "90655b6cd79bcc53716b4eb5846188457a1730416ce39256810ef44bf2dc6a32",
            "excerpt": "    private bool _done;\n    public bool Done\n    {\n        get => _done;\n        set\n        {\n            if (value && !_done)\n            {\n                AddDomainEvent(new TodoItemCompletedEvent(this));\n            }\n\n            _done = value;\n        }"
          },
          {
            "path": "src/Domain/Events/TodoItemCompletedEvent.cs",
            "start_line": 3,
            "end_line": 10,
            "raw_sha256": "ad1945f366055ecfbe4de974ab4de851ea5d08c832fa02676ef0fb870b0beb62",
            "excerpt": "public class TodoItemCompletedEvent : BaseEvent\n{\n    public TodoItemCompletedEvent(TodoItem item)\n    {\n        Item = item;\n    }\n\n    public TodoItem Item { get; }"
          }
        ]
      },
      {
        "id": "impact-done-semantics.4",
        "requirement": "Review tracked-event clearing/publication and declared LogTodoItemCompleted notification handler.",
        "evidence": [
          {
            "path": "src/Infrastructure/Data/Interceptors/DispatchDomainEventsInterceptor.cs",
            "start_line": 36,
            "end_line": 48,
            "raw_sha256": "01da9ed4cebd02e26035a2cb871274c75e27283a965025ec3340bf50470055bb",
            "excerpt": "        var entities = context.ChangeTracker\n            .Entries<BaseEntity>()\n            .Where(e => e.Entity.DomainEvents.Any())\n            .Select(e => e.Entity);\n\n        var domainEvents = entities\n            .SelectMany(e => e.DomainEvents)\n            .ToList();\n\n        entities.ToList().ForEach(e => e.ClearDomainEvents());\n\n        foreach (var domainEvent in domainEvents)\n            await _mediator.Publish(domainEvent);"
          },
          {
            "path": "src/Application/TodoItems/EventHandlers/LogTodoItemCompleted.cs",
            "start_line": 6,
            "end_line": 19,
            "raw_sha256": "9b1e2b4a6a6c9bc08c90cb61a1cc9ddc699a49d51b9a7dd5db58758898581165",
            "excerpt": "public class LogTodoItemCompleted : INotificationHandler<TodoItemCompletedEvent>\n{\n    private readonly ILogger<LogTodoItemCompleted> _logger;\n\n    public LogTodoItemCompleted(ILogger<LogTodoItemCompleted> logger)\n    {\n        _logger = logger;\n    }\n\n    public Task Handle(TodoItemCompletedEvent notification, CancellationToken cancellationToken)\n    {\n        _logger.LogInformation(\"CleanArchitecture Domain Event: {DomainEvent}\", notification.GetType().Name);\n\n        return Task.CompletedTask;"
          },
          {
            "path": "src/Domain/Common/BaseEntity.cs",
            "start_line": 26,
            "end_line": 29,
            "raw_sha256": "b933f85dfb3eca48ba7c3559a1d2f9fbaf94b5cc96ee0a5de998b81d93e156ad",
            "excerpt": "    public void ClearDomainEvents()\n    {\n        _domainEvents.Clear();\n    }"
          }
        ]
      },
      {
        "id": "impact-done-semantics.5",
        "requirement": "Assembly scan and save interceptor wiring establish configured paths, not actual delivery or a successful commit.",
        "evidence": [
          {
            "path": "src/Application/DependencyInjection.cs",
            "start_line": 16,
            "end_line": 23,
            "raw_sha256": "55deb255ce0c1f774d42964b1362c1d7b6aeaf7e93d7f78e95b96eb936b396da",
            "excerpt": "        builder.Services.AddMediatR(cfg => {\n            cfg.RegisterServicesFromAssembly(Assembly.GetExecutingAssembly());\n            cfg.AddOpenRequestPreProcessor(typeof(LoggingBehaviour<>));\n            cfg.AddOpenBehavior(typeof(UnhandledExceptionBehaviour<,>));\n            cfg.AddOpenBehavior(typeof(AuthorizationBehaviour<,>));\n            cfg.AddOpenBehavior(typeof(ValidationBehaviour<,>));\n            cfg.AddOpenBehavior(typeof(PerformanceBehaviour<,>));\n        });"
          },
          {
            "path": "src/Infrastructure/DependencyInjection.cs",
            "start_line": 20,
            "end_line": 25,
            "raw_sha256": "2a552c701fb860cae6dc6f04e57b87c538a80b70f1757c3f56ce5908a56b84ea",
            "excerpt": "        builder.Services.AddScoped<ISaveChangesInterceptor, AuditableEntityInterceptor>();\n        builder.Services.AddScoped<ISaveChangesInterceptor, DispatchDomainEventsInterceptor>();\n\n        builder.Services.AddDbContext<ApplicationDbContext>((sp, options) =>\n        {\n            options.AddInterceptors(sp.GetServices<ISaveChangesInterceptor>());"
          },
          {
            "path": "src/Infrastructure/Data/Interceptors/DispatchDomainEventsInterceptor.cs",
            "start_line": 17,
            "end_line": 29,
            "raw_sha256": "01da9ed4cebd02e26035a2cb871274c75e27283a965025ec3340bf50470055bb",
            "excerpt": "    public override InterceptionResult<int> SavingChanges(DbContextEventData eventData, InterceptionResult<int> result)\n    {\n        DispatchDomainEvents(eventData.Context).GetAwaiter().GetResult();\n\n        return base.SavingChanges(eventData, result);\n\n    }\n\n    public override async ValueTask<InterceptionResult<int>> SavingChangesAsync(DbContextEventData eventData, InterceptionResult<int> result, CancellationToken cancellationToken = default)\n    {\n        await DispatchDomainEvents(eventData.Context);\n\n        return await base.SavingChangesAsync(eventData, result, cancellationToken);"
          }
        ]
      }
    ]
