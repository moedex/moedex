  "task": {
    "id": "locate-db-wiring",
    "prompt": "How are the application database abstraction and save-change interceptors wired, and which database provider alternatives appear in the checked-in configuration? Cite precise checked-in source ranges and separate configuration from observed runtime behavior.",
    "atoms": [
      {
        "id": "locate-db-wiring.1",
        "requirement": "Two scoped ISaveChangesInterceptor registrations: AuditableEntityInterceptor and DispatchDomainEventsInterceptor.",
        "evidence": [
          {
            "path": "src/Infrastructure/DependencyInjection.cs",
            "start_line": 20,
            "end_line": 21,
            "raw_sha256": "2a552c701fb860cae6dc6f04e57b87c538a80b70f1757c3f56ce5908a56b84ea",
            "excerpt": "        builder.Services.AddScoped<ISaveChangesInterceptor, AuditableEntityInterceptor>();\n        builder.Services.AddScoped<ISaveChangesInterceptor, DispatchDomainEventsInterceptor>();"
          }
        ]
      },
      {
        "id": "locate-db-wiring.2",
        "requirement": "ApplicationDbContext options resolve and attach all ISaveChangesInterceptor services.",
        "evidence": [
          {
            "path": "src/Infrastructure/DependencyInjection.cs",
            "start_line": 23,
            "end_line": 25,
            "raw_sha256": "2a552c701fb860cae6dc6f04e57b87c538a80b70f1757c3f56ce5908a56b84ea",
            "excerpt": "        builder.Services.AddDbContext<ApplicationDbContext>((sp, options) =>\n        {\n            options.AddInterceptors(sp.GetServices<ISaveChangesInterceptor>());"
          }
        ]
      },
      {
        "id": "locate-db-wiring.3",
        "requirement": "IApplicationDbContext is scoped and resolves the registered ApplicationDbContext through a factory.",
        "evidence": [
          {
            "path": "src/Infrastructure/DependencyInjection.cs",
            "start_line": 42,
            "end_line": 42,
            "raw_sha256": "2a552c701fb860cae6dc6f04e57b87c538a80b70f1757c3f56ce5908a56b84ea",
            "excerpt": "        builder.Services.AddScoped<IApplicationDbContext>(provider => provider.GetRequiredService<ApplicationDbContext>());"
          }
        ]
      },
      {
        "id": "locate-db-wiring.4",
        "requirement": "Compile-time branches use PostgreSQL for UsePostgreSQL, SQL Server for UseSqlServer when the first symbol is absent, otherwise SQLite. The declared Debug/net10.0 build with no custom DefineConstants selects the SQLite branch; this does not prove a deployed database or runtime connection.",
        "evidence": [
          {
            "path": "src/Infrastructure/DependencyInjection.cs",
            "start_line": 26,
            "end_line": 32,
            "raw_sha256": "2a552c701fb860cae6dc6f04e57b87c538a80b70f1757c3f56ce5908a56b84ea",
            "excerpt": "#if (UsePostgreSQL)\n            options.UseNpgsql(connectionString);\n#elif (UseSqlServer)\n            options.UseSqlServer(connectionString);\n#else\n            options.UseSqlite(connectionString);\n#endif"
          }
        ]
      },
      {
        "id": "locate-db-wiring.5",
        "requirement": "Web startup calls application, infrastructure, and web registration methods; source configuration is not runtime execution proof.",
        "evidence": [
          {
            "path": "src/Web/Program.cs",
            "start_line": 10,
            "end_line": 14,
            "raw_sha256": "a2374af31194bdd866e30cacbdc7c4a0ea7ed485eddd28a757b5e60206681a2e",
            "excerpt": "builder.AddApplicationServices();\nbuilder.AddInfrastructureServices();\nbuilder.AddWebServices();\n\nvar app = builder.Build();"
          }
        ]
      }
    ]
  },
