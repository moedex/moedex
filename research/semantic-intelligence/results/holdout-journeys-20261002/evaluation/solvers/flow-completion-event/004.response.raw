{"jsonrpc":"2.0","id":4,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308","blob_shas":["9f25fc0c4cf5e02703e071f7b94ff9c852cd2a54"]}},"content":[{"type":"text","text":"--- src/Infrastructure/Data/Interceptors/DispatchDomainEventsInterceptor.cs:8-50 (repo CleanArchitecture) ---\n8 | public class DispatchDomainEventsInterceptor : SaveChangesInterceptor\n9 | {\n10 |     private readonly IMediator _mediator;\n11 | \n12 |     public DispatchDomainEventsInterceptor(IMediator mediator)\n13 |     {\n14 |         _mediator = mediator;\n15 |     }\n16 | \n17 |     public override InterceptionResult\u003cint\u003e SavingChanges(DbContextEventData eventData, InterceptionResult\u003cint\u003e result)\n18 |     {\n19 |         DispatchDomainEvents(eventData.Context).GetAwaiter().GetResult();\n20 | \n21 |         return base.SavingChanges(eventData, result);\n22 | \n23 |     }\n24 | \n25 |     public override async ValueTask\u003cInterceptionResult\u003cint\u003e\u003e SavingChangesAsync(DbContextEventData eventData, InterceptionResult\u003cint\u003e result, CancellationToken cancellationToken = default)\n26 |     {\n27 |         await DispatchDomainEvents(eventData.Context);\n28 | \n29 |         return await base.SavingChangesAsync(eventData, result, cancellationToken);\n30 |     }\n31 | \n32 |     public async Task DispatchDomainEvents(DbContext? context)\n33 |     {\n34 |         if (context == null) return;\n35 | \n36 |         var entities = context.ChangeTracker\n37 |             .Entries\u003cBaseEntity\u003e()\n38 |             .Where(e =\u003e e.Entity.DomainEvents.Any())\n39 |             .Select(e =\u003e e.Entity);\n40 | \n41 |         var domainEvents = entities\n42 |             .SelectMany(e =\u003e e.DomainEvents)\n43 |             .ToList();\n44 | \n45 |         entities.ToList().ForEach(e =\u003e e.ClearDomainEvents());\n46 | \n47 |         foreach (var domainEvent in domainEvents)\n48 |             await _mediator.Publish(domainEvent);\n49 |     }\n50 | }\n"}],"structuredContent":{"repo":"CleanArchitecture","path":"src/Infrastructure/Data/Interceptors/DispatchDomainEventsInterceptor.cs","blob_sha":"9f25fc0c4cf5e02703e071f7b94ff9c852cd2a54","lines":51,"start_line":8,"end_line":50,"truncated":true,"content":"public class DispatchDomainEventsInterceptor : SaveChangesInterceptor\n{\n    private readonly IMediator _mediator;\n\n    public DispatchDomainEventsInterceptor(IMediator mediator)\n    {\n        _mediator = mediator;\n    }\n\n    public override InterceptionResult\u003cint\u003e SavingChanges(DbContextEventData eventData, InterceptionResult\u003cint\u003e result)\n    {\n        DispatchDomainEvents(eventData.Context).GetAwaiter().GetResult();\n\n        return base.SavingChanges(eventData, result);\n\n    }\n\n    public override async ValueTask\u003cInterceptionResult\u003cint\u003e\u003e SavingChangesAsync(DbContextEventData eventData, InterceptionResult\u003cint\u003e result, CancellationToken cancellationToken = default)\n    {\n        await DispatchDomainEvents(eventData.Context);\n\n        return await base.SavingChangesAsync(eventData, result, cancellationToken);\n    }\n\n    public async Task DispatchDomainEvents(DbContext? context)\n    {\n        if (context == null) return;\n\n        var entities = context.ChangeTracker\n            .Entries\u003cBaseEntity\u003e()\n            .Where(e =\u003e e.Entity.DomainEvents.Any())\n            .Select(e =\u003e e.Entity);\n\n        var domainEvents = entities\n            .SelectMany(e =\u003e e.DomainEvents)\n            .ToList();\n\n        entities.ToList().ForEach(e =\u003e e.ClearDomainEvents());\n\n        foreach (var domainEvent in domainEvents)\n            await _mediator.Publish(domainEvent);\n    }\n}"}}}