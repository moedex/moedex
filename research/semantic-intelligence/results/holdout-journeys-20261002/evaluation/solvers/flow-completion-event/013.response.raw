{"jsonrpc":"2.0","id":13,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308","blob_shas":["f361e454102210a35b9f9c4f1f8e74839cfcf5e2"]}},"content":[{"type":"text","text":"--- src/Infrastructure/DependencyInjection.cs:15-42 (repo CleanArchitecture) ---\n15 |     public static void AddInfrastructureServices(this IHostApplicationBuilder builder)\n16 |     {\n17 |         var connectionString = builder.Configuration.GetConnectionString(Services.Database);\n18 |         Guard.Against.Null(connectionString, message: $\"Connection string '{Services.Database}' not found.\");\n19 | \n20 |         builder.Services.AddScoped\u003cISaveChangesInterceptor, AuditableEntityInterceptor\u003e();\n21 |         builder.Services.AddScoped\u003cISaveChangesInterceptor, DispatchDomainEventsInterceptor\u003e();\n22 | \n23 |         builder.Services.AddDbContext\u003cApplicationDbContext\u003e((sp, options) =\u003e\n24 |         {\n25 |             options.AddInterceptors(sp.GetServices\u003cISaveChangesInterceptor\u003e());\n26 | #if (UsePostgreSQL)\n27 |             options.UseNpgsql(connectionString);\n28 | #elif (UseSqlServer)\n29 |             options.UseSqlServer(connectionString);\n30 | #else\n31 |             options.UseSqlite(connectionString);\n32 | #endif\n33 |             options.ConfigureWarnings(warnings =\u003e warnings.Ignore(RelationalEventId.PendingModelChangesWarning));\n34 |         });\n35 | \n36 | #if UsePostgreSQL\n37 |         builder.EnrichNpgsqlDbContext\u003cApplicationDbContext\u003e();\n38 | #elif (UseSqlServer)\n39 |         builder.EnrichSqlServerDbContext\u003cApplicationDbContext\u003e();\n40 | #endif\n41 | \n42 |         builder.Services.AddScoped\u003cIApplicationDbContext\u003e(provider =\u003e provider.GetRequiredService\u003cApplicationDbContext\u003e());\n"}],"structuredContent":{"repo":"CleanArchitecture","path":"src/Infrastructure/DependencyInjection.cs","blob_sha":"f361e454102210a35b9f9c4f1f8e74839cfcf5e2","lines":80,"start_line":15,"end_line":42,"truncated":true,"content":"    public static void AddInfrastructureServices(this IHostApplicationBuilder builder)\r\n    {\r\n        var connectionString = builder.Configuration.GetConnectionString(Services.Database);\r\n        Guard.Against.Null(connectionString, message: $\"Connection string '{Services.Database}' not found.\");\r\n\r\n        builder.Services.AddScoped\u003cISaveChangesInterceptor, AuditableEntityInterceptor\u003e();\r\n        builder.Services.AddScoped\u003cISaveChangesInterceptor, DispatchDomainEventsInterceptor\u003e();\r\n\r\n        builder.Services.AddDbContext\u003cApplicationDbContext\u003e((sp, options) =\u003e\r\n        {\r\n            options.AddInterceptors(sp.GetServices\u003cISaveChangesInterceptor\u003e());\r\n#if (UsePostgreSQL)\r\n            options.UseNpgsql(connectionString);\r\n#elif (UseSqlServer)\r\n            options.UseSqlServer(connectionString);\r\n#else\r\n            options.UseSqlite(connectionString);\r\n#endif\r\n            options.ConfigureWarnings(warnings =\u003e warnings.Ignore(RelationalEventId.PendingModelChangesWarning));\r\n        });\r\n\r\n#if UsePostgreSQL\r\n        builder.EnrichNpgsqlDbContext\u003cApplicationDbContext\u003e();\r\n#elif (UseSqlServer)\r\n        builder.EnrichSqlServerDbContext\u003cApplicationDbContext\u003e();\r\n#endif\r\n\r\n        builder.Services.AddScoped\u003cIApplicationDbContext\u003e(provider =\u003e provider.GetRequiredService\u003cApplicationDbContext\u003e());\r"}}}