, \\\"{id}\\\");\\n19 |     }\\n20 | \\n21 |     [EndpointSummary(\\\"Create a new Todo Item\\\")]\\n22 |     [EndpointDescription(\\\"Creates a new todo item using the provided details and returns the ID of the created item.\\\")]\\n23 |     public static async Task<Created<int>> CreateTodoItem(ISender sender, CreateTodoItemCommand command)\\n24 |     {\\n25 |         var id = await sender.Send(command);\\n26 | \\n27 |         return TypedResults.Created($\\\"/{nameof(TodoItems)}/{id}\\\", id);\\n28 |     }\\n29 | \\n30 |     [EndpointSummary(\\\"Update a Todo Item\\\")]\\n31 |     [EndpointDescription(\\\"Updates the specified todo item. The ID in the URL must match the ID in the payload.\\\")]\\n32 |     public static async Task<Results<NoContent, BadRequest>> UpdateTodoItem(ISender sender, int id, UpdateTodoItemCommand command)\\n33 |     {\\n34 |         if (id != command.Id)\\n35 |             return TypedResults.BadRequest();\\n36 | \\n37 |         await sender.Send(command);\\n38 | \\n39 |         return TypedResults.NoContent();\\n40 |     }\\n41 | \\n42 |     [EndpointSummary(\\\"Update Todo Item Details\\\")]\\n43 |     [EndpointDescription(\\\"Updates the detail fields of a specific todo item. The ID in the URL must match the ID in the payload.\\\")]\\n44 |     public static async Task<Results<NoContent, BadRequest>> UpdateTodoItemDetail(ISender sender, int id, UpdateTodoItemDetailCommand command)\\n45 |     {\\n46 |         if (id != command.Id) return TypedResults.BadRequest();\\n47 | \\n48 |         await sender.Send(command);\\n49 | \\n50 |         return TypedResults.NoContent();\\n51 |     }\\n52 | \\n53 |     [EndpointSummary(\\\"Delete a Todo Item\\\")]\\n54 |     [EndpointDescription(\\\"Deletes the todo item with the specified ID.\\\")]\\n55 |     public static async Task<NoContent> DeleteTodoItem(ISender sender, int id)\\n56 |     {\\n57 |         await sender.Send(new DeleteTodoItemCommand(id));\\n58 | \\n59 |         return TypedResults.NoContent();\\n60 |     }\\n61 | }\\n\\n--- tests/Application.FunctionalTests/TodoItems/Commands/DeleteTodoItemTests.cs:1-38 (score 0.0154) ---\\n1 | using CleanArchitecture.Application.TodoItems.Commands.CreateTodoItem;\\n2 | using CleanArchitecture.Application.TodoItems.Commands.DeleteTodoItem;\\n3 | using CleanArchitecture.Application.TodoLists.Commands.CreateTodoList;\\n4 | using CleanArchitecture.Domain.Entities;\\n5 | \\n6 | namespace CleanArchitecture.Application.FunctionalTests.TodoItems.Commands;\\n7 | \\n8 | public class DeleteTodoItemTests : TestBase\\n9 | {\\n10 |     [Test]\\n11 |     public async Task ShouldRequireValidTodoItemId()\\n12 |     {\\n13 |         var command = new DeleteTodoItemCommand(99);\\n14 | \\n15 |         await Should.ThrowAsync<NotFoundException>(() => TestApp.SendAsync(command));\\n16 |     }\\n17 | \\n18 |     [Test]\\n19 |     public async Task ShouldDeleteTodoItem()\\n20 |     {\\n21 |         var listId = await TestApp.SendAsync(new CreateTodoListCommand\\n22 |         {\\n23 |             Title = \\\"New List\\\"\\n24 |         });\\n25 | \\n26 |         var itemId = await TestApp.SendAsync(new CreateTodoItemCommand\\n27 |         {\\n28 |             ListId = listId,\\n29 |             Title = \\\"New Item\\\"\\n30 |         });\\n31 | \\n32 |         await TestApp.SendAsync(new DeleteTodoItemCommand(itemId));\\n33 | \\n34 |         var item = await TestApp.FindAsync<TodoItem>(itemId);\\n35 | \\n36 |         item.ShouldBeNull();\\n37 |     }\\n38 | }\\n\\n--- tests/Application.FunctionalTests/TodoItems/Commands/UpdateTodoItemDetailTests.cs:1-56 (score 0.0152) ---\\n1 | using CleanArchitecture.Application.TodoItems.Commands.CreateTodoItem;\\n2 | using CleanArchitecture.Application.TodoItems.Commands.UpdateTodoItem;\\n3 | using CleanArchitecture.Application.TodoItems.Commands.UpdateTodoItemDetail;\\n4 | using CleanArchitecture.Application.TodoLists.Commands.CreateTodoList;\\n5 | using CleanArchitecture.Domain.Entities;\\n6 | usin