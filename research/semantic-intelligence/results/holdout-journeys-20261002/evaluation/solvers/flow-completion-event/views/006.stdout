ellationToken cancellationToken = default)\\n26 |     {\\n27 |         await DispatchDomainEvents(eventData.Context);\\n28 | \\n29 |         return await base.SavingChangesAsync(eventData, result, cancellationToken);\\n30 |     }\\n31 | \\n32 |     public async Task DispatchDomainEvents(DbContext? context)\\n33 |     {\\n34 |         if (context == null) return;\\n35 | \\n36 |         var entities = context.ChangeTracker\\n37 |             .Entries<BaseEntity>()\\n38 |             .Where(e => e.Entity.DomainEvents.Any())\\n39 |             .Select(e => e.Entity);\\n40 | \\n41 |         var domainEvents = entities\\n42 |             .SelectMany(e => e.DomainEvents)\\n43 |             .ToList();\\n44 | \\n45 |         entities.ToList().ForEach(e => e.ClearDomainEvents());\\n46 | \\n47 |         foreach (var domainEvent in domainEvents)\\n48 |             await _mediator.Publish(domainEvent);\\n49 |     }\\n50 | }\\n\\n--- src/Infrastructure/DependencyInjection.cs:15-78 (score 0.0161) ---\\n15 |     public static void AddInfrastructureServices(this IHostApplicationBuilder builder)\\n16 |     {\\n17 |         var connectionString = builder.Configuration.GetConnectionString(Services.Database);\\n18 |         Guard.Against.Null(connectionString, message: $\\\"Connection string '{Services.Database}' not found.\\\");\\n19 | \\n20 |         builder.Services.AddScoped<ISaveChangesInterceptor, AuditableEntityInterceptor>();\\n21 |         builder.Services.AddScoped<ISaveChangesInterceptor, DispatchDomainEventsInterceptor>();\\n22 | \\n23 |         builder.Services.AddDbContext<ApplicationDbContext>((sp, options) =>\\n24 |         {\\n25 |             options.AddInterceptors(sp.GetServices<ISaveChangesInterceptor>());\\n26 | #if (UsePostgreSQL)\\n27 |             options.UseNpgsql(connectionString);\\n28 | #elif (UseSqlServer)\\n29 |             options.UseSqlServer(connectionString);\\n30 | #else\\n31 |             options.UseSqlite(connectionString);\\n32 | #endif\\n33 |             options.ConfigureWarnings(warnings => warnings.Ignore(RelationalEventId.PendingModelChangesWarning));\\n34 |         });\\n35 | \\n36 | #if UsePostgreSQL\\n37 |         builder.EnrichNpgsqlDbContext<ApplicationDbContext>();\\n38 | #elif (UseSqlServer)\\n39 |         builder.EnrichSqlServerDbContext<ApplicationDbContext>();\\n40 | #endif\\n41 | \\n42 |         builder.Services.AddScoped<IApplicationDbContext>(provider => provider.GetRequiredService<ApplicationDbContext>());\\n43 | \\n44 |         builder.Services.AddScoped<ApplicationDbContextInitialiser>();\\n45 | \\n46 | #if (UseApiOnly)\\n47 |         builder.Services.AddAuthentication()\\n48 |             .AddBearerToken(IdentityConstants.BearerScheme);\\n49 | \\n50 |         builder.Services.AddAuthorizationBuilder();\\n51 | \\n52 |         builder.Services\\n53 |             .AddIdentityCore<ApplicationUser>()\\n54 |             .AddRoles<IdentityRole>()\\n55 |             .AddEntityFrameworkStores<ApplicationDbContext>()\\n56 |             .AddApiEndpoints();\\n57 | #else\\n58 |         builder.Services.AddAuthentication(options =>\\n59 |             {\\n60 |                 options.DefaultScheme = IdentityConstants.ApplicationScheme;\\n61 |                 options.DefaultSignInScheme = IdentityConstants.ExternalScheme;\\n62 |             })\\n63 |             .AddIdentityCookies();\\n64 | \\n65 |         builder.Services.AddAuthorizationBuilder();\\n66 | \\n67 |         builder.Services\\n68 |             .AddIdentityCore<ApplicationUser>()\\n69 |             .AddRoles<IdentityRole>()\\n70 |             .AddEntityFrameworkStores<ApplicationDbContext>()\\n71 |             .AddSignInManager()\\n72 |             .AddDefaultTokenProviders()\\n73 |             .AddApiEndpoints();\\n74 | #endif\\n75 | \\n76 |         builder.Services.AddSingleton(TimeProvider.System);\\n77 |         builder.Services.AddTransient<IIdentityService, IdentityService>();\\n78 |     }\\n\\n--- src/Domain/Common/BaseEntity.cs:1-30 (score 0.0159) ---\\n1 | using System.ComponentModel.DataAnnotations.Schema;\\n2 | \\n3 | namespace CleanArchitecture.Domain.Common;\\n4 | \\n5 | public abstract class BaseEntity\\n6 | {\\n7 |     // This can easily be modified to be BaseEntity<T> and public T Id to support different key types.\\n8 |     // Using non-generic integer types for simplicity\\n9 |     public int Id { get; set; }\\n10 | \\n11 |     private readonly List<BaseEvent> _domainEvents = new();\\n12 | \\n13 |     [NotMapped]\\n14 |     public IReadOnlyCollection<BaseEvent> DomainEvents => _domainEvents.AsReadOnly();\\n15 | \\n16 |     public void AddDomainEvent(BaseEvent domainEvent)\\n17 |     {\\n18 |         _domainEvents.Add(domainEvent);\\n19 |     }\\n20 | \\n21 |     public void RemoveDomainEvent(BaseEvent domainEvent)\\n22 |     {\\n23 |         _domainEvents.Remove(domainEvent);\\n24 |     }\\n25 | \\n26 |     public void ClearDomainEvents()\\n27 |     {\\n28 |         _domainEvents.Clear();\\n29 |     }\\n30 | }\\n\\n--- src/Infrastructure/DependencyInjection.cs:1-6 (score 0.0161) ---\\n1 | using CleanArchitecture.Application.Common.Interfaces;\\n2 | using CleanArchitecture.Infrastructure.Data;\\n3 | using CleanArchitecture.Infrastructure.Data.Interceptors;\\n4 | using CleanArchitecture.Infrastructure.Identity;\\n5 | using Microsoft.AspNetCore.Identity;\\n6 | using Microsoft.EntityFrameworkCore;\\n\"}],\"structuredContent\":{\"summary\":{\"scope\":{\"repo\":\"CleanArchitecture\"},\"blocks\":4,\"token_estimate\":1306,\"truncated\":false,\"clipped\":false},\"blocks\":[{\"blob\":92,\"blob_sha\":\"9f25fc0c4cf5e02703e071f7b94ff9c852cd2a54\",\"repo\":\"CleanArchitecture\",\"path_with_namespace\":\"CleanArchitecture\",\"rel_path\":\"src/Infrastructure/Data/Interceptors/DispatchDomainEventsInterceptor.cs\",\"abs_path\":\"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Infrastructure/Data/Interceptors/DispatchDomainEventsInterceptor.cs\",\"s