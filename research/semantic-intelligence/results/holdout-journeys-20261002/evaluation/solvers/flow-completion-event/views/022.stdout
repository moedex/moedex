{"view_version":1,"raw_sha256":"0cc05bc8d2e7983117f73bb316f9a7c8d0050310a2f4dfc4130f075f44e38baf","raw_bytes":1636,"pointer":"","offset":0,"total_characters":1596,"encoding":"concatenate data then JSON-decode","scope":"selected value only; other fields remain in raw response","context":{"ordinal":19,"calls_used":19,"response_bytes_used":74491,"response_complete":true,"http_status":200,"error":null,"stopped":null},"data":"{\"jsonrpc\":\"2.0\",\"id\":19,\"result\":{\"_meta\":{\"dev.moedex/server\":{\"version\":\"dev+unknown\"},\"dev.moedex/snapshot\":{\"cacheable\":true,\"corpus_fingerprint\":\"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308\",\"blob_shas\":[\"bde8a687bada78ad8335a70d11de80b8f22bb74f\"]}},\"content\":[{\"type\":\"text\",\"text\":\"--- src/Web/Endpoints/TodoItems.cs:30-40 (repo CleanArchitecture) ---\\n30 |     [EndpointSummary(\\\"Update a Todo Item\\\")]\\n31 |     [EndpointDescription(\\\"Updates the specified todo item. The ID in the URL must match the ID in the payload.\\\")]\\n32 |     public static async Task<Results<NoContent, BadRequest>> UpdateTodoItem(ISender sender, int id, UpdateTodoItemCommand command)\\n33 |     {\\n34 |         if (id != command.Id)\\n35 |             return TypedResults.BadRequest();\\n36 | \\n37 |         await sender.Send(command);\\n38 | \\n39 |         return TypedResults.NoContent();\\n40 |     }\\n\"}],\"structuredContent\":{\"repo\":\"CleanArchitecture\",\"path\":\"src/Web/Endpoints/TodoItems.cs\",\"blob_sha\":\"bde8a687bada78ad8335a70d11de80b8f22bb74f\",\"lines\":62,\"start_line\":30,\"end_line\":40,\"truncated\":true,\"content\":\"    [EndpointSummary(\\\"Update a Todo Item\\\")]\\n    [EndpointDescription(\\\"Updates the specified todo item. The ID in the URL must match the ID in the payload.\\\")]\\n    public static async Task<Results<NoContent, BadRequest>> UpdateTodoItem(ISender sender, int id, UpdateTodoItemCommand command)\\n    {\\n        if (id != command.Id)\\n            return TypedResults.BadRequest();\\n\\n        await sender.Send(command);\\n\\n        return TypedResults.NoContent();\\n    }\"}}}","next_offset":null,"partial":false}
