{"jsonrpc":"2.0","id":2,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308","blob_shas":["180ad2a805d416e0b10a910c194aec89deda3c06","5cac2a5ddac4c2421e5db2a9093b91c63b2c8413","7755643f57479edda6db088aa1c638b4c14db7ab","907087aec44ea75ab5cd5ece406f6d79ad5b1034","cbda534d085a443f30a3121b2542126db8a0d86d"]}},"content":[{"type":"text","text":"6 context block(s), ~1642 tokens\n\n--- src/Application/Common/Behaviours/ValidationBehaviour.cs:1-34 (score 0.0164) ---\n1 | using ValidationException = CleanArchitecture.Application.Common.Exceptions.ValidationException;\n2 | \n3 | namespace CleanArchitecture.Application.Common.Behaviours;\n4 | \n5 | public class ValidationBehaviour\u003cTRequest, TResponse\u003e : IPipelineBehavior\u003cTRequest, TResponse\u003e\n6 |     where TRequest : notnull\n7 | {\n8 |     private readonly IEnumerable\u003cIValidator\u003cTRequest\u003e\u003e _validators;\n9 | \n10 |     public ValidationBehaviour(IEnumerable\u003cIValidator\u003cTRequest\u003e\u003e validators)\n11 |     {\n12 |         _validators = validators;\n13 |     }\n14 | \n15 |     public async Task\u003cTResponse\u003e Handle(TRequest request, RequestHandlerDelegate\u003cTResponse\u003e next, CancellationToken cancellationToken)\n16 |     {\n17 |         if (_validators.Any())\n18 |         {\n19 |             var validationResults = await Task.WhenAll(\n20 |                 _validators.Select(v =\u003e\n21 |                     v.ValidateAsync(new ValidationContext\u003cTRequest\u003e(request), cancellationToken)));\n22 | \n23 |             var failures = validationResults\n24 |                 .Where(r =\u003e r.Errors.Any())\n25 |                 .SelectMany(r =\u003e r.Errors)\n26 |                 .ToList();\n27 | \n28 |             if (failures.Count != 0)\n29 |                 throw new ValidationException(failures);\n30 |         }\n31 | \n32 |         return await next();\n33 |     }\n34 | }\n\n--- src/Web/Infrastructure/ProblemDetailsExceptionHandler.cs:1-52 (score 0.0161) ---\n1 | using CleanArchitecture.Application.Common.Exceptions;\n2 | using Microsoft.AspNetCore.Diagnostics;\n3 | using Microsoft.AspNetCore.Mvc;\n4 | \n5 | namespace CleanArchitecture.Web.Infrastructure;\n6 | \n7 | /// \u003csummary\u003e\n8 | /// Converts well-known application exceptions into RFC 9110-compliant \u003csee cref=\"ProblemDetails\"/\u003e responses,\n9 | /// mapping \u003csee cref=\"ValidationException\"/\u003e → 400, \u003csee cref=\"NotFoundException\"/\u003e → 404,\n10 | /// \u003csee cref=\"UnauthorizedAccessException\"/\u003e → 401, and \u003csee cref=\"ForbiddenAccessException\"/\u003e → 403.\n11 | /// Unrecognised exceptions are not handled and fall through to the default middleware.\n12 | /// \u003c/summary\u003e\n13 | public class ProblemDetailsExceptionHandler : IExceptionHandler\n14 | {\n15 |     public async ValueTask\u003cbool\u003e TryHandleAsync(HttpContext httpContext, Exception exception, CancellationToken cancellationToken)\n16 |     {\n17 |         var (statusCode, problemDetails) = exception switch\n18 |         {\n19 |             ValidationException ve =\u003e (StatusCodes.Status400BadRequest, (ProblemDetails)new ValidationProblemDetails(ve.Errors)\n20 |             {\n21 |                 Status = StatusCodes.Status400BadRequest,\n22 |                 Type = \"https://tools.ietf.org/html/rfc9110#section-15.5.1\"\n23 |             }),\n24 |             NotFoundException ne =\u003e (StatusCodes.Status404NotFound, new ProblemDetails\n25 |             {\n26 |                 Status = StatusCodes.Status404NotFound,\n27 |                 Type = \"https://tools.ietf.org/html/rfc9110#section-15.5.5\",\n28 |                 Title = \"The specified resource was not found.\",\n29 |                 Detail = ne.Message\n30 |             }),\n31 |             UnauthorizedAccessException =\u003e (StatusCodes.Status401Unauthorized, new ProblemDetails\n32 |             {\n33 |                 Status = StatusCodes.Status401Unauthorized,\n34 |                 Title = \"Unauthorized\",\n35 |                 Type = \"https://tools.ietf.org/html/rfc9110#section-15.5.2\"\n36 |             }),\n37 |             ForbiddenAccessException =\u003e (StatusCodes.Status403Forbidden, new ProblemDetails\n38 |             {\n39 |                 Status = StatusCodes.Status403Forbidden,\n40 |                 Title = \"Forbidden\",\n41 |                 Type = \"https://tools.ietf.org/html/rfc9110#section-15.5.4\"\n42 |             }),\n43 |             _ =\u003e (-1, null)\n44 |         };\n45 | \n46 |         if (problemDetails is null) return false;\n47 | \n48 |         httpContext.Response.StatusCode = statusCode;\n49 |         await httpContext.Response.WriteAsJsonAsync(problemDetails, cancellationToken);\n50 |         return true;\n51 |     }\n52 | }\n\n--- src/Application/DependencyInjection.cs:9-24 (score 0.0159) ---\n9 |     public static void AddApplicationServices(this IHostApplicationBuilder builder)\n10 |     {\n11 |         builder.Services.AddAutoMapper(cfg =\u003e \n12 |             cfg.AddMaps(Assembly.GetExecutingAssembly()));\n13 | \n14 |         builder.Services.AddValidatorsFromAssembly(Assembly.GetExecutingAssembly());\n15 | \n16 |         builder.Services.AddMediatR(cfg =\u003e {\n17 |             cfg.RegisterServicesFromAssembly(Assembly.GetExecutingAssembly());\n18 |             cfg.AddOpenRequestPreProcessor(typeof(LoggingBehaviour\u003c\u003e));\n19 |             cfg.AddOpenBehavior(typeof(UnhandledExceptionBehaviour\u003c,\u003e));\n20 |             cfg.AddOpenBehavior(typeof(AuthorizationBehaviour\u003c,\u003e));\n21 |             cfg.AddOpenBehavior(typeof(ValidationBehaviour\u003c,\u003e));\n22 |             cfg.AddOpenBehavior(typeof(PerformanceBehaviour\u003c,\u003e));\n23 |         });\n24 |     }\n\n--- src/Web/DependencyInjection.cs:11-37 (score 0.0156) ---\n11 |     public static void AddWebServices(this IHostApplicationBuilder builder)\n12 |     {\n13 |         builder.Services.AddDatabaseDeveloperPageExceptionFilter();\n14 | \n15 |         builder.Services.AddScoped\u003cIUser, CurrentUser\u003e();\n16 | \n17 |         builder.Services.AddHttpContextAccessor();\n18 | \n19 |         builder.Services.AddExceptionHandler\u003cProblemDetailsExceptionHandler\u003e();\n20 | \n21 |         // Customise default API behaviour\n22 |         builder.Services.Configure\u003cApiBehaviorOptions\u003e(options =\u003e\n23 |             options.SuppressModelStateInvalidFilter = true);\n24 | \n25 |         builder.Services.AddEndpointsApiExplorer();\n26 | \n27 |         builder.Services.AddOpenApi(options =\u003e\n28 |         {\n29 |             options.AddOperationTransformer\u003cApiExceptionOperationTransformer\u003e();\n30 |             options.AddOperationTransformer\u003cIdentityApiOperationTransformer\u003e();\n31 | #if (UseApiOnly)\n32 |             options.AddDocumentTransformer\u003cBearerSecuritySchemeTransformer\u003e();\n33 | #endif\n34 |         });\n35 | \n36 |         builder.Services.AddCors();\n37 |     }\n\n--- src/Web/Infrastructure/ApiExceptionOperationTransformer.cs:6-31 (score 0.0154) ---\n6 | \n7 | /// \u003csummary\u003e\n8 | /// Adds standard error responses to every OpenAPI operation. A 400 Bad Request is added to all\n9 | /// operations because every request passes through \u003cc\u003eValidationBehaviour\u003c/c\u003e in the MediatR\n10 | /// pipeline. 401 Unauthorized and 403 Forbidden are added only to operations that carry\n11 | /// \u003csee cref=\"IAuthorizeData\"/\u003e metadata.\n12 | /// \u003c/summary\u003e\n13 | internal sealed class ApiExceptionOperationTransformer : IOpenApiOperationTransformer\n14 | {\n15 |     public Task TransformAsync(OpenApiOperation operation, OpenApiOperationTransformerContext context, CancellationToken cancellationToken)\n16 |     {\n17 |         operation.Responses ??= [];\n18 |         operation.Responses.TryAdd(\"400\", new OpenApiResponse { Description = \"Bad Request\" });\n19 | \n20 |         var requiresAuth = context.Description.ActionDescriptor.EndpointMetadata\n21 |             .Any(m =\u003e m is IAuthorizeData);\n22 | \n23 |         if (requiresAuth)\n24 |         {\n25 |             operation.Responses.TryAdd(\"401\", new OpenApiResponse { Description = \"Unauthorized\" });\n26 |             operation.Responses.TryAdd(\"403\", new OpenApiResponse { Description = \"Forbidden\" });\n27 |         }\n28 | \n29 |         return Task.CompletedTask;\n30 |     }\n31 | }\n\n--- src/Application/DependencyInjection.cs:1-5 (score 0.0159) ---\n1 | using System.Reflection;\n2 | using CleanArchitecture.Application.Common.Behaviours;\n3 | using Microsoft.Extensions.Hosting;\n4 | \n5 | namespace Microsoft.Extensions.DependencyInjection;\n"}],"structuredContent":{"summary":{"scope":{"repo":"CleanArchitecture"},"blocks":6,"token_estimate":1642,"truncated":false,"clipped":false},"blocks":[{"blob":45,"blob_sha":"5cac2a5ddac4c2421e5db2a9093b91c63b2c8413","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Application/Common/Behaviours/ValidationBehaviour.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Application/Common/Behaviours/ValidationBehaviour.cs","start_line":1,"end_line":34,"score":0.01639344262295082,"lexical":33.21827002862992,"dense":0,"text":"using ValidationException = CleanArchitecture.Application.Common.Exceptions.ValidationException;\n\nnamespace CleanArchitecture.Application.Common.Behaviours;\n\npublic class ValidationBehaviour\u003cTRequest, TResponse\u003e : IPipelineBehavior\u003cTRequest, TResponse\u003e\n    where TRequest : notnull\n{\n    private readonly IEnumerable\u003cIValidator\u003cTRequest\u003e\u003e _validators;\n\n    public ValidationBehaviour(IEnumerable\u003cIValidator\u003cTRequest\u003e\u003e validators)\n    {\n        _validators = validators;\n    }\n\n    public async Task\u003cTResponse\u003e Handle(TRequest request, RequestHandlerDelegate\u003cTResponse\u003e next, CancellationToken cancellationToken)\n    {\n        if (_validators.Any())\n        {\n            var validationResults = await Task.WhenAll(\n                _validators.Select(v =\u003e\n                    v.ValidateAsync(new ValidationContext\u003cTRequest\u003e(request), cancellationToken)));\n\n            var failures = validationResults\n                .Where(r =\u003e r.Errors.Any())\n                .SelectMany(r =\u003e r.Errors)\n                .ToList();\n\n            if (failures.Count != 0)\n                throw new ValidationException(failures);\n        }\n\n        return await next();\n    }\n}\n","clipped":false},{"blob":193,"blob_sha":"180ad2a805d416e0b10a910c194aec89deda3c06","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Web/Infrastructure/ProblemDetailsExceptionHandler.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Web/Infrastructure/ProblemDetailsExceptionHandler.cs","start_line":1,"end_line":52,"score":0.016129032258064516,"lexical":26.30871705563677,"dense":0,"text":"using CleanArchitecture.Application.Common.Exceptions;\nusing Microsoft.AspNetCore.Diagnostics;\nusing Microsoft.AspNetCore.Mvc;\n\nnamespace CleanArchitecture.Web.Infrastructure;\n\n/// \u003csummary\u003e\n/// Converts well-known application exceptions into RFC 9110-compliant \u003csee cref=\"ProblemDetails\"/\u003e responses,\n/// mapping \u003csee cref=\"ValidationException\"/\u003e → 400, \u003csee cref=\"NotFoundException\"/\u003e → 404,\n/// \u003csee cref=\"UnauthorizedAccessException\"/\u003e → 401, and \u003csee cref=\"ForbiddenAccessException\"/\u003e → 403.\n/// Unrecognised exceptions are not handled and fall through to the default middleware.\n/// \u003c/summary\u003e\npublic class ProblemDetailsExceptionHandler : IExceptionHandler\n{\n    public async ValueTask\u003cbool\u003e TryHandleAsync(HttpContext httpContext, Exception exception, CancellationToken cancellationToken)\n    {\n        var (statusCode, problemDetails) = exception switch\n        {\n            ValidationException ve =\u003e (StatusCodes.Status400BadRequest, (ProblemDetails)new ValidationProblemDetails(ve.Errors)\n            {\n                Status = StatusCodes.Status400BadRequest,\n                Type = \"https://tools.ietf.org/html/rfc9110#section-15.5.1\"\n            }),\n            NotFoundException ne =\u003e (StatusCodes.Status404NotFound, new ProblemDetails\n            {\n                Status = StatusCodes.Status404NotFound,\n                Type = \"https://tools.ietf.org/html/rfc9110#section-15.5.5\",\n                Title = \"The specified resource was not found.\",\n                Detail = ne.Message\n            }),\n            UnauthorizedAccessException =\u003e (StatusCodes.Status401Unauthorized, new ProblemDetails\n            {\n                Status = StatusCodes.Status401Unauthorized,\n                Title = \"Unauthorized\",\n                Type = \"https://tools.ietf.org/html/rfc9110#section-15.5.2\"\n            }),\n            ForbiddenAccessException =\u003e (StatusCodes.Status403Forbidden, new ProblemDetails\n            {\n                Status = StatusCodes.Status403Forbidden,\n                Title = \"Forbidden\",\n                Type = \"https://tools.ietf.org/html/rfc9110#section-15.5.4\"\n            }),\n            _ =\u003e (-1, null)\n        };\n\n        if (problemDetails is null) return false;\n\n        httpContext.Response.StatusCode = statusCode;\n        await httpContext.Response.WriteAsJsonAsync(problemDetails, cancellationToken);\n        return true;\n    }\n}\n","clipped":false},{"blob":54,"blob_sha":"907087aec44ea75ab5cd5ece406f6d79ad5b1034","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Application/DependencyInjection.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Application/DependencyInjection.cs","start_line":9,"end_line":24,"score":0.015873015873015872,"lexical":19.956178776376245,"dense":0,"text":"    public static void AddApplicationServices(this IHostApplicationBuilder builder)\n    {\n        builder.Services.AddAutoMapper(cfg =\u003e \n            cfg.AddMaps(Assembly.GetExecutingAssembly()));\n\n        builder.Services.AddValidatorsFromAssembly(Assembly.GetExecutingAssembly());\n\n        builder.Services.AddMediatR(cfg =\u003e {\n            cfg.RegisterServicesFromAssembly(Assembly.GetExecutingAssembly());\n            cfg.AddOpenRequestPreProcessor(typeof(LoggingBehaviour\u003c\u003e));\n            cfg.AddOpenBehavior(typeof(UnhandledExceptionBehaviour\u003c,\u003e));\n            cfg.AddOpenBehavior(typeof(AuthorizationBehaviour\u003c,\u003e));\n            cfg.AddOpenBehavior(typeof(ValidationBehaviour\u003c,\u003e));\n            cfg.AddOpenBehavior(typeof(PerformanceBehaviour\u003c,\u003e));\n        });\n    }\n","clipped":false},{"blob":181,"blob_sha":"cbda534d085a443f30a3121b2542126db8a0d86d","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Web/DependencyInjection.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Web/DependencyInjection.cs","start_line":11,"end_line":37,"score":0.015625,"lexical":19.290647722205204,"dense":0,"text":"    public static void AddWebServices(this IHostApplicationBuilder builder)\n    {\n        builder.Services.AddDatabaseDeveloperPageExceptionFilter();\n\n        builder.Services.AddScoped\u003cIUser, CurrentUser\u003e();\n\n        builder.Services.AddHttpContextAccessor();\n\n        builder.Services.AddExceptionHandler\u003cProblemDetailsExceptionHandler\u003e();\n\n        // Customise default API behaviour\n        builder.Services.Configure\u003cApiBehaviorOptions\u003e(options =\u003e\n            options.SuppressModelStateInvalidFilter = true);\n\n        builder.Services.AddEndpointsApiExplorer();\n\n        builder.Services.AddOpenApi(options =\u003e\n        {\n            options.AddOperationTransformer\u003cApiExceptionOperationTransformer\u003e();\n            options.AddOperationTransformer\u003cIdentityApiOperationTransformer\u003e();\n#if (UseApiOnly)\n            options.AddDocumentTransformer\u003cBearerSecuritySchemeTransformer\u003e();\n#endif\n        });\n\n        builder.Services.AddCors();\n    }\n","clipped":false},{"blob":187,"blob_sha":"7755643f57479edda6db088aa1c638b4c14db7ab","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Web/Infrastructure/ApiExceptionOperationTransformer.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Web/Infrastructure/ApiExceptionOperationTransformer.cs","start_line":6,"end_line":31,"score":0.015384615384615385,"lexical":17.80299920210079,"dense":0,"text":"\n/// \u003csummary\u003e\n/// Adds standard error responses to every OpenAPI operation. A 400 Bad Request is added to all\n/// operations because every request passes through \u003cc\u003eValidationBehaviour\u003c/c\u003e in the MediatR\n/// pipeline. 401 Unauthorized and 403 Forbidden are added only to operations that carry\n/// \u003csee cref=\"IAuthorizeData\"/\u003e metadata.\n/// \u003c/summary\u003e\ninternal sealed class ApiExceptionOperationTransformer : IOpenApiOperationTransformer\n{\n    public Task TransformAsync(OpenApiOperation operation, OpenApiOperationTransformerContext context, CancellationToken cancellationToken)\n    {\n        operation.Responses ??= [];\n        operation.Responses.TryAdd(\"400\", new OpenApiResponse { Description = \"Bad Request\" });\n\n        var requiresAuth = context.Description.ActionDescriptor.EndpointMetadata\n            .Any(m =\u003e m is IAuthorizeData);\n\n        if (requiresAuth)\n        {\n            operation.Responses.TryAdd(\"401\", new OpenApiResponse { Description = \"Unauthorized\" });\n            operation.Responses.TryAdd(\"403\", new OpenApiResponse { Description = \"Forbidden\" });\n        }\n\n        return Task.CompletedTask;\n    }\n}\n","clipped":false},{"blob":54,"blob_sha":"907087aec44ea75ab5cd5ece406f6d79ad5b1034","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Application/DependencyInjection.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Application/DependencyInjection.cs","start_line":1,"end_line":5,"score":0.015873015873015872,"lexical":19.956178776376245,"dense":0,"text":"using System.Reflection;\nusing CleanArchitecture.Application.Common.Behaviours;\nusing Microsoft.Extensions.Hosting;\n\nnamespace Microsoft.Extensions.DependencyInjection;\n","clipped":false}]}}}