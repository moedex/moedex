rorMessage)\n            .ToDictionary(failureGroup =\u003e failureGroup.Key, failureGroup =\u003e failureGroup.ToArray());\n    }\n\n    public IDictionary\u003cstring, string[]\u003e Errors { get; }\n}"}}}