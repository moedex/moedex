{"jsonrpc":"2.0","id":8,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308","blob_shas":["cbda534d085a443f30a3121b2542126db8a0d86d"]}},"content":[{"type":"text","text":"--- src/Web/DependencyInjection.cs:1-37 (repo CleanArchitecture) ---\n1 | using Azure.Identity;\n2 | using CleanArchitecture.Application.Common.Interfaces;\n3 | using CleanArchitecture.Infrastructure.Data;\n4 | using CleanArchitecture.Web.Services;\n5 | using Microsoft.AspNetCore.Mvc;\n6 | \n7 | namespace Microsoft.Extensions.DependencyInjection;\n8 | \n9 | public static class DependencyInjection\n10 | {\n11 |     public static void AddWebServices(this IHostApplicationBuilder builder)\n12 |     {\n13 |         builder.Services.AddDatabaseDeveloperPageExceptionFilter();\n14 | \n15 |         builder.Services.AddScoped\u003cIUser, CurrentUser\u003e();\n16 | \n17 |         builder.Services.AddHttpContextAccessor();\n18 | \n19 |         builder.Services.AddExceptionHandler\u003cProblemDetailsExceptionHandler\u003e();\n20 | \n21 |         // Customise default API behaviour\n22 |         builder.Services.Configure\u003cApiBehaviorOptions\u003e(options =\u003e\n23 |             options.SuppressModelStateInvalidFilter = true);\n24 | \n25 |         builder.Services.AddEndpointsApiExplorer();\n26 | \n27 |         builder.Services.AddOpenApi(options =\u003e\n28 |         {\n29 |             options.AddOperationTransformer\u003cApiExceptionOperationTransformer\u003e();\n30 |             options.AddOperationTransformer\u003cIdentityApiOperationTransformer\u003e();\n31 | #if (UseApiOnly)\n32 |             options.AddDocumentTransformer\u003cBearerSecuritySchemeTransformer\u003e();\n33 | #endif\n34 |         });\n35 | \n36 |         builder.Services.AddCors();\n37 |     }\n"}],"structuredContent":{"repo":"CleanArchitecture","path":"src/Web/DependencyInjection.cs","blob_sha":"cbda534d085a443f30a3121b2542126db8a0d86d","lines":50,"start_line":1,"end_line":37,"truncated":true,"content":"using Azure.Identity;\nusing CleanArchitecture.Application.Common.Interfaces;\nusing CleanArchitecture.Infrastructure.Data;\nusing CleanArchitecture.Web.Services;\nusing Microsoft.AspNetCore.Mvc;\n\nnamespace Microsoft.Extensions.DependencyInjection;\n\npublic static class DependencyInjection\n{\n    public static void AddWebServices(this IHostApplicationBuilder builder)\n    {\n        builder.Services.AddDatabaseDeveloperPageExceptionFilter();\n\n        builder.Services.AddScoped\u003cIUser, CurrentUser\u003e();\n\n        builder.Services.AddHttpContextAccessor();\n\n        builder.Services.AddExceptionHandler\u003cProblemDetailsExceptionHandler\u003e();\n\n        // Customise default API behaviour\n        builder.Services.Configure\u003cApiBehaviorOptions\u003e(options =\u003e\n            options.SuppressModelStateInvalidFilter = true);\n\n        builder.Services.AddEndpointsApiExplorer();\n\n        builder.Services.AddOpenApi(options =\u003e\n        {\n            options.AddOperationTransformer\u003cApiExceptionOperationTransformer\u003e();\n            options.AddOperationTransformer\u003cIdentityApiOperationTransformer\u003e();\n#if (UseApiOnly)\n            options.AddDocumentTransformer\u003cBearerSecuritySchemeTransformer\u003e();\n#endif\n        });\n\n        builder.Services.AddCors();\n    }"}}}