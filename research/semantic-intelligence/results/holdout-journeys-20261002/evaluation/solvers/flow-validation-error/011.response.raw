s.AddMediatR(cfg =\u003e {\n17 |             cfg.RegisterServicesFromAssembly(Assembly.GetExecutingAssembly());\n18 |             cfg.AddOpenRequestPreProcessor(typeof(LoggingBehaviour\u003c\u003e));\n19 |             cfg.AddOpenBehavior(typeof(UnhandledExceptionBehaviour\u003c,\u003e));\n20 |             cfg.AddOpenBehavior(typeof(AuthorizationBehaviour\u003c,\u003e));\n21 |             cfg.AddOpenBehavior(typeof(ValidationBehaviour\u003c,\u003e));\n22 |             cfg.AddOpenBehavior(typeof(PerformanceBehaviour\u003c,\u003e));\n23 |         });\n24 |     }\n\n--- src/Application/DependencyInjection.cs:1-5 (score 0.0161) ---\n1 | using System.Reflection;\n2 | using CleanArchitecture.Application.Common.Behaviours;\n3 | using Microsoft.Extensions.Hosting;\n4 | \n5 | namespace Microsoft.Extensions.DependencyInjection;\n"}],"structuredContent":{"summary":{"scope":{"repo":"CleanArchitecture"},"blocks":3,"token_estimate":451,"truncated":false,"clipped":false},"blocks":[{"blob":44,"blob_sha":"bf427644a961448156ea61f708d3f963143dd026","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Application/Common/Behaviours/UnhandledExceptionBehaviour.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Application/Common/Behaviours/UnhandledExceptionBehaviour.cs","start_line":1,"end_line":30,"score":0.04918032786885246,"lexical":43.85272440720167,"dense":0,"text":"using Microsoft.Extensions.Logging;\n\nnamespace CleanArchitecture.Application.Common.Behaviours;\n\npublic class UnhandledExceptionBehaviour\u003cTRequest, TResponse\u003e : IPipelineBehavior\u003cTRequest, TResponse\u003e\n    where TRequest : notnull\n{\n    private readonly ILogger\u003cTRequest\u003e _logger;\n\n    public UnhandledExceptionBehaviour(ILogger\u003cTRequest\u003e logger)\n    {\n        _logger = logger;\n    }\n\n    public async Task\u003cTResponse\u003e Handle(TRequest request, RequestHandlerDelegate\u003cTResponse\u003e next, CancellationToken cancellationToken)\n    {\n        try\n        {\n            return await next();\n        }\n        catch (Exception ex)\n        {\n            var requestName = typeof(TRequest).Name;\n\n            _logger.LogError(ex, \"CleanArchitecture Request: Unhandled Exception for Request {Name} {@Request}\", requestName, request);\n\n            throw;\n        }\n    }\n}\n","clipped":false},{"blob":54,"blob_sha":"907087aec44ea75ab5cd5ece406f6d79ad5b1034","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Application/DependencyInjection.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Application/DependencyInjection.cs","start_line":9,"end_line":24,"score":0.016129032258064516,"lexical":37.01380835450182,"dense":0,"text":"    public static void AddApplicationServices(this IHostApplicationBuilder builder)\n    {\n        builder.Services.AddAutoMapper(cfg =\u003e \n            cfg.AddMaps(Assembly.GetExecutingAssembly()));\n\n        builder.Services.AddValidatorsFromAssembly(Assembly.GetExecutingAssembly());\n\n        builder.Services.AddMediatR(cfg =\u003e {\n            cfg.RegisterServicesFromAssembly(Assembly.GetExecutingAssembly());\n            cfg.AddOpenRequestPreProcessor(typeof(LoggingBehaviour\u003c\u003e));\n            cfg.AddOpenBehavior(typeof(UnhandledExceptionBehaviour\u003c,\u003e));\n            cfg.AddOpenBehavior(typeof(AuthorizationBehaviour\u003c,\u003e));\n            cfg.AddOpenBehavior(typeof(ValidationBehaviour\u003c,\u003e));\n            cfg.AddOpenBehavior(typeof(PerformanceBehaviour\u003c,\u003e));\n        });\n    }\n","clipped":false},{"blob":54,"blob_sha":"907087aec44ea75ab5cd5ece406f6d79ad5b1034","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Application/DependencyInjection.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Application/DependencyInjection.cs","start_line":1,"end_line":5,"score":0.016129032258064516,"lexical":37.01380835450182,"dense":0,"text":"using System.Reflection;\nusing CleanArchitecture.Application.Common.Behaviours;\nusing Microsoft.Extensions.Hosting;\n\nnamespace Microsoft.Extensions.DependencyInjection;\n","clipped":false}]}}}