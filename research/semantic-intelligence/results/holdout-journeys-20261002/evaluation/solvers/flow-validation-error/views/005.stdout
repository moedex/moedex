ync(new ValidationContext<TRequest>(request), cancellationToken)));\\n22 | \\n23 |             var failures = validationResults\\n24 |                 .Where(r => r.Errors.Any())\\n25 |                 .SelectMany(r => r.Errors)\\n26 |                 .ToList();\\n27 | \\n28 |             if (failures.Count != 0)\\n29 |                 throw new ValidationException(failures);\\n30 |         }\\n31 | \\n32 |         return await next();\\n33 |     }\\n34 | }\\n\\n--- src/Web/Infrastructure/ProblemDetailsExceptionHandler.cs:1-52 (score 0.0161) ---\\n1 | using CleanArchitecture.Application.Common.Exceptions;\\n2 | using Microsoft.AspNetCore.Diagnostics;\\n3 | using Microsoft.AspNetCore.Mvc;\\n4 | \\n5 | namespace CleanArchitecture.Web.Infrastructure;\\n6 | \\n7 | /// <summary>\\n8 | /// Converts well-known application exceptions into RFC 9110-compliant <see cref=\\\"ProblemDetails\\\"/> responses,\\n9 | /// mapping <see cref=\\\"ValidationException\\\"/> \\u2192 400, <see cref=\\\"NotFoundException\\\"/> \\u2192 404,\\n10 | /// <see cref=\\\"UnauthorizedAccessException\\\"/> \\u2192 401, and <see cref=\\\"ForbiddenAccessException\\\"/> \\u2192 403.\\n11 | /// Unrecognised exceptions are not handled and fall through to the default middleware.\\n12 | /// </summary>\\n13 | public class ProblemDetailsExceptionHandler : IExceptionHandler\\n14 | {\\n15 |     public async ValueTask<bool> TryHandleAsync(HttpContext httpContext, Exception exception, CancellationToken cancellationToken)\\n16 |     {\\n17 |         var (statusCode, problemDetails) = exception switch\\n18 |         {\\n19 |             ValidationException ve => (StatusCodes.Status400BadRequest, (ProblemDetails)new ValidationProblemDetails(ve.Errors)\\n20 |             {\\n21 |                 Status = StatusCodes.Status400BadRequest,\\n22 |                 Type = \\\"https://tools.ietf.org/html/rfc9110#section-15.5.1\\\"\\n23 |             }),\\n24 |             NotFoundException ne => (StatusCodes.Status404NotFound, new ProblemDetails\\n25 |             {\\n26 |                 Status = StatusCodes.Status404NotFound,\\n27 |                 Type = \\\"https://tools.ietf.org/html/rfc9110#section-15.5.5\\\",\\n28 |                 Title = \\\"The specified resource was not found.\\\",\\n29 |                 Detail = ne.Message\\n30 |             }),\\n31 |             UnauthorizedAccessException => (StatusCodes.Status401Unauthorized, new ProblemDetails\\n32 |             {\\n33 |                 Status = StatusCodes.Status401Unauthorized,\\n34 |                 Title = \\\"Unauthorized\\\",\\n35 |                 Type = \\\"https://tools.ietf.org/html/rfc9110#section-15.5.2\\\"\\n36 |             }),\\n37 |             ForbiddenAccessException => (StatusCodes.Status403Forbidden, new ProblemDetails\\n38 |             {\\n39 |                 Status = StatusCodes.Status403Forbidden,\\n40 |                 Title = \\\"Forbidden\\\",\\n41 |                 Type = \\\"https://tools.ietf.org/html/rfc9110#section-15.5.4\\\"\\n42 |             }),\\n43 |             _ => (-1, null)\\n44 |         };\\n45 | \\n46 |         if (problemDetails is null) return false;\\n47 | \\n48 |         httpContext.Response.StatusCode = statusCode;\\n49 |         await httpContext.Response.WriteAsJsonAsync(problemDetails, cancellationToken);\\n50 |         return true;\\n51 |     }\\n52 | }\\n\\n--- src/Application/DependencyInjection.cs:9-24 (score 0.0159) ---\\n9 |     public static void AddApplicationServices(this IHostApplicationBuilder builder)\\n10 |     {\\n11 |         builder.Services.AddAutoMapper(cfg => \\n12 |             cfg.AddMaps(Assembly.GetExecutingAssembly()));\\n13 | \\n14 |         builder.Services.AddValidatorsFromAssembly(Assembly.GetExecutingAssembly());\\n15 | \\n16 |         builder.Services.AddMediatR(cfg => {\\n17 |             cfg.RegisterServicesFromAssembly(Assembly.GetExecutingAssembly());\\n18 |             cfg.AddOpenRequestPreProcessor(typeof(LoggingBehaviour<>));\\n19 |             cfg.AddOpenBehavior(typeof(UnhandledExceptionBehaviour<,>));\\n20 |             cfg.AddOpenBehavior(typeof(AuthorizationBehaviour<,>));\\n21 |             cfg.AddOpenBehavior(typeof(ValidationBehaviour<,>));\\n22 |             cfg.AddOpenBehavior(typeof(PerformanceBehaviour<,>));\\n23 |         });\\n24 |     }\\n\\n--- src/Web/DependencyInjection.cs:11-37 (score 0.0156) ---\\n11 |     public static void AddWebServices(this IHostApplicationBuilder builder)\\n12 |     {\\n13 |         builder.Services.AddDatabaseDeveloperPageExceptionFilter();\\n14 | \\n15 |         builder.Services.AddScoped<IUser, CurrentUser>();\\n16 | \\n17 |         builder.Services.AddHttpContextAccessor();\\n18 | \\n19 |         builder.Services.AddExceptionHandler<ProblemDetailsExceptionHandler>();\\n20 | \\n21 |         // Customise default API behaviour\\n22 |         builder.Services.Configure<ApiBehaviorOptions>(options =>\\n23 |             options.SuppressModelStateInvalidFilter = true);\\n24 | \\n25 |         builder.Services.AddEndpointsApiExplorer();\\n26 | \\n27 |         builder.Services.AddOpenApi(options =>\\n28 |         {\\n29 |             options.AddOperationTransformer<ApiExceptionOperationTransformer>();\\n30 |             options.AddOperationTransformer<IdentityApiOperationTransformer>();\\n31 | #if (UseApiOnly)\\n32 |             options.AddDocumentTransformer<BearerSecuritySchemeTransformer>();\\n33 | #endif\\n34 |         });\\n35 | \\n36 |         builder.Services.AddCors();\\n37 |     }\\n\\n--- src/Web/Infrastructure/ApiExceptionOperationTransformer.cs:6-31 (score 0.0154) ---\\n6 | \\n7 | /// <summary>\\n8 | /// Adds standard error responses to every OpenAPI operation. A 400 Bad Request is added to all\\n9 | /// operations because every request passes through <c>ValidationBehaviour</c> in the MediatR\\n10 | /// pipeline. 401 Unauthorized and 403 Forbidden are added only to operations that carry\\n11 | /// <see cref=\\\"IAuthorizeData\\\"/> metadata.\\n12 | /// </summary>\\n13 | internal sealed class ApiExceptionOperationTransformer : IOpenApiOperationTransformer\\n14 | {\\n15 |     public Task Transform","next_offset":7480,"partial":true}
