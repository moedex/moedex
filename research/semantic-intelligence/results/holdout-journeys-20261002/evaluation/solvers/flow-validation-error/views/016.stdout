{"view_version":1,"raw_sha256":"0917876b364fb54b76ef239b3f9a6259a74ff98d29b8d719cc7c4ebb4e975478","raw_bytes":1769,"pointer":"","offset":0,"total_characters":1729,"encoding":"concatenate data then JSON-decode","scope":"selected value only; other fields remain in raw response","context":{"ordinal":12,"calls_used":12,"response_bytes_used":68093,"response_complete":true,"http_status":200,"error":null,"stopped":null},"data":"{\"jsonrpc\":\"2.0\",\"id\":12,\"result\":{\"_meta\":{\"dev.moedex/server\":{\"version\":\"dev+unknown\"},\"dev.moedex/snapshot\":{\"cacheable\":true,\"corpus_fingerprint\":\"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308\",\"blob_shas\":[\"bf427644a961448156ea61f708d3f963143dd026\"]}},\"content\":[{\"type\":\"text\",\"text\":\"--- src/Application/Common/Behaviours/UnhandledExceptionBehaviour.cs:15-30 (repo CleanArchitecture) ---\\n15 |     public async Task<TResponse> Handle(TRequest request, RequestHandlerDelegate<TResponse> next, CancellationToken cancellationToken)\\n16 |     {\\n17 |         try\\n18 |         {\\n19 |             return await next();\\n20 |         }\\n21 |         catch (Exception ex)\\n22 |         {\\n23 |             var requestName = typeof(TRequest).Name;\\n24 | \\n25 |             _logger.LogError(ex, \\\"CleanArchitecture Request: Unhandled Exception for Request {Name} {@Request}\\\", requestName, request);\\n26 | \\n27 |             throw;\\n28 |         }\\n29 |     }\\n30 | }\\n\"}],\"structuredContent\":{\"repo\":\"CleanArchitecture\",\"path\":\"src/Application/Common/Behaviours/UnhandledExceptionBehaviour.cs\",\"blob_sha\":\"bf427644a961448156ea61f708d3f963143dd026\",\"lines\":31,\"start_line\":15,\"end_line\":30,\"truncated\":true,\"content\":\"    public async Task<TResponse> Handle(TRequest request, RequestHandlerDelegate<TResponse> next, CancellationToken cancellationToken)\\n    {\\n        try\\n        {\\n            return await next();\\n        }\\n        catch (Exception ex)\\n        {\\n            var requestName = typeof(TRequest).Name;\\n\\n            _logger.LogError(ex, \\\"CleanArchitecture Request: Unhandled Exception for Request {Name} {@Request}\\\", requestName, request);\\n\\n            throw;\\n        }\\n    }\\n}\"}}}","next_offset":null,"partial":false}
