celNewItem(): void {\n196 |     this.addingItem.set(false);\n197 |     this.newItemTitle = '';\n198 |   }\n199 | \n200 |   commitNewItem(): void {\n201 |     this.addingItem.set(false);\n202 |     if (!this.newItemTitle.trim()) {\n203 |       this.newItemTitle = '';\n204 |       return;\n205 |     }\n206 |     const listId = this.selectedListId()!;\n207 |     const title = this.newItemTitle.trim();\n208 |     this.itemsClient.createTodoItem({ title, listId } as CreateTodoItemCommand).subscribe({\n209 |       next: result =\u003e {\n210 |         this.lists.update(ls =\u003e ls.map(l =\u003e l.id === listId\n211 |           ? { ...l, items: [...l.items, { id: result, listId, title, done: false, priority: this.priorityLevels()[0].id } as TodoItemDto] } as TodoListDto\n212 |           : l\n213 |         ));\n214 |         this.newItemTitle = '';\n215 |       },\n216 |       error: error =\u003e console.error(error)\n217 |     });\n218 |   }\n219 | \n220 |   editItem(item: TodoItemDto, inputId: string): void {\n221 |     this.originalTitle = item.title;\n222 |     this.editingItem.set(item);\n223 |     setTimeout(() =\u003e document.getElementById(inputId)?.focus(), 100);\n224 |   }\n225 | \n226 |   cancelEdit(): void {\n227 |     if (this.editingItem()) {\n228 |       this.editingItem()!.title = this.originalTitle;\n229 |     }\n230 |     this.editingItem.set(null);\n231 |   }\n232 | \n233 |   updateItem(item: TodoItemDto): void {\n234 |     if (!item.title.trim()) {\n235 |       this.deleteItem(item);\n236 |       return;\n237 |     }\n238 | \n239 |     if (item.id === 0) {\n240 |       const listId = this.selectedListId()!;\n241 |       this.itemsClient\n242 |         .createTodoItem({ title: item.title, listId } as CreateTodoItemCommand)\n243 |         .subscribe({\n244 |           next: result =\u003e {\n245 |             this.lists.update(ls =\u003e ls.map(l =\u003e l.id === listId\n246 |               ? { ...l, items: l.items.map(i =\u003e i === item ? { ...i, id