{"jsonrpc":"2.0","id":5,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308","blob_shas":["9f25fc0c4cf5e02703e071f7b94ff9c852cd2a54"]}},"content":[{"type":"text","text":"read_source: src/Infrastructure/Data/Interceptors/DispatchDomainEventsInterceptor.cs:1-51 (repo CleanArchitecture); truncated=false; source in structuredContent.content"}],"structuredContent":{"repo":"CleanArchitecture","path":"src/Infrastructure/Data/Interceptors/DispatchDomainEventsInterceptor.cs","blob_sha":"9f25fc0c4cf5e02703e071f7b94ff9c852cd2a54","lines":51,"start_line":1,"end_line":51,"truncated":false,"content":"using CleanArchitecture.Domain.Common;\nusing MediatR;\nusing Microsoft.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore.Diagnostics;\n\nnamespace CleanArchitecture.Infrastructure.Data.Interceptors;\n\npublic class DispatchDomainEventsInterceptor : SaveChangesInterceptor\n{\n    private readonly IMediator _mediator;\n\n    public DispatchDomainEventsInterceptor(IMediator mediator)\n    {\n        _mediator = mediator;\n    }\n\n    public override InterceptionResult\u003cint\u003e SavingChanges(DbContextEventData eventData, InterceptionResult\u003cint\u003e result)\n    {\n        DispatchDomainEvents(eventData.Context).GetAwaiter().GetResult();\n\n        return base.SavingChanges(eventData, result);\n\n    }\n\n    public override async ValueTask\u003cInterceptionResult\u003cint\u003e\u003e SavingChangesAsync(DbContextEventData eventData, InterceptionResult\u003cint\u003e result, CancellationToken cancellationToken = default)\n    {\n        await DispatchDomainEvents(eventData.Context);\n\n        return await base.SavingChangesAsync(eventData, result, cancellationToken);\n    }\n\n    public async Task DispatchDomainEvents(DbContext? context)\n    {\n        if (context == null) return;\n\n        var entities = context.ChangeTracker\n            .Entries\u003cBaseEntity\u003e()\n            .Where(e =\u003e e.Entity.DomainEvents.Any())\n            .Select(e =\u003e e.Entity);\n\n        var domainEvents = entities\n            .SelectMany(e =\u003e e.DomainEvents)\n            .ToList();\n\n        entities.ToList().ForEach(e =\u003e e.ClearDomainEvents());\n\n        foreach (var domainEvent in domainEvents)\n            await _mediator.Publish(domainEvent);\n    }\n}\n"}}}