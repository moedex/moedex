n    private readonly ILogger\u003cLogTodoItemCompleted\u003e _logger;\n\n    public LogTodoItemCompleted(ILogger\u003cLogTodoItemCompleted\u003e logger)\n    {\n        _logger = logger;\n    }\n\n    public Task Handle(TodoItemCompletedEvent notification, CancellationToken cancellationToken)\n    {\n        _logger.LogInformation(\"CleanArchitecture Domain Event: {DomainEvent}\", notification.GetType().Name);\n\n        return Task.CompletedTask;\n    }\n}\n","clipped":false},{"blob":80,"blob_sha":"c9ebe7af1b496ebe4faeda4bcd80120d74269587","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Domain/Entities/TodoItem.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Domain/Entities/TodoItem.cs","start_line":1,"end_line":29,"score":0.015873015873015872,"lexical":54.996293451630336,"dense":0,"text":"namespace CleanArchitecture.Domain.Entities;\n\npublic class TodoItem : BaseAuditableEntity\n{\n    public int ListId { get; set; }\n\n    public string? Title { get; set; }\n\n    public string? Note { get; set; }\n\n    public PriorityLevel Priority { get; set; }\n\n    private bool _done;\n    public bool Done\n    {\n        get =\u003e _done;\n        set\n        {\n            if (value \u0026\u0026 !_done)\n            {\n                AddDomainEvent(new TodoItemCompletedEvent(this));\n            }\n\n            _done = value;\n        }\n    }\n\n    public TodoList List { get; set; } = null!;\n}\n","clipped":false}]}}}