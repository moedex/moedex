{"jsonrpc":"2.0","id":10,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308","blob_shas":["bde8a687bada78ad8335a70d11de80b8f22bb74f"]}},"content":[{"type":"text","text":"--- src/Web/Endpoints/TodoItems.cs:11-40 (repo CleanArchitecture) ---\n11 |     public static void Map(RouteGroupBuilder groupBuilder)\n12 |     {\n13 |         groupBuilder.RequireAuthorization();\n14 | \n15 |         groupBuilder.MapPost(CreateTodoItem);\n16 |         groupBuilder.MapPut(UpdateTodoItem, \"{id}\");\n17 |         groupBuilder.MapPatch(UpdateTodoItemDetail, \"UpdateDetail/{id}\");\n18 |         groupBuilder.MapDelete(DeleteTodoItem, \"{id}\");\n19 |     }\n20 | \n21 |     [EndpointSummary(\"Create a new Todo Item\")]\n22 |     [EndpointDescription(\"Creates a new todo item using the provided details and returns the ID of the created item.\")]\n23 |     public static async Task\u003cCreated\u003cint\u003e\u003e CreateTodoItem(ISender sender, CreateTodoItemCommand command)\n24 |     {\n25 |         var id = await sender.Send(command);\n26 | \n27 |         return TypedResults.Created($\"/{nameof(TodoItems)}/{id}\", id);\n28 |     }\n29 | \n30 |     [EndpointSummary(\"Update a Todo Item\")]\n31 |     [EndpointDescription(\"Updates the specified todo item. The ID in the URL must match the ID in the payload.\")]\n32 |     public static async Task\u003cResults\u003cNoContent, BadRequest\u003e\u003e UpdateTodoItem(ISender sender, int id, UpdateTodoItemCommand command)\n33 |     {\n34 |         if (id != command.Id)\n35 |             return TypedResults.BadRequest();\n36 | \n37 |         await sender.Send(command);\n38 | \n39 |         return TypedResults.NoContent();\n40 |     }\n"}],"structuredContent":{"repo":"CleanArchitecture","path":"src/Web/Endpoints/TodoItems.cs","blob_sha":"bde8a687bada78ad8335a70d11de80b8f22bb74f","lines":62,"start_line":11,"end_line":40,"truncated":true,"content":"    public static void Map(RouteGroupBuilder groupBuilder)\n    {\n        groupBuilder.RequireAuthorization();\n\n        groupBuilder.MapPost(CreateTodoItem);\n        groupBuilder.MapPut(UpdateTodoItem, \"{id}\");\n        groupBuilder.MapPatch(UpdateTodoItemDetail, \"UpdateDetail/{id}\");\n        groupBuilder.MapDelete(DeleteTodoItem, \"{id}\");\n    }\n\n    [EndpointSummary(\"Create a new Todo Item\")]\n    [EndpointDescription(\"Creates a new todo item using the provided details and returns the ID of the created item.\")]\n    public static async Task\u003cCreated\u003cint\u003e\u003e CreateTodoItem(ISender sender, CreateTodoItemCommand command)\n    {\n        var id = await sender.Send(command);\n\n        return TypedResults.Created($\"/{nameof(TodoItems)}/{id}\", id);\n    }\n\n    [EndpointSummary(\"Update a Todo Item\")]\n    [EndpointDescription(\"Updates the specified todo item. The ID in the URL must match the ID in the payload.\")]\n    public static async Task\u003cResults\u003cNoContent, BadRequest\u003e\u003e UpdateTodoItem(ISender sender, int id, UpdateTodoItemCommand command)\n    {\n        if (id != command.Id)\n            return TypedResults.BadRequest();\n\n        await sender.Send(command);\n\n        return TypedResults.NoContent();\n    }"}}}