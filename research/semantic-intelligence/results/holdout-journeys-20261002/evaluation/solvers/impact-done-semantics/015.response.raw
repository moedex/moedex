{"jsonrpc":"2.0","id":15,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308","blob_shas":["4ee060305cfc14fdd5f7e1c82ab6f52c6f888f3e"]}},"content":[{"type":"text","text":"--- src/Web/Infrastructure/WebApplicationExtensions.cs:1-30 (repo CleanArchitecture) ---\n1 | using System.Reflection;\n2 | \n3 | namespace CleanArchitecture.Web.Infrastructure;\n4 | \n5 | public static class WebApplicationExtensions\n6 | {\n7 |     /// \u003csummary\u003e\n8 |     /// Discovers all \u003csee cref=\"IEndpointGroup\"/\u003e implementations in \u003cparamref name=\"assembly\"/\u003e\n9 |     /// and registers each as a route group with a matching OpenAPI tag. The route prefix defaults\n10 |     /// to \u003cc\u003e/api/{ClassName}\u003c/c\u003e but can be overridden via \u003csee cref=\"IEndpointGroup.RoutePrefix\"/\u003e.\n11 |     /// \u003c/summary\u003e\n12 |     public static WebApplication MapEndpoints(this WebApplication app, Assembly assembly)\n13 |     {\n14 |         var endpointGroupTypes = assembly.GetExportedTypes()\n15 |             .Where(t =\u003e t is { IsAbstract: false, IsInterface: false }\n16 |                      \u0026\u0026 t.IsAssignableTo(typeof(IEndpointGroup)));\n17 | \n18 |         foreach (var type in endpointGroupTypes)\n19 |         {\n20 |             var groupName = type.Name;\n21 |             var routePrefix = type.GetProperty(nameof(IEndpointGroup.RoutePrefix))\n22 |                 ?.GetValue(null) as string ?? $\"/api/{groupName}\";\n23 |             var group = app.MapGroup(routePrefix).WithTags(groupName);\n24 |             type.GetMethod(nameof(IEndpointGroup.Map))!.Invoke(null, [group]);\n25 |         }\n26 | \n27 |         return app;\n28 |     }\n29 | }\n30 | \n"}],"structuredContent":{"repo":"CleanArchitecture","path":"src/Web/Infrastructure/WebApplicationExtensions.cs","blob_sha":"4ee060305cfc14fdd5f7e1c82ab6f52c6f888f3e","lines":30,"start_line":1,"end_line":30,"truncated":false,"content":"using System.Reflection;\n\nnamespace CleanArchitecture.Web.Infrastructure;\n\npublic static class WebApplicationExtensions\n{\n    /// \u003csummary\u003e\n    /// Discovers all \u003csee cref=\"IEndpointGroup\"/\u003e implementations in \u003cparamref name=\"assembly\"/\u003e\n    /// and registers each as a route group with a matching OpenAPI tag. The route prefix defaults\n    /// to \u003cc\u003e/api/{ClassName}\u003c/c\u003e but can be overridden via \u003csee cref=\"IEndpointGroup.RoutePrefix\"/\u003e.\n    /// \u003c/summary\u003e\n    public static WebApplication MapEndpoints(this WebApplication app, Assembly assembly)\n    {\n        var endpointGroupTypes = assembly.GetExportedTypes()\n            .Where(t =\u003e t is { IsAbstract: false, IsInterface: false }\n                     \u0026\u0026 t.IsAssignableTo(typeof(IEndpointGroup)));\n\n        foreach (var type in endpointGroupTypes)\n        {\n            var groupName = type.Name;\n            var routePrefix = type.GetProperty(nameof(IEndpointGroup.RoutePrefix))\n                ?.GetValue(null) as string ?? $\"/api/{groupName}\";\n            var group = app.MapGroup(routePrefix).WithTags(groupName);\n            type.GetMethod(nameof(IEndpointGroup.Map))!.Invoke(null, [group]);\n        }\n\n        return app;\n    }\n}\n"}}}