{"view_version":1,"raw_sha256":"61b46a10b497bfb1588b7fb3264a3d0217a89ac6f3b54904d960df576c0947ac","raw_bytes":2452,"pointer":"","offset":0,"total_characters":2372,"encoding":"concatenate data then JSON-decode","scope":"selected value only; other fields remain in raw response","context":{"ordinal":5,"calls_used":5,"response_bytes_used":75170,"response_complete":true,"http_status":200,"error":null,"stopped":null},"data":"{\"jsonrpc\":\"2.0\",\"id\":5,\"result\":{\"_meta\":{\"dev.moedex/server\":{\"version\":\"dev+unknown\"},\"dev.moedex/snapshot\":{\"cacheable\":true,\"corpus_fingerprint\":\"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308\",\"blob_shas\":[\"9f25fc0c4cf5e02703e071f7b94ff9c852cd2a54\"]}},\"content\":[{\"type\":\"text\",\"text\":\"read_source: src/Infrastructure/Data/Interceptors/DispatchDomainEventsInterceptor.cs:1-51 (repo CleanArchitecture); truncated=false; source in structuredContent.content\"}],\"structuredContent\":{\"repo\":\"CleanArchitecture\",\"path\":\"src/Infrastructure/Data/Interceptors/DispatchDomainEventsInterceptor.cs\",\"blob_sha\":\"9f25fc0c4cf5e02703e071f7b94ff9c852cd2a54\",\"lines\":51,\"start_line\":1,\"end_line\":51,\"truncated\":false,\"content\":\"using CleanArchitecture.Domain.Common;\\nusing MediatR;\\nusing Microsoft.EntityFrameworkCore;\\nusing Microsoft.EntityFrameworkCore.Diagnostics;\\n\\nnamespace CleanArchitecture.Infrastructure.Data.Interceptors;\\n\\npublic class DispatchDomainEventsInterceptor : SaveChangesInterceptor\\n{\\n    private readonly IMediator _mediator;\\n\\n    public DispatchDomainEventsInterceptor(IMediator mediator)\\n    {\\n        _mediator = mediator;\\n    }\\n\\n    public override InterceptionResult<int> SavingChanges(DbContextEventData eventData, InterceptionResult<int> result)\\n    {\\n        DispatchDomainEvents(eventData.Context).GetAwaiter().GetResult();\\n\\n        return base.SavingChanges(eventData, result);\\n\\n    }\\n\\n    public override async ValueTask<InterceptionResult<int>> SavingChangesAsync(DbContextEventData eventData, InterceptionResult<int> result, CancellationToken cancellationToken = default)\\n    {\\n        await DispatchDomainEvents(eventData.Context);\\n\\n        return await base.SavingChangesAsync(eventData, result, cancellationToken);\\n    }\\n\\n    public async Task DispatchDomainEvents(DbContext? context)\\n    {\\n        if (context == null) return;\\n\\n        var entities = context.ChangeTracker\\n            .Entries<BaseEntity>()\\n            .Where(e => e.Entity.DomainEvents.Any())\\n            .Select(e => e.Entity);\\n\\n        var domainEvents = entities\\n            .SelectMany(e => e.DomainEvents)\\n            .ToList();\\n\\n        entities.ToList().ForEach(e => e.ClearDomainEvents());\\n\\n        foreach (var domainEvent in domainEvents)\\n            await _mediator.Publish(domainEvent);\\n    }\\n}\\n\"}}}","next_offset":null,"partial":false}
