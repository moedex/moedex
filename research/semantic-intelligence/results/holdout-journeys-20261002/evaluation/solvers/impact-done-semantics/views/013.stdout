{"view_version":1,"raw_sha256":"29f00793dacaed195f49535ddda3037d7ba39b87ab88751d3475a5569c64eb61","raw_bytes":7706,"pointer":"","offset":0,"total_characters":7346,"encoding":"concatenate data then JSON-decode","scope":"selected value only; other fields remain in raw response","context":{"ordinal":7,"calls_used":7,"response_bytes_used":85453,"response_complete":true,"http_status":200,"error":null,"stopped":null},"data":"{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":{\"_meta\":{\"dev.moedex/server\":{\"version\":\"dev+unknown\"},\"dev.moedex/snapshot\":{\"cacheable\":true,\"corpus_fingerprint\":\"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308\",\"blob_shas\":[\"f361e454102210a35b9f9c4f1f8e74839cfcf5e2\"]}},\"content\":[{\"type\":\"text\",\"text\":\"--- src/Infrastructure/DependencyInjection.cs:1-80 (repo CleanArchitecture) ---\\n1 | using CleanArchitecture.Application.Common.Interfaces;\\n2 | using CleanArchitecture.Infrastructure.Data;\\n3 | using CleanArchitecture.Infrastructure.Data.Interceptors;\\n4 | using CleanArchitecture.Infrastructure.Identity;\\n5 | using Microsoft.AspNetCore.Identity;\\n6 | using Microsoft.EntityFrameworkCore;\\n7 | using Microsoft.EntityFrameworkCore.Diagnostics;\\n8 | using Microsoft.Extensions.Configuration;\\n9 | using Microsoft.Extensions.Hosting;\\n10 | \\n11 | namespace Microsoft.Extensions.DependencyInjection;\\n12 | \\n13 | public static class DependencyInjection\\n14 | {\\n15 |     public static void AddInfrastructureServices(this IHostApplicationBuilder builder)\\n16 |     {\\n17 |         var connectionString = builder.Configuration.GetConnectionString(Services.Database);\\n18 |         Guard.Against.Null(connectionString, message: $\\\"Connection string '{Services.Database}' not found.\\\");\\n19 | \\n20 |         builder.Services.AddScoped<ISaveChangesInterceptor, AuditableEntityInterceptor>();\\n21 |         builder.Services.AddScoped<ISaveChangesInterceptor, DispatchDomainEventsInterceptor>();\\n22 | \\n23 |         builder.Services.AddDbContext<ApplicationDbContext>((sp, options) =>\\n24 |         {\\n25 |             options.AddInterceptors(sp.GetServices<ISaveChangesInterceptor>());\\n26 | #if (UsePostgreSQL)\\n27 |             options.UseNpgsql(connectionString);\\n28 | #elif (UseSqlServer)\\n29 |             options.UseSqlServer(connectionString);\\n30 | #else\\n31 |             options.UseSqlite(connectionString);\\n32 | #endif\\n33 |             options.ConfigureWarnings(warnings => warnings.Ignore(RelationalEventId.PendingModelChangesWarning));\\n34 |         });\\n35 | \\n36 | #if UsePostgreSQL\\n37 |         builder.EnrichNpgsqlDbContext<ApplicationDbContext>();\\n38 | #elif (UseSqlServer)\\n39 |         builder.EnrichSqlServerDbContext<ApplicationDbContext>();\\n40 | #endif\\n41 | \\n42 |         builder.Services.AddScoped<IApplicationDbContext>(provider => provider.GetRequiredService<ApplicationDbContext>());\\n43 | \\n44 |         builder.Services.AddScoped<ApplicationDbContextInitialiser>();\\n45 | \\n46 | #if (UseApiOnly)\\n47 |         builder.Services.AddAuthentication()\\n48 |             .AddBearerToken(IdentityConstants.BearerScheme);\\n49 | \\n50 |         builder.Services.AddAuthorizationBuilder();\\n51 | \\n52 |         builder.Services\\n53 |             .AddIdentityCore<ApplicationUser>()\\n54 |             .AddRoles<IdentityRole>()\\n55 |             .AddEntityFrameworkStores<ApplicationDbContext>()\\n56 |             .AddApiEndpoints();\\n57 | #else\\n58 |         builder.Services.AddAuthentication(options =>\\n59 |             {\\n60 |                 options.DefaultScheme = IdentityConstants.ApplicationScheme;\\n61 |                 options.DefaultSignInScheme = IdentityConstants.ExternalScheme;\\n62 |             })\\n63 |             .AddIdentityCookies();\\n64 | \\n65 |         builder.Services.AddAuthorizationBuilder();\\n66 | \\n67 |         builder.Services\\n68 |             .AddIdentityCore<ApplicationUser>()\\n69 |             .AddRoles<IdentityRole>()\\n70 |             .AddEntityFrameworkStores<ApplicationDbContext>()\\n71 |             .AddSignInManager()\\n72 |             .AddDefaultTokenProviders()\\n73 |             .AddApiEndpoints();\\n74 | #endif\\n75 | \\n76 |         builder.Services.AddSingleton(TimeProvider.System);\\n77 |         builder.Services.AddTransient<IIdentityService, IdentityService>();\\n78 |     }\\n79 | }\\n80 | \\n\"}],\"structuredContent\":{\"repo\":\"CleanArchitecture\",\"path\":\"src/Infrastructure/DependencyInjection.cs\",\"blob_sha\":\"f361e454102210a35b9f9c4f1f8e74839cfcf5e2\",\"lines\":80,\"start_line\":1,\"end_line\":80,\"truncated\":false,\"content\":\"using CleanArchitecture.Application.Common.Interfaces;\\r\\nusing CleanArchitecture.Infrastructure.Data;\\r\\nusing CleanArchitecture.Infrastructure.Data.Interceptors;\\r\\nusing CleanArchitecture.Infrastructure.Identity;\\r\\nusing Microsoft.AspNetCore.Identity;\\r\\nusing Microsoft.EntityFrameworkCore;\\r\\nusing Microsoft.EntityFrameworkCore.Diagnostics;\\r\\nusing Microsoft.Extensions.Configuration;\\r\\nusing Microsoft.Extensions.Hosting;\\r\\n\\r\\nnamespace Microsoft.Extensions.DependencyInjection;\\r\\n\\r\\npublic static class DependencyInjection\\r\\n{\\r\\n    public static void AddInfrastructureServices(this IHostApplicationBuilder builder)\\r\\n    {\\r\\n        var connectionString = builder.Configuration.GetConnectionString(Services.Database);\\r\\n        Guard.Against.Null(connectionString, message: $\\\"Connection string '{Services.Database}' not found.\\\");\\r\\n\\r\\n        builder.Services.AddScoped<ISaveChangesInterceptor, AuditableEntityInterceptor>();\\r\\n        builder.Services.AddScoped<ISaveChangesInterceptor, DispatchDomainEventsInterceptor>();\\r\\n\\r\\n        builder.Services.AddDbContext<ApplicationDbContext>((sp, options) =>\\r\\n        {\\r\\n            options.AddInterceptors(sp.GetServices<ISaveChangesInterceptor>());\\r\\n#if (UsePostgreSQL)\\r\\n            options.UseNpgsql(connectionString);\\r\\n#elif (UseSqlServer)\\r\\n            options.UseSqlServer(connectionString);\\r\\n#else\\r\\n            options.UseSqlite(connectionString);\\r\\n#endif\\r\\n            options.ConfigureWarnings(warnings => warnings.Ignore(RelationalEventId.PendingModelChangesWarning));\\r\\n        });\\r\\n\\r\\n#if UsePostgreSQL\\r\\n        builder.EnrichNpgsqlDbContext<ApplicationDbContext>();\\r\\n#elif (UseSqlServer)\\r\\n        builder.EnrichSqlServerDbContext<ApplicationDbContext>();\\r\\n#endif\\r\\n\\r\\n        builder.Services.AddScoped<IApplicationDbContext>(provider => provider.GetRequiredService<ApplicationDbContext>());\\r\\n\\r\\n        builder.Services.AddScoped<ApplicationDbContextInitialiser>();\\r\\n\\r\\n#if (UseApiOnly)\\r\\n        builder.Services.AddAuthentication()\\r\\n            .AddBearerToken(IdentityConstants.BearerScheme);\\r\\n\\r\\n        builder.Services.AddAuthorizationBuilder();\\r\\n\\r\\n        builder.Services\\r\\n            .AddIdentityCore<ApplicationUser>()\\r\\n            .AddRoles<IdentityRole>()\\r\\n            .AddEntityFrameworkStores<ApplicationDbContext>()\\r\\n            .AddApiEndpoints();\\r\\n#else\\r\\n        builder.Services.AddAuthentication(options =>\\r\\n            {\\r\\n                options.DefaultScheme = IdentityConstants.ApplicationScheme;\\r\\n                options.DefaultSignInScheme = IdentityConstants.ExternalScheme;\\r\\n            })\\r\\n            .AddIdentityCookies();\\r\\n\\r\\n        builder.Services.AddAuthorizationBuilder();\\r\\n\\r\\n        builder.Services\\r\\n            .AddIdentityCore<ApplicationUser>()\\r\\n            .AddRoles<IdentityRole>()\\r\\n            .AddEntityFrameworkStores<ApplicationDbContext>()\\r\\n            .AddSignInManager()\\r\\n            .AddDefaultTokenProviders()\\r\\n            .AddApiEndpoints();\\r\\n#endif\\r\\n\\r\\n        builder.Services.AddSingleton(TimeProvider.System);\\r\\n        builder.Services.AddTransient<IIdentityService, IdentityService>();\\r\\n    }\\r\\n}\\r\\n\"}}}","next_offset":null,"partial":false}
