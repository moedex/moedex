{"view_version":1,"raw_sha256":"6285096f1dcb0673daaa4db03e4c0a4b38242745087a199089d2bfa9fd96d571","raw_bytes":2874,"pointer":"","offset":0,"total_characters":2754,"encoding":"concatenate data then JSON-decode","scope":"selected value only; other fields remain in raw response","context":{"ordinal":8,"calls_used":8,"response_bytes_used":88327,"response_complete":true,"http_status":200,"error":null,"stopped":null},"data":"{\"jsonrpc\":\"2.0\",\"id\":8,\"result\":{\"_meta\":{\"dev.moedex/server\":{\"version\":\"dev+unknown\"},\"dev.moedex/snapshot\":{\"cacheable\":true,\"corpus_fingerprint\":\"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308\",\"blob_shas\":[\"907087aec44ea75ab5cd5ece406f6d79ad5b1034\"]}},\"content\":[{\"type\":\"text\",\"text\":\"--- src/Application/DependencyInjection.cs:1-26 (repo CleanArchitecture) ---\\n1 | using System.Reflection;\\n2 | using CleanArchitecture.Application.Common.Behaviours;\\n3 | using Microsoft.Extensions.Hosting;\\n4 | \\n5 | namespace Microsoft.Extensions.DependencyInjection;\\n6 | \\n7 | public static class DependencyInjection\\n8 | {\\n9 |     public static void AddApplicationServices(this IHostApplicationBuilder builder)\\n10 |     {\\n11 |         builder.Services.AddAutoMapper(cfg => \\n12 |             cfg.AddMaps(Assembly.GetExecutingAssembly()));\\n13 | \\n14 |         builder.Services.AddValidatorsFromAssembly(Assembly.GetExecutingAssembly());\\n15 | \\n16 |         builder.Services.AddMediatR(cfg => {\\n17 |             cfg.RegisterServicesFromAssembly(Assembly.GetExecutingAssembly());\\n18 |             cfg.AddOpenRequestPreProcessor(typeof(LoggingBehaviour<>));\\n19 |             cfg.AddOpenBehavior(typeof(UnhandledExceptionBehaviour<,>));\\n20 |             cfg.AddOpenBehavior(typeof(AuthorizationBehaviour<,>));\\n21 |             cfg.AddOpenBehavior(typeof(ValidationBehaviour<,>));\\n22 |             cfg.AddOpenBehavior(typeof(PerformanceBehaviour<,>));\\n23 |         });\\n24 |     }\\n25 | }\\n26 | \\n\"}],\"structuredContent\":{\"repo\":\"CleanArchitecture\",\"path\":\"src/Application/DependencyInjection.cs\",\"blob_sha\":\"907087aec44ea75ab5cd5ece406f6d79ad5b1034\",\"lines\":26,\"start_line\":1,\"end_line\":26,\"truncated\":false,\"content\":\"using System.Reflection;\\nusing CleanArchitecture.Application.Common.Behaviours;\\nusing Microsoft.Extensions.Hosting;\\n\\nnamespace Microsoft.Extensions.DependencyInjection;\\n\\npublic static class DependencyInjection\\n{\\n    public static void AddApplicationServices(this IHostApplicationBuilder builder)\\n    {\\n        builder.Services.AddAutoMapper(cfg => \\n            cfg.AddMaps(Assembly.GetExecutingAssembly()));\\n\\n        builder.Services.AddValidatorsFromAssembly(Assembly.GetExecutingAssembly());\\n\\n        builder.Services.AddMediatR(cfg => {\\n            cfg.RegisterServicesFromAssembly(Assembly.GetExecutingAssembly());\\n            cfg.AddOpenRequestPreProcessor(typeof(LoggingBehaviour<>));\\n            cfg.AddOpenBehavior(typeof(UnhandledExceptionBehaviour<,>));\\n            cfg.AddOpenBehavior(typeof(AuthorizationBehaviour<,>));\\n            cfg.AddOpenBehavior(typeof(ValidationBehaviour<,>));\\n            cfg.AddOpenBehavior(typeof(PerformanceBehaviour<,>));\\n        });\\n    }\\n}\\n\"}}}","next_offset":null,"partial":false}
