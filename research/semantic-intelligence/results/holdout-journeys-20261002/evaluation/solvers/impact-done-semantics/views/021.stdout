{"view_version":1,"raw_sha256":"1c65f4c974db4c0c846c43ae8a2ba93ab2ca3a5bf177d079f5684ef2f7e1abbb","raw_bytes":3411,"pointer":"","offset":0,"total_characters":3241,"encoding":"concatenate data then JSON-decode","scope":"selected value only; other fields remain in raw response","context":{"ordinal":15,"calls_used":15,"response_bytes_used":105139,"response_complete":true,"http_status":200,"error":null,"stopped":null},"data":"{\"jsonrpc\":\"2.0\",\"id\":15,\"result\":{\"_meta\":{\"dev.moedex/server\":{\"version\":\"dev+unknown\"},\"dev.moedex/snapshot\":{\"cacheable\":true,\"corpus_fingerprint\":\"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308\",\"blob_shas\":[\"4ee060305cfc14fdd5f7e1c82ab6f52c6f888f3e\"]}},\"content\":[{\"type\":\"text\",\"text\":\"--- src/Web/Infrastructure/WebApplicationExtensions.cs:1-30 (repo CleanArchitecture) ---\\n1 | using System.Reflection;\\n2 | \\n3 | namespace CleanArchitecture.Web.Infrastructure;\\n4 | \\n5 | public static class WebApplicationExtensions\\n6 | {\\n7 |     /// <summary>\\n8 |     /// Discovers all <see cref=\\\"IEndpointGroup\\\"/> implementations in <paramref name=\\\"assembly\\\"/>\\n9 |     /// and registers each as a route group with a matching OpenAPI tag. The route prefix defaults\\n10 |     /// to <c>/api/{ClassName}</c> but can be overridden via <see cref=\\\"IEndpointGroup.RoutePrefix\\\"/>.\\n11 |     /// </summary>\\n12 |     public static WebApplication MapEndpoints(this WebApplication app, Assembly assembly)\\n13 |     {\\n14 |         var endpointGroupTypes = assembly.GetExportedTypes()\\n15 |             .Where(t => t is { IsAbstract: false, IsInterface: false }\\n16 |                      && t.IsAssignableTo(typeof(IEndpointGroup)));\\n17 | \\n18 |         foreach (var type in endpointGroupTypes)\\n19 |         {\\n20 |             var groupName = type.Name;\\n21 |             var routePrefix = type.GetProperty(nameof(IEndpointGroup.RoutePrefix))\\n22 |                 ?.GetValue(null) as string ?? $\\\"/api/{groupName}\\\";\\n23 |             var group = app.MapGroup(routePrefix).WithTags(groupName);\\n24 |             type.GetMethod(nameof(IEndpointGroup.Map))!.Invoke(null, [group]);\\n25 |         }\\n26 | \\n27 |         return app;\\n28 |     }\\n29 | }\\n30 | \\n\"}],\"structuredContent\":{\"repo\":\"CleanArchitecture\",\"path\":\"src/Web/Infrastructure/WebApplicationExtensions.cs\",\"blob_sha\":\"4ee060305cfc14fdd5f7e1c82ab6f52c6f888f3e\",\"lines\":30,\"start_line\":1,\"end_line\":30,\"truncated\":false,\"content\":\"using System.Reflection;\\n\\nnamespace CleanArchitecture.Web.Infrastructure;\\n\\npublic static class WebApplicationExtensions\\n{\\n    /// <summary>\\n    /// Discovers all <see cref=\\\"IEndpointGroup\\\"/> implementations in <paramref name=\\\"assembly\\\"/>\\n    /// and registers each as a route group with a matching OpenAPI tag. The route prefix defaults\\n    /// to <c>/api/{ClassName}</c> but can be overridden via <see cref=\\\"IEndpointGroup.RoutePrefix\\\"/>.\\n    /// </summary>\\n    public static WebApplication MapEndpoints(this WebApplication app, Assembly assembly)\\n    {\\n        var endpointGroupTypes = assembly.GetExportedTypes()\\n            .Where(t => t is { IsAbstract: false, IsInterface: false }\\n                     && t.IsAssignableTo(typeof(IEndpointGroup)));\\n\\n        foreach (var type in endpointGroupTypes)\\n        {\\n            var groupName = type.Name;\\n            var routePrefix = type.GetProperty(nameof(IEndpointGroup.RoutePrefix))\\n                ?.GetValue(null) as string ?? $\\\"/api/{groupName}\\\";\\n            var group = app.MapGroup(routePrefix).WithTags(groupName);\\n            type.GetMethod(nameof(IEndpointGroup.Map))!.Invoke(null, [group]);\\n        }\\n\\n        return app;\\n    }\\n}\\n\"}}}","next_offset":null,"partial":false}
