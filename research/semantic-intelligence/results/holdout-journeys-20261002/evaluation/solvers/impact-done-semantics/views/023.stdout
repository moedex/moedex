{"view_version":1,"raw_sha256":"c446bf110824afbb0dcf2e0be7123d1fc39a11b792b08d1c930b3beee238d85c","raw_bytes":2454,"pointer":"","offset":0,"total_characters":2384,"encoding":"concatenate data then JSON-decode","scope":"selected value only; other fields remain in raw response","context":{"ordinal":17,"calls_used":17,"response_bytes_used":108154,"response_complete":true,"http_status":200,"error":null,"stopped":null},"data":"{\"jsonrpc\":\"2.0\",\"id\":17,\"result\":{\"_meta\":{\"dev.moedex/server\":{\"version\":\"dev+unknown\"},\"dev.moedex/snapshot\":{\"cacheable\":true,\"corpus_fingerprint\":\"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308\",\"blob_shas\":[\"f7d1f037965fff0b92c7622c3d874ab8c5bfae97\"]}},\"content\":[{\"type\":\"text\",\"text\":\"--- src/Domain/Common/BaseEntity.cs:1-31 (repo CleanArchitecture) ---\\n1 | using System.ComponentModel.DataAnnotations.Schema;\\n2 | \\n3 | namespace CleanArchitecture.Domain.Common;\\n4 | \\n5 | public abstract class BaseEntity\\n6 | {\\n7 |     // This can easily be modified to be BaseEntity<T> and public T Id to support different key types.\\n8 |     // Using non-generic integer types for simplicity\\n9 |     public int Id { get; set; }\\n10 | \\n11 |     private readonly List<BaseEvent> _domainEvents = new();\\n12 | \\n13 |     [NotMapped]\\n14 |     public IReadOnlyCollection<BaseEvent> DomainEvents => _domainEvents.AsReadOnly();\\n15 | \\n16 |     public void AddDomainEvent(BaseEvent domainEvent)\\n17 |     {\\n18 |         _domainEvents.Add(domainEvent);\\n19 |     }\\n20 | \\n21 |     public void RemoveDomainEvent(BaseEvent domainEvent)\\n22 |     {\\n23 |         _domainEvents.Remove(domainEvent);\\n24 |     }\\n25 | \\n26 |     public void ClearDomainEvents()\\n27 |     {\\n28 |         _domainEvents.Clear();\\n29 |     }\\n30 | }\\n31 | \\n\"}],\"structuredContent\":{\"repo\":\"CleanArchitecture\",\"path\":\"src/Domain/Common/BaseEntity.cs\",\"blob_sha\":\"f7d1f037965fff0b92c7622c3d874ab8c5bfae97\",\"lines\":31,\"start_line\":1,\"end_line\":31,\"truncated\":false,\"content\":\"using System.ComponentModel.DataAnnotations.Schema;\\n\\nnamespace CleanArchitecture.Domain.Common;\\n\\npublic abstract class BaseEntity\\n{\\n    // This can easily be modified to be BaseEntity<T> and public T Id to support different key types.\\n    // Using non-generic integer types for simplicity\\n    public int Id { get; set; }\\n\\n    private readonly List<BaseEvent> _domainEvents = new();\\n\\n    [NotMapped]\\n    public IReadOnlyCollection<BaseEvent> DomainEvents => _domainEvents.AsReadOnly();\\n\\n    public void AddDomainEvent(BaseEvent domainEvent)\\n    {\\n        _domainEvents.Add(domainEvent);\\n    }\\n\\n    public void RemoveDomainEvent(BaseEvent domainEvent)\\n    {\\n        _domainEvents.Remove(domainEvent);\\n    }\\n\\n    public void ClearDomainEvents()\\n    {\\n        _domainEvents.Clear();\\n    }\\n}\\n\"}}}","next_offset":null,"partial":false}
