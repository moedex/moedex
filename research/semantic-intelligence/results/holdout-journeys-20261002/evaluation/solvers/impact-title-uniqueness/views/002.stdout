{"view_version":1,"raw_sha256":"b96e4a0e347d9b1fb1105967efdd735feddd6ea138d658daa78efbc1412ff837","raw_bytes":97229,"pointer":"","offset":0,"total_characters":3723,"encoding":"concatenate data then JSON-decode","scope":"selected value only; other fields remain in raw response","context":{"catalog_tool":"search_context","charged_as_mcp_call":false},"data":"{\"annotations\":{\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false,\"readOnlyHint\":true},\"description\":\"Search the indexed code corpus and return ranked, deduplicated, token-budgeted context blocks for an LLM agent, each annotated with its code-graph neighborhood (callers, callees, consumers, publishers, dependencies, semantic siblings). The text presentation numbers source lines for precise citations; structured blocks retain unnumbered text. Cite the relevant lines rather than a whole block. Use read_source with a narrow line range to verify a citation.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"format\":{\"description\":\"Compatibility presentation option for the text fallback. structuredContent is always returned with per-block provenance.\",\"enum\":[\"text\",\"structured\"],\"type\":\"string\"},\"graph_depth\":{\"description\":\"Graph annotation radius in hops (optional, default 1). Each result block carries a \\\"neighbors\\\" field with the callers, callees, consumers, publishers, dependencies, and semantic siblings of the symbols it contains \\u2014 no second graph tool call needed. 0 disables the annotation.\",\"maximum\":10,\"minimum\":0,\"type\":\"integer\"},\"language\":{\"description\":\"Canonical language selected by file extension.\",\"enum\":[\"c\",\"cfml\",\"cpp\",\"csharp\",\"css\",\"go\",\"html\",\"java\",\"javascript\",\"json\",\"kotlin\",\"less\",\"markdown\",\"php\",\"python\",\"ruby\",\"rust\",\"sass\",\"scss\",\"shell\",\"sql\",\"swift\",\"toml\",\"typescript\",\"xml\",\"yaml\"],\"type\":\"string\"},\"min_confidence\":{\"description\":\"Minimum graph-edge confidence included in annotations (optional, default Pattern). Edges below the floor are excluded before traversal.\",\"enum\":[\"Candidate\",\"Pattern\",\"Verified\",\"Proven\"],\"type\":\"string\"},\"path_prefix\":{\"description\":\"Literal repository-relative path prefix on directory boundaries; no globs.\",\"type\":\"string\"},\"query\":{\"description\":\"The search query (keywords or identifiers).\",\"type\":\"string\"},\"repo\":{\"description\":\"Exact indexed repository name (case-sensitive).\",\"type\":\"string\"},\"token_budget\":{\"description\":\"Maximum estimated source-context tokens (optional); presentation labels, graph metadata and the response envelope add overhead.\",\"type\":\"integer\"},\"top_k\":{\"description\":\"Maximum number of ranked results to draw blocks from (optional).\",\"type\":\"integer\"}},\"required\":[\"query\"],\"type\":\"object\"},\"name\":\"search_context\",\"outputSchema\":{\"additionalProperties\":false,\"properties\":{\"blocks\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"abs_path\":{\"type\":\"string\"},\"blob\":{\"type\":\"integer\"},\"blob_sha\":{\"type\":\"string\"},\"clipped\":{\"type\":\"boolean\"},\"dense\":{\"type\":\"number\"},\"end_line\":{\"type\":\"integer\"},\"lexical\":{\"type\":\"number\"},\"neighbors\":{\"type\":\"object\"},\"path_with_namespace\":{\"type\":\"string\"},\"rel_path\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"score\":{\"type\":\"number\"},\"start_line\":{\"type\":\"integer\"},\"text\":{\"type\":\"string\"}},\"required\":[\"blob\",\"blob_sha\",\"repo\",\"rel_path\",\"abs_path\",\"start_line\",\"end_line\",\"score\",\"lexical\",\"dense\",\"text\",\"clipped\"],\"type\":\"object\"},\"type\":\"array\"},\"error\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"},\"summary\":{\"additionalProperties\":false,\"properties\":{\"blocks\":{\"type\":\"integer\"},\"clipped\":{\"type\":\"boolean\"},\"scope\":{\"additionalProperties\":false,\"properties\":{\"language\":{\"type\":\"string\"},\"path_prefix\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"}},\"type\":\"object\"},\"token_estimate\":{\"type\":\"integer\"},\"truncated\":{\"type\":\"boolean\"},\"warnings\":{\"items\":{\"enum\":[\"dense_unavailable\"],\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"blocks\",\"token_estimate\",\"truncated\",\"clipped\"],\"type\":\"object\"}},\"type\":\"object\"}}","next_offset":null,"partial":false}
