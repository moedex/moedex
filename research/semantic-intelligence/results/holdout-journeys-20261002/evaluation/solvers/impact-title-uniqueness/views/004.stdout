{"view_version":1,"raw_sha256":"b96e4a0e347d9b1fb1105967efdd735feddd6ea138d658daa78efbc1412ff837","raw_bytes":97229,"pointer":"","offset":0,"total_characters":2097,"encoding":"concatenate data then JSON-decode","scope":"selected value only; other fields remain in raw response","context":{"catalog_tool":"read_source","charged_as_mcp_call":false},"data":"{\"annotations\":{\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false,\"readOnlyHint\":true},\"description\":\"Read indexed source content by repository and path, with optional start_line/end_line. Text presentation numbers lines for precise citations; structuredContent.content preserves unnumbered indexed text. Use narrow ranges to verify citations. Never hash numbered presentation text or derive compiler offsets from it. Ingest removes a leading UTF8 BOM; before deriving compiler byte offsets, verify complete structuredContent.content against the selected compiler context's raw_sha256, including a possible BOM.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"end_line\":{\"description\":\"Optional inclusive final line; omitted reads to the file or tool limit.\",\"minimum\":1,\"type\":\"integer\"},\"format\":{\"description\":\"text (default) includes numbered source in the readable fallback. structured returns a short fallback summary to avoid duplicating source in clients that read structuredContent. Both preserve unnumbered structuredContent.content and provenance.\",\"enum\":[\"text\",\"structured\"],\"type\":\"string\"},\"path\":{\"description\":\"Relative file path within the repository. If not an exact match, the tool falls back to suffix matching (e.g. 'OrderService.cs' finds 'src/Services/OrderService.cs').\",\"minLength\":1,\"type\":\"string\"},\"repo\":{\"description\":\"Repository name (as returned by list_repos). Omit to search all repos.\",\"type\":\"string\"},\"start_line\":{\"description\":\"Optional first 1-based line to return (default 1).\",\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"path\"],\"type\":\"object\"},\"name\":\"read_source\",\"outputSchema\":{\"additionalProperties\":false,\"properties\":{\"blob_sha\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"end_line\":{\"type\":\"integer\"},\"error\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"},\"lines\":{\"type\":\"integer\"},\"path\":{\"type\":\"string\"},\"repo\":{\"type\":\"string\"},\"start_line\":{\"type\":\"integer\"},\"truncated\":{\"type\":\"boolean\"}},\"type\":\"object\"}}","next_offset":null,"partial":false}
