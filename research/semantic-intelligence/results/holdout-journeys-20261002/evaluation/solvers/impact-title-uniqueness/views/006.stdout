{"view_version":1,"raw_sha256":"675ae6811e6a06c5f206bd02917d0c1b7cca526b5cbdec126b2e2360295c987d","raw_bytes":2611,"pointer":"","offset":0,"total_characters":2551,"encoding":"concatenate data then JSON-decode","scope":"selected value only; other fields remain in raw response","context":{"ordinal":3,"calls_used":3,"response_bytes_used":18598,"response_complete":true,"http_status":200,"error":null,"stopped":null},"data":"{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"_meta\":{\"dev.moedex/server\":{\"version\":\"dev+unknown\"},\"dev.moedex/snapshot\":{\"cacheable\":true,\"corpus_fingerprint\":\"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308\",\"blob_shas\":[\"434f33f0a6f23af290e200ea21d026bf6d52be65\"]}},\"content\":[{\"type\":\"text\",\"text\":\"--- src/Application/TodoLists/Commands/CreateTodoList/CreateTodoListCommandValidator.cs:1-26 (repo CleanArchitecture) ---\\n1 | using CleanArchitecture.Application.Common.Interfaces;\\n2 | \\n3 | namespace CleanArchitecture.Application.TodoLists.Commands.CreateTodoList;\\n4 | \\n5 | public class CreateTodoListCommandValidator : AbstractValidator<CreateTodoListCommand>\\n6 | {\\n7 |     private readonly IApplicationDbContext _context;\\n8 | \\n9 |     public CreateTodoListCommandValidator(IApplicationDbContext context)\\n10 |     {\\n11 |         _context = context;\\n12 | \\n13 |         RuleFor(v => v.Title)\\n14 |             .NotEmpty()\\n15 |             .MaximumLength(200)\\n16 |             .MustAsync(BeUniqueTitle)\\n17 |                 .WithMessage(\\\"'{PropertyName}' must be unique.\\\")\\n18 |                 .WithErrorCode(\\\"Unique\\\");\\n19 |     }\\n20 | \\n21 |     public async Task<bool> BeUniqueTitle(string title, CancellationToken cancellationToken)\\n22 |     {\\n23 |         return !await _context.TodoLists\\n24 |             .AnyAsync(l => l.Title == title, cancellationToken);\\n25 |     }\\n26 | }\\n\"}],\"structuredContent\":{\"repo\":\"CleanArchitecture\",\"path\":\"src/Application/TodoLists/Commands/CreateTodoList/CreateTodoListCommandValidator.cs\",\"blob_sha\":\"434f33f0a6f23af290e200ea21d026bf6d52be65\",\"lines\":27,\"start_line\":1,\"end_line\":26,\"truncated\":true,\"content\":\"using CleanArchitecture.Application.Common.Interfaces;\\n\\nnamespace CleanArchitecture.Application.TodoLists.Commands.CreateTodoList;\\n\\npublic class CreateTodoListCommandValidator : AbstractValidator<CreateTodoListCommand>\\n{\\n    private readonly IApplicationDbContext _context;\\n\\n    public CreateTodoListCommandValidator(IApplicationDbContext context)\\n    {\\n        _context = context;\\n\\n        RuleFor(v => v.Title)\\n            .NotEmpty()\\n            .MaximumLength(200)\\n            .MustAsync(BeUniqueTitle)\\n                .WithMessage(\\\"'{PropertyName}' must be unique.\\\")\\n                .WithErrorCode(\\\"Unique\\\");\\n    }\\n\\n    public async Task<bool> BeUniqueTitle(string title, CancellationToken cancellationToken)\\n    {\\n        return !await _context.TodoLists\\n            .AnyAsync(l => l.Title == title, cancellationToken);\\n    }\\n}\"}}}","next_offset":null,"partial":false}
