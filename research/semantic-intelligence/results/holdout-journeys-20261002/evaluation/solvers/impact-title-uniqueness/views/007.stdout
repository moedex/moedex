doListConfiguration : IEntityTypeConfiguration<TodoList>\\n{\\n    public void Configure(EntityTypeBuilder<TodoList> builder)\\n    {\\n        builder.Property(t => t.Title)\\n            .HasMaxLength(200)\\n            .IsRequired();\\n\\n        builder\\n            .OwnsOne(b => b.Colour);\\n    }\\n}\\n\"}}}","next_offset":null,"partial":false}
