{"jsonrpc":"2.0","id":1,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308","blob_shas":["24f632d664136ee2311c8185cb269ef5d476c0f7","35c2f763da79e7d86a94dd275e09bcf034a3d52d","434f33f0a6f23af290e200ea21d026bf6d52be65","580b3a63360e764ab2e4aeba18f0a32fe39b7573","ada1547a52d394470cdfe00e47dd70a2d44f3360","ecae6406b60211bed2db30da19ff05d18db20f56"]}},"content":[{"type":"text","text":"7 context block(s), ~1988 tokens\n\n--- src/Application/Common/Interfaces/IApplicationDbContext.cs:1-12 (score 0.0459) ---\n1 | using CleanArchitecture.Domain.Entities;\n2 | \n3 | namespace CleanArchitecture.Application.Common.Interfaces;\n4 | \n5 | public interface IApplicationDbContext\n6 | {\n7 |     DbSet\u003cTodoList\u003e TodoLists { get; }\n8 | \n9 |     DbSet\u003cTodoItem\u003e TodoItems { get; }\n10 | \n11 |     Task\u003cint\u003e SaveChangesAsync(CancellationToken cancellationToken);\n12 | }\n\n--- src/Infrastructure/Data/ApplicationDbContext.cs:1-23 (score 0.0304) ---\n1 | using System.Reflection;\n2 | using CleanArchitecture.Application.Common.Interfaces;\n3 | using CleanArchitecture.Domain.Entities;\n4 | using CleanArchitecture.Infrastructure.Identity;\n5 | using Microsoft.AspNetCore.Identity.EntityFrameworkCore;\n6 | using Microsoft.EntityFrameworkCore;\n7 | \n8 | namespace CleanArchitecture.Infrastructure.Data;\n9 | \n10 | public class ApplicationDbContext : IdentityDbContext\u003cApplicationUser\u003e, IApplicationDbContext\n11 | {\n12 |     public ApplicationDbContext(DbContextOptions\u003cApplicationDbContext\u003e options) : base(options) { }\n13 | \n14 |     public DbSet\u003cTodoList\u003e TodoLists =\u003e Set\u003cTodoList\u003e();\n15 | \n16 |     public DbSet\u003cTodoItem\u003e TodoItems =\u003e Set\u003cTodoItem\u003e();\n17 | \n18 |     protected override void OnModelCreating(ModelBuilder builder)\n19 |     {\n20 |         base.OnModelCreating(builder);\n21 |         builder.ApplyConfigurationsFromAssembly(Assembly.GetExecutingAssembly());\n22 |     }\n23 | }\n\n--- src/Infrastructure/Data/ApplicationDbContextInitialiser.cs:1-110 (score 0.0287) ---\n1 | using CleanArchitecture.Domain.Constants;\n2 | using CleanArchitecture.Domain.Entities;\n3 | using CleanArchitecture.Domain.ValueObjects;\n4 | using CleanArchitecture.Infrastructure.Identity;\n5 | using Microsoft.AspNetCore.Builder;\n6 | using Microsoft.AspNetCore.Identity;\n7 | using Microsoft.Extensions.DependencyInjection;\n8 | using Microsoft.Extensions.Logging;\n9 | \n10 | namespace CleanArchitecture.Infrastructure.Data;\n11 | \n12 | public static class InitialiserExtensions\n13 | {\n14 |     public static async Task InitialiseDatabaseAsync(this WebApplication app)\n15 |     {\n16 |         using var scope = app.Services.CreateScope();\n17 | \n18 |         var initialiser = scope.ServiceProvider.GetRequiredService\u003cApplicationDbContextInitialiser\u003e();\n19 | \n20 |         await initialiser.InitialiseAsync();\n21 |         await initialiser.SeedAsync();\n22 |     }\n23 | }\n24 | \n25 | public class ApplicationDbContextInitialiser\n26 | {\n27 |     private readonly ILogger\u003cApplicationDbContextInitialiser\u003e _logger;\n28 |     private readonly ApplicationDbContext _context;\n29 |     private readonly UserManager\u003cApplicationUser\u003e _userManager;\n30 |     private readonly RoleManager\u003cIdentityRole\u003e _roleManager;\n31 | \n32 |     public ApplicationDbContextInitialiser(ILogger\u003cApplicationDbContextInitialiser\u003e logger, ApplicationDbContext context, UserManager\u003cApplicationUser\u003e userManager, RoleManager\u003cIdentityRole\u003e roleManager)\n33 |     {\n34 |         _logger = logger;\n35 |         _context = context;\n36 |         _userManager = userManager;\n37 |         _roleManager = roleManager;\n38 |     }\n39 | \n40 |     public async Task InitialiseAsync()\n41 |     {\n42 |         try\n43 |         {\n44 |             // See https://jasontaylor.dev/ef-core-database-initialisation-strategies\n45 |             await _context.Database.EnsureDeletedAsync();\n46 |             await _context.Database.EnsureCreatedAsync();\n47 |         }\n48 |         catch (Exception ex)\n49 |         {\n50 |             _logger.LogError(ex, \"An error occurred while initialising the database.\");\n51 |             throw;\n52 |         }\n53 |     }\n54 | \n55 |     public async Task SeedAsync()\n56 |     {\n57 |         try\n58 |         {\n59 |             await TrySeedAsync();\n60 |         }\n61 |         catch (Exception ex)\n62 |         {\n63 |             _logger.LogError(ex, \"An error occurred while seeding the database.\");\n64 |             throw;\n65 |         }\n66 |     }\n67 | \n68 |     public async Task TrySeedAsync()\n69 |     {\n70 |         // Default roles\n71 |         var administratorRole = new IdentityRole(Roles.Administrator);\n72 | \n73 |         if (_roleManager.Roles.All(r =\u003e r.Name != administratorRole.Name))\n74 |         {\n75 |             await _roleManager.CreateAsync(administratorRole);\n76 |         }\n77 | \n78 |         // Default users\n79 |         var administrator = new ApplicationUser { UserName = \"administrator@localhost\", Email = \"administrator@localhost\" };\n80 | \n81 |         if (_userManager.Users.All(u =\u003e u.UserName != administrator.UserName))\n82 |         {\n83 |             await _userManager.CreateAsync(administrator, \"Administrator1!\");\n84 |             if (!string.IsNullOrWhiteSpace(administratorRole.Name))\n85 |             {\n86 |                 await _userManager.AddToRolesAsync(administrator, new [] { administratorRole.Name });\n87 |             }\n88 |         }\n89 | \n90 |         // Default data\n91 |         // Seed, if necessary\n92 |         if (!_context.TodoLists.Any())\n93 |         {\n94 |             _context.TodoLists.Add(new TodoList\n95 |             {\n96 |                 Title = \"Tasks\",\n97 |                 Colour = Colour.Green,\n98 |                 Items =\n99 |                 {\n100 |                     new TodoItem { Title = \"Make a todo list 📃\" },\n101 |                     new TodoItem { Title = \"Check off the first item ✅\" },\n102 |                     new TodoItem { Title = \"Realise you've already done two things on the list! 🤯\"},\n103 |                     new TodoItem { Title = \"Reward yourself with a nice, long nap 🏆\" },\n104 |                 }\n105 |             });\n106 | \n107 |             await _context.SaveChangesAsync();\n108 |         }\n109 |     }\n110 | }\n\n--- docs/decisions/ADR-001-Use-EFCore-In-Application-Layer.md:1-4 (score 0.0164) ---\n1 | # ADR-001: Use EF Core in the Application Layer\n2 | \n3 | ## Status\n4 | \n\n--- docs/decisions/ADR-001-Use-EFCore-In-Application-Layer.md:8-26 (score 0.0164) ---\n8 | \n9 | 2024-02-29\n10 | \n11 | ## Context\n12 | \n13 | The Application layer needs to read and write data. Clean Architecture restricts inner layers from depending on outer layers, and frameworks like ORMs are typically placed in the Infrastructure layer. The question is whether the Application layer should access EF Core directly through an interface it owns, or whether a repository layer should sit between them.\n14 | \n15 | ## Decision\n16 | \n17 | The Application layer defines `IApplicationDbContext` — an interface exposing `DbSet\u003cT\u003e` properties — and uses it directly in command and query handlers. `ApplicationDbContext` in the Infrastructure layer implements this interface. No repository layer sits between the Application layer and EF Core.\n18 | \n19 | ## Rationale\n20 | \n21 | ### Dependency inversion is satisfied\n22 | \n23 | `IApplicationDbContext` is defined in the Application layer. `ApplicationDbContext` in Infrastructure implements it. The dependency arrow points inward — Infrastructure depends on Application, not the other way around.\n24 | \n25 | The Application layer takes a compile-time dependency on EF Core's abstractions (`DbSet\u003cT\u003e`, `IQueryable\u003cT\u003e`) but has no knowledge of the concrete `DbContext`, the database provider, or any Infrastructure type. A reference to an assembly (`Microsoft.EntityFrameworkCore`) is not the same as a dependency on a concrete implementation. Dependency inversion is about the direction of the dependency arrow, not about achieving zero framework references in inner layers.\n26 | \n\n--- src/Application/TodoItems/Commands/DeleteTodoItem/DeleteTodoItem.cs:1-28 (score 0.0161) ---\n1 | using CleanArchitecture.Application.Common.Interfaces;\n2 | \n3 | namespace CleanArchitecture.Application.TodoItems.Commands.DeleteTodoItem;\n4 | \n5 | public record DeleteTodoItemCommand(int Id) : IRequest;\n6 | \n7 | public class DeleteTodoItemCommandHandler : IRequestHandler\u003cDeleteTodoItemCommand\u003e\n8 | {\n9 |     private readonly IApplicationDbContext _context;\n10 | \n11 |     public DeleteTodoItemCommandHandler(IApplicationDbContext context)\n12 |     {\n13 |         _context = context;\n14 |     }\n15 | \n16 |     public async Task Handle(DeleteTodoItemCommand request, CancellationToken cancellationToken)\n17 |     {\n18 |         var entity = await _context.TodoItems\n19 |             .FindAsync([request.Id], cancellationToken);\n20 | \n21 |         Guard.Against.NotFound(request.Id, entity);\n22 | \n23 |         _context.TodoItems.Remove(entity);\n24 | \n25 |         await _context.SaveChangesAsync(cancellationToken);\n26 |     }\n27 | \n28 | }\n\n--- src/Application/TodoLists/Commands/CreateTodoList/CreateTodoListCommandValidator.cs:1-26 (score 0.0159) ---\n1 | using CleanArchitecture.Application.Common.Interfaces;\n2 | \n3 | namespace CleanArchitecture.Application.TodoLists.Commands.CreateTodoList;\n4 | \n5 | public class CreateTodoListCommandValidator : AbstractValidator\u003cCreateTodoListCommand\u003e\n6 | {\n7 |     private readonly IApplicationDbContext _context;\n8 | \n9 |     public CreateTodoListCommandValidator(IApplicationDbContext context)\n10 |     {\n11 |         _context = context;\n12 | \n13 |         RuleFor(v =\u003e v.Title)\n14 |             .NotEmpty()\n15 |             .MaximumLength(200)\n16 |             .MustAsync(BeUniqueTitle)\n17 |                 .WithMessage(\"'{PropertyName}' must be unique.\")\n18 |                 .WithErrorCode(\"Unique\");\n19 |     }\n20 | \n21 |     public async Task\u003cbool\u003e BeUniqueTitle(string title, CancellationToken cancellationToken)\n22 |     {\n23 |         return !await _context.TodoLists\n24 |             .AnyAsync(l =\u003e l.Title == title, cancellationToken);\n25 |     }\n26 | }\n"}],"structuredContent":{"summary":{"blocks":7,"token_estimate":1988,"truncated":false,"clipped":false},"blocks":[{"blob":48,"blob_sha":"24f632d664136ee2311c8185cb269ef5d476c0f7","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Application/Common/Interfaces/IApplicationDbContext.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Application/Common/Interfaces/IApplicationDbContext.cs","start_line":1,"end_line":12,"score":0.045944779982743746,"lexical":35.01597553989302,"dense":0,"text":"using CleanArchitecture.Domain.Entities;\n\nnamespace CleanArchitecture.Application.Common.Interfaces;\n\npublic interface IApplicationDbContext\n{\n    DbSet\u003cTodoList\u003e TodoLists { get; }\n\n    DbSet\u003cTodoItem\u003e TodoItems { get; }\n\n    Task\u003cint\u003e SaveChangesAsync(CancellationToken cancellationToken);\n}\n","clipped":false},{"blob":87,"blob_sha":"580b3a63360e764ab2e4aeba18f0a32fe39b7573","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Infrastructure/Data/ApplicationDbContext.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Infrastructure/Data/ApplicationDbContext.cs","start_line":1,"end_line":23,"score":0.0304147465437788,"lexical":37.85289876704736,"dense":0,"text":"using System.Reflection;\nusing CleanArchitecture.Application.Common.Interfaces;\nusing CleanArchitecture.Domain.Entities;\nusing CleanArchitecture.Infrastructure.Identity;\nusing Microsoft.AspNetCore.Identity.EntityFrameworkCore;\nusing Microsoft.EntityFrameworkCore;\n\nnamespace CleanArchitecture.Infrastructure.Data;\n\npublic class ApplicationDbContext : IdentityDbContext\u003cApplicationUser\u003e, IApplicationDbContext\n{\n    public ApplicationDbContext(DbContextOptions\u003cApplicationDbContext\u003e options) : base(options) { }\n\n    public DbSet\u003cTodoList\u003e TodoLists =\u003e Set\u003cTodoList\u003e();\n\n    public DbSet\u003cTodoItem\u003e TodoItems =\u003e Set\u003cTodoItem\u003e();\n\n    protected override void OnModelCreating(ModelBuilder builder)\n    {\n        base.OnModelCreating(builder);\n        builder.ApplyConfigurationsFromAssembly(Assembly.GetExecutingAssembly());\n    }\n}\n","clipped":false},{"blob":88,"blob_sha":"35c2f763da79e7d86a94dd275e09bcf034a3d52d","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Infrastructure/Data/ApplicationDbContextInitialiser.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Infrastructure/Data/ApplicationDbContextInitialiser.cs","start_line":1,"end_line":110,"score":0.028693528693528692,"lexical":25.546584066037692,"dense":0,"text":"using CleanArchitecture.Domain.Constants;\nusing CleanArchitecture.Domain.Entities;\nusing CleanArchitecture.Domain.ValueObjects;\nusing CleanArchitecture.Infrastructure.Identity;\nusing Microsoft.AspNetCore.Builder;\nusing Microsoft.AspNetCore.Identity;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.Extensions.Logging;\n\nnamespace CleanArchitecture.Infrastructure.Data;\n\npublic static class InitialiserExtensions\n{\n    public static async Task InitialiseDatabaseAsync(this WebApplication app)\n    {\n        using var scope = app.Services.CreateScope();\n\n        var initialiser = scope.ServiceProvider.GetRequiredService\u003cApplicationDbContextInitialiser\u003e();\n\n        await initialiser.InitialiseAsync();\n        await initialiser.SeedAsync();\n    }\n}\n\npublic class ApplicationDbContextInitialiser\n{\n    private readonly ILogger\u003cApplicationDbContextInitialiser\u003e _logger;\n    private readonly ApplicationDbContext _context;\n    private readonly UserManager\u003cApplicationUser\u003e _userManager;\n    private readonly RoleManager\u003cIdentityRole\u003e _roleManager;\n\n    public ApplicationDbContextInitialiser(ILogger\u003cApplicationDbContextInitialiser\u003e logger, ApplicationDbContext context, UserManager\u003cApplicationUser\u003e userManager, RoleManager\u003cIdentityRole\u003e roleManager)\n    {\n        _logger = logger;\n        _context = context;\n        _userManager = userManager;\n        _roleManager = roleManager;\n    }\n\n    public async Task InitialiseAsync()\n    {\n        try\n        {\n            // See https://jasontaylor.dev/ef-core-database-initialisation-strategies\n            await _context.Database.EnsureDeletedAsync();\n            await _context.Database.EnsureCreatedAsync();\n        }\n        catch (Exception ex)\n        {\n            _logger.LogError(ex, \"An error occurred while initialising the database.\");\n            throw;\n        }\n    }\n\n    public async Task SeedAsync()\n    {\n        try\n        {\n            await TrySeedAsync();\n        }\n        catch (Exception ex)\n        {\n            _logger.LogError(ex, \"An error occurred while seeding the database.\");\n            throw;\n        }\n    }\n\n    public async Task TrySeedAsync()\n    {\n        // Default roles\n        var administratorRole = new IdentityRole(Roles.Administrator);\n\n        if (_roleManager.Roles.All(r =\u003e r.Name != administratorRole.Name))\n        {\n            await _roleManager.CreateAsync(administratorRole);\n        }\n\n        // Default users\n        var administrator = new ApplicationUser { UserName = \"administrator@localhost\", Email = \"administrator@localhost\" };\n\n        if (_userManager.Users.All(u =\u003e u.UserName != administrator.UserName))\n        {\n            await _userManager.CreateAsync(administrator, \"Administrator1!\");\n            if (!string.IsNullOrWhiteSpace(administratorRole.Name))\n            {\n                await _userManager.AddToRolesAsync(administrator, new [] { administratorRole.Name });\n            }\n        }\n\n        // Default data\n        // Seed, if necessary\n        if (!_context.TodoLists.Any())\n        {\n            _context.TodoLists.Add(new TodoList\n            {\n                Title = \"Tasks\",\n                Colour = Colour.Green,\n                Items =\n                {\n                    new TodoItem { Title = \"Make a todo list 📃\" },\n                    new TodoItem { Title = \"Check off the first item ✅\" },\n                    new TodoItem { Title = \"Realise you've already done two things on the list! 🤯\"},\n                    new TodoItem { Title = \"Reward yourself with a nice, long nap 🏆\" },\n                }\n            });\n\n            await _context.SaveChangesAsync();\n        }\n    }\n}\n","clipped":false},{"blob":28,"blob_sha":"ada1547a52d394470cdfe00e47dd70a2d44f3360","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"docs/decisions/ADR-001-Use-EFCore-In-Application-Layer.md","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/docs/decisions/ADR-001-Use-EFCore-In-Application-Layer.md","start_line":1,"end_line":4,"score":0.01639344262295082,"lexical":40.11493000419421,"dense":0,"text":"# ADR-001: Use EF Core in the Application Layer\n\n## Status\n\n","clipped":false},{"blob":28,"blob_sha":"ada1547a52d394470cdfe00e47dd70a2d44f3360","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"docs/decisions/ADR-001-Use-EFCore-In-Application-Layer.md","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/docs/decisions/ADR-001-Use-EFCore-In-Application-Layer.md","start_line":8,"end_line":26,"score":0.01639344262295082,"lexical":40.11493000419421,"dense":0,"text":"\n2024-02-29\n\n## Context\n\nThe Application layer needs to read and write data. Clean Architecture restricts inner layers from depending on outer layers, and frameworks like ORMs are typically placed in the Infrastructure layer. The question is whether the Application layer should access EF Core directly through an interface it owns, or whether a repository layer should sit between them.\n\n## Decision\n\nThe Application layer defines `IApplicationDbContext` — an interface exposing `DbSet\u003cT\u003e` properties — and uses it directly in command and query handlers. `ApplicationDbContext` in the Infrastructure layer implements this interface. No repository layer sits between the Application layer and EF Core.\n\n## Rationale\n\n### Dependency inversion is satisfied\n\n`IApplicationDbContext` is defined in the Application layer. `ApplicationDbContext` in Infrastructure implements it. The dependency arrow points inward — Infrastructure depends on Application, not the other way around.\n\nThe Application layer takes a compile-time dependency on EF Core's abstractions (`DbSet\u003cT\u003e`, `IQueryable\u003cT\u003e`) but has no knowledge of the concrete `DbContext`, the database provider, or any Infrastructure type. A reference to an assembly (`Microsoft.EntityFrameworkCore`) is not the same as a dependency on a concrete implementation. Dependency inversion is about the direction of the dependency arrow, not about achieving zero framework references in inner layers.\n\n","clipped":false},{"blob":58,"blob_sha":"ecae6406b60211bed2db30da19ff05d18db20f56","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Application/TodoItems/Commands/DeleteTodoItem/DeleteTodoItem.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Application/TodoItems/Commands/DeleteTodoItem/DeleteTodoItem.cs","start_line":1,"end_line":28,"score":0.016129032258064516,"lexical":38.391779561954685,"dense":0,"text":"using CleanArchitecture.Application.Common.Interfaces;\n\nnamespace CleanArchitecture.Application.TodoItems.Commands.DeleteTodoItem;\n\npublic record DeleteTodoItemCommand(int Id) : IRequest;\n\npublic class DeleteTodoItemCommandHandler : IRequestHandler\u003cDeleteTodoItemCommand\u003e\n{\n    private readonly IApplicationDbContext _context;\n\n    public DeleteTodoItemCommandHandler(IApplicationDbContext context)\n    {\n        _context = context;\n    }\n\n    public async Task Handle(DeleteTodoItemCommand request, CancellationToken cancellationToken)\n    {\n        var entity = await _context.TodoItems\n            .FindAsync([request.Id], cancellationToken);\n\n        Guard.Against.NotFound(request.Id, entity);\n\n        _context.TodoItems.Remove(entity);\n\n        await _context.SaveChangesAsync(cancellationToken);\n    }\n\n}\n","clipped":false},{"blob":64,"blob_sha":"434f33f0a6f23af290e200ea21d026bf6d52be65","repo":"CleanArchitecture","path_with_namespace":"CleanArchitecture","rel_path":"src/Application/TodoLists/Commands/CreateTodoList/CreateTodoListCommandValidator.cs","abs_path":"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Application/TodoLists/Commands/CreateTodoList/CreateTodoListCommandValidator.cs","start_line":1,"end_line":26,"score":0.015873015873015872,"lexical":38.267813745113344,"dense":0,"text":"using CleanArchitecture.Application.Common.Interfaces;\n\nnamespace CleanArchitecture.Application.TodoLists.Commands.CreateTodoList;\n\npublic class CreateTodoListCommandValidator : AbstractValidator\u003cCreateTodoListCommand\u003e\n{\n    private readonly IApplicationDbContext _context;\n\n    public CreateTodoListCommandValidator(IApplicationDbContext context)\n    {\n        _context = context;\n\n        RuleFor(v =\u003e v.Title)\n            .NotEmpty()\n            .MaximumLength(200)\n            .MustAsync(BeUniqueTitle)\n                .WithMessage(\"'{PropertyName}' must be unique.\")\n                .WithErrorCode(\"Unique\");\n    }\n\n    public async Task\u003cbool\u003e BeUniqueTitle(string title, CancellationToken cancellationToken)\n    {\n        return !await _context.TodoLists\n            .AnyAsync(l =\u003e l.Title == title, cancellationToken);\n    }\n}\n","clipped":false}]}}}