{"jsonrpc":"2.0","id":7,"result":{"_meta":{"dev.moedex/server":{"version":"dev+unknown"},"dev.moedex/snapshot":{"cacheable":true,"corpus_fingerprint":"91319b10facf5ae7aa6cbf0100983732b0c4e78db7c15e1ff39dff7289e4d308","blob_shas":["3d584516cdbeec70b61f284cbf570f9d30cab4fa"]}},"content":[{"type":"text","text":"--- src/Infrastructure/Data/Interceptors/AuditableEntityInterceptor.cs:9-65 (repo CleanArchitecture) ---\n9 | public class AuditableEntityInterceptor : SaveChangesInterceptor\n10 | {\n11 |     private readonly IUser _user;\n12 |     private readonly TimeProvider _dateTime;\n13 | \n14 |     public AuditableEntityInterceptor(\n15 |         IUser user,\n16 |         TimeProvider dateTime)\n17 |     {\n18 |         _user = user;\n19 |         _dateTime = dateTime;\n20 |     }\n21 | \n22 |     public override InterceptionResult\u003cint\u003e SavingChanges(DbContextEventData eventData, InterceptionResult\u003cint\u003e result)\n23 |     {\n24 |         UpdateEntities(eventData.Context);\n25 | \n26 |         return base.SavingChanges(eventData, result);\n27 |     }\n28 | \n29 |     public override ValueTask\u003cInterceptionResult\u003cint\u003e\u003e SavingChangesAsync(DbContextEventData eventData, InterceptionResult\u003cint\u003e result, CancellationToken cancellationToken = default)\n30 |     {\n31 |         UpdateEntities(eventData.Context);\n32 | \n33 |         return base.SavingChangesAsync(eventData, result, cancellationToken);\n34 |     }\n35 | \n36 |     public void UpdateEntities(DbContext? context)\n37 |     {\n38 |         if (context == null) return;\n39 | \n40 |         foreach (var entry in context.ChangeTracker.Entries\u003cBaseAuditableEntity\u003e())\n41 |         {\n42 |             if (entry.State is EntityState.Added or EntityState.Modified || entry.HasChangedOwnedEntities())\n43 |             {\n44 |                 var utcNow = _dateTime.GetUtcNow();\n45 |                 if (entry.State == EntityState.Added)\n46 |                 {\n47 |                     entry.Entity.CreatedBy = _user.Id;\n48 |                     entry.Entity.Created = utcNow;\n49 |                 } \n50 |                 entry.Entity.LastModifiedBy = _user.Id;\n51 |                 entry.Entity.LastModified = utcNow;\n52 |             }\n53 |         }\n54 |     }\n55 | }\n56 | \n57 | public static class Extensions\n58 | {\n59 |     public static bool HasChangedOwnedEntities(this EntityEntry entry) =\u003e\n60 |         entry.References.Any(r =\u003e \n61 |             r.TargetEntry != null \u0026\u0026 \n62 |             r.TargetEntry.Metadata.IsOwned() \u0026\u0026 \n63 |             (r.TargetEntry.State == EntityState.Added || r.TargetEntry.State == EntityState.Modified));\n64 | }\n65 | \n"}],"structuredContent":{"repo":"CleanArchitecture","path":"src/Infrastructure/Data/Interceptors/AuditableEntityInterceptor.cs","blob_sha":"3d584516cdbeec70b61f284cbf570f9d30cab4fa","lines":65,"start_line":9,"end_line":65,"truncated":false,"content":"public class AuditableEntityInterceptor : SaveChangesInterceptor\n{\n    private readonly IUser _user;\n    private readonly TimeProvider _dateTime;\n\n    public AuditableEntityInterceptor(\n        IUser user,\n        TimeProvider dateTime)\n    {\n        _user = user;\n        _dateTime = dateTime;\n    }\n\n    public override InterceptionResult\u003cint\u003e SavingChanges(DbContextEventData eventData, InterceptionResult\u003cint\u003e result)\n    {\n        UpdateEntities(eventData.Context);\n\n        return base.SavingChanges(eventData, result);\n    }\n\n    public override ValueTask\u003cInterceptionResult\u003cint\u003e\u003e SavingChangesAsync(DbContextEventData eventData, InterceptionResult\u003cint\u003e result, CancellationToken cancellationToken = default)\n    {\n        UpdateEntities(eventData.Context);\n\n        return base.SavingChangesAsync(eventData, result, cancellationToken);\n    }\n\n    public void UpdateEntities(DbContext? context)\n    {\n        if (context == null) return;\n\n        foreach (var entry in context.ChangeTracker.Entries\u003cBaseAuditableEntity\u003e())\n        {\n            if (entry.State is EntityState.Added or EntityState.Modified || entry.HasChangedOwnedEntities())\n            {\n                var utcNow = _dateTime.GetUtcNow();\n                if (entry.State == EntityState.Added)\n                {\n                    entry.Entity.CreatedBy = _user.Id;\n                    entry.Entity.Created = utcNow;\n                } \n                entry.Entity.LastModifiedBy = _user.Id;\n                entry.Entity.LastModified = utcNow;\n            }\n        }\n    }\n}\n\npublic static class Extensions\n{\n    public static bool HasChangedOwnedEntities(this EntityEntry entry) =\u003e\n        entry.References.Any(r =\u003e \n            r.TargetEntry != null \u0026\u0026 \n            r.TargetEntry.Metadata.IsOwned() \u0026\u0026 \n            (r.TargetEntry.State == EntityState.Added || r.TargetEntry.State == EntityState.Modified));\n}\n"}}}