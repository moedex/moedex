|     {\\n27 |         await DispatchDomainEvents(eventData.Context);\\n28 | \\n29 |         return await base.SavingChangesAsync(eventData, result, cancellationToken);\\n30 |     }\\n31 | \\n32 |     public async Task DispatchDomainEvents(DbContext? context)\\n33 |     {\\n34 |         if (context == null) return;\\n35 | \\n36 |         var entities = context.ChangeTracker\\n37 |             .Entries<BaseEntity>()\\n38 |             .Where(e => e.Entity.DomainEvents.Any())\\n39 |             .Select(e => e.Entity);\\n40 | \\n41 |         var domainEvents = entities\\n42 |             .SelectMany(e => e.DomainEvents)\\n43 |             .ToList();\\n44 | \\n45 |         entities.ToList().ForEach(e => e.ClearDomainEvents());\\n46 | \\n47 |         foreach (var domainEvent in domainEvents)\\n48 |             await _mediator.Publish(domainEvent);\\n49 |     }\\n50 | }\\n\\n--- src/Infrastructure/Data/Interceptors/AuditableEntityInterceptor.cs:1-55 (score 0.0161) ---\\n1 | using CleanArchitecture.Application.Common.Interfaces;\\n2 | using CleanArchitecture.Domain.Common;\\n3 | using Microsoft.EntityFrameworkCore;\\n4 | using Microsoft.EntityFrameworkCore.ChangeTracking;\\n5 | using Microsoft.EntityFrameworkCore.Diagnostics;\\n6 | \\n7 | namespace CleanArchitecture.Infrastructure.Data.Interceptors;\\n8 | \\n9 | public class AuditableEntityInterceptor : SaveChangesInterceptor\\n10 | {\\n11 |     private readonly IUser _user;\\n12 |     private readonly TimeProvider _dateTime;\\n13 | \\n14 |     public AuditableEntityInterceptor(\\n15 |         IUser user,\\n16 |         TimeProvider dateTime)\\n17 |     {\\n18 |         _user = user;\\n19 |         _dateTime = dateTime;\\n20 |     }\\n21 | \\n22 |     public override InterceptionResult<int> SavingChanges(DbContextEventData eventData, InterceptionResult<int> result)\\n23 |     {\\n24 |         UpdateEntities(eventData.Context);\\n25 | \\n26 |         return base.SavingChanges(eventData, result);\\n27 |     }\\n28 | \\n29 |     public override ValueTask<InterceptionResult<int>> SavingChangesAsync(DbContextEventData eventData, InterceptionResult<int> result, CancellationToken cancellationToken = default)\\n30 |     {\\n31 |         UpdateEntities(eventData.Context);\\n32 | \\n33 |         return base.SavingChangesAsync(eventData, result, cancellationToken);\\n34 |     }\\n35 | \\n36 |     public void UpdateEntities(DbContext? context)\\n37 |     {\\n38 |         if (context == null) return;\\n39 | \\n40 |         foreach (var entry in context.ChangeTracker.Entries<BaseAuditableEntity>())\\n41 |         {\\n42 |             if (entry.State is EntityState.Added or EntityState.Modified || entry.HasChangedOwnedEntities())\\n43 |             {\\n44 |                 var utcNow = _dateTime.GetUtcNow();\\n45 |                 if (entry.State == EntityState.Added)\\n46 |                 {\\n47 |                     entry.Entity.CreatedBy = _user.Id;\\n48 |                     entry.Entity.Created = utcNow;\\n49 |                 } \\n50 |                 entry.Entity.LastModifiedBy = _user.Id;\\n51 |                 entry.Entity.LastModified = utcNow;\\n52 |             }\\n53 |         }\\n54 |     }\\n55 | }\\n\"}],\"structuredContent\":{\"summary\":{\"scope\":{\"repo\":\"CleanArchitecture\",\"path_prefix\":\"src/Infrastructure/Data/Interceptors\"},\"blocks\":2,\"token_estimate\":858,\"truncated\":false,\"clipped\":false},\"blocks\":[{\"blob\":92,\"blob_sha\":\"9f25fc0c4cf5e02703e071f7b94ff9c852cd2a54\",\"repo\":\"CleanArchitecture\",\"path_with_namespace\":\"CleanArchitecture\",\"rel_path\":\"src/Infrastructure/Data/Interceptors/DispatchDomainEventsInterceptor.cs\",\"abs_path\":\"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/corpus/CleanArchitecture/src/Infrastructure/Data/Interceptors/DispatchDomainEventsInterceptor.cs\",\"start_line\":1,\"end_line\":50,\"score\":0.03278688524590164,\"lexical\":79.98432897609425,\"dense\":0,\"text\":\"using CleanArchitecture.Domain.Common;\\nusing MediatR;\\nusing Microsoft.EntityFrameworkCore;\\nusing Microsoft.EntityFrameworkCore.Diagnostics;\\n\\nnamespace CleanArchitecture.Infrastructure.Data.Interceptors;\\n\\npublic class DispatchDomainEventsInterceptor : SaveChangesInterceptor\\n{\\n    private readonly IMediator _mediator;\\n\\n    public DispatchDomainEventsInterceptor(IMediator mediator)\\n    {\\n        _mediator = mediator;\\n    }\\n\\n    public override InterceptionResult<int> SavingChanges(DbContextEventData eventData, InterceptionResult<int> result)\\n    {\\n        DispatchDomainEvents(eventData.Context).GetAwaiter().GetResult();\\n\\n        return base.SavingChanges(eventData, result);\\n\\n    }\\n\\n    public override async ValueTask<InterceptionResult<int>> SavingChangesAsync(DbContextEventData eventData, InterceptionResult<int> result, CancellationToken cancellationToken = default)\\n    {\\n        await DispatchDomainEvents(eventData.Context);\\n\\n        return await base.SavingChangesAsync(eventData, result, cancellationToken);\\n    }\\n\\n    public async Task DispatchDomainEvents(DbContext? context)\\n    {\\n        if (context == null) return;\\n\\n        var entities = context.ChangeTracker\\n            .Entries<BaseEntity>()\\n            .Where(e => e.Entity.DomainEvents.Any())\\n            .Select(e => e.Entity);\\n\\n        var domainEvents = entities\\n            .SelectMany(e => e.DomainEvents)\\n            .ToList();\\n\\n        entities.ToList().ForEach(e => e.ClearDomainEvents());\\n\\n        foreach (var domainEvent in domainEvents)\\n            await _mediator.Publish(domainEvent);\\n    }\\n}\\n\",\"clipped\":false},{\"blob\":91,\"blob_sha\":\"3d584516cdbeec70b61f284cbf570f9d30cab4fa\",\"repo\":\"CleanArchitecture\",\"path_with_namespace\":\"CleanArchitecture\",\"rel_path\":\"src/Infrastructure/Data/Interceptors/AuditableEntityInterceptor.cs\",\"abs_path\":\"/Users/zakkeown/Code/moedex/.local/holdout-cleanarchitecture/source-only/cor