28 | #elif (UseSqlServer)\\n29 |         var connection = new SqlConnection(connectionString);\\n30 | #else\\n31 |         var connection = new SqliteConnection(connectionString);\\n32 | #endif\\n33 | \\n34 |         await connection.OpenAsync();\\n35 |         var respawner = await Respawner.CreateAsync(connection);\\n36 |         await connection.CloseAsync();\\n37 |         return new DatabaseResetter(connection, respawner);\\n38 |     }\\n39 | \\n40 |     public async Task ResetAsync()\\n41 |     {\\n42 |         await _connection.OpenAsync();\\n43 |         await _respawner.ResetAsync(_connection);\\n44 |         await _connection.CloseAsync();\\n45 |     }\\n46 | \\n47 |     public async ValueTask DisposeAsync() => await _connection.DisposeAsync();\\n48 | }\\n\\n--- src/Infrastructure/DependencyInjection.cs:15-78 (score 0.0161) ---\\n15 |     public static void AddInfrastructureServices(this IHostApplicationBuilder builder)\\n16 |     {\\n17 |         var connectionString = builder.Configuration.GetConnectionString(Services.Database);\\n18 |         Guard.Against.Null(connectionString, message: $\\\"Connection string '{Services.Database}' not found.\\\");\\n19 | \\n20 |         builder.Services.AddScoped<ISaveChangesInterceptor, AuditableEntityInterceptor>();\\n21 |         builder.Services.AddScoped<ISaveChangesInterceptor, DispatchDomainEventsInterceptor>();\\n22 | \\n23 |         builder.Services.AddDbContext<ApplicationDbContext>((sp, options) =>\\n24 |         {\\n25 |             options.AddInterceptors(sp.GetServices<ISaveChangesInterceptor>());\\n26 | #if (UsePostgreSQL)\\n27 |             options.UseNpgsql(connectionString);\\n28 | #elif (UseSqlServer)\\n29 |             options.UseSqlServer(connectionString);\\n30 | #else\\n31 |             options.UseSqlite(connectionString);\\n32 | #endif\\n33 |             options.ConfigureWarnings(warnings => warnings.Ignore(RelationalEventId.PendingModelChangesWarning));\\n34 |         });\\n35 | \\n36 | #if UsePostgreSQL\\n37 |         builder.EnrichNpgsqlDbContext<ApplicationDbContext>();\\n38 | #elif (UseSqlServer)\\n39 |         builder.EnrichSqlServerDbContext<ApplicationDbContext>();\\n40 | #endif\\n41 | \\n42 |         builder.Services.AddScoped<IApplicationDbContext>(provider => provider.GetRequiredService<ApplicationDbContext>());\\n43 | \\n44 |         builder.Services.AddScoped<ApplicationDbContextInitialiser>();\\n45 | \\n46 | #if (UseApiOnly)\\n47 |         builder.Services.AddAuthentication()\\n48 |             .AddBearerToken(IdentityConstants.BearerScheme);\\n49 | \\n50 |         builder.Services.AddAuthorizationBuilder();\\n51 | \\n52 |         builder.Services\\n53 |             .AddIdentityCore<ApplicationUser>()\\n54 |             .AddRoles<IdentityRole>()\\n55 |             .AddEntityFrameworkStores<ApplicationDbContext>()\\n56 |             .AddApiEndpoints();\\n57 | #else\\n58 |         builder.Services.AddAuthentication(options =>\\n59 |             {\\n60 |                 options.DefaultScheme = IdentityConstants.ApplicationScheme;\\n61 |                 options.DefaultSignInScheme = IdentityConstants.ExternalScheme;\\n62 |             })\\n63 |             .AddIdentityCookies();\\n64 | \\n65 |         builder.Services.AddAuthorizationBuilder();\\n66 | \\n67 |         builder.Services\\n68 |             .AddIdentityCore<ApplicationUser>()\\n69 |             .AddRoles<IdentityRole>()\\n70 |             .AddEntityFrameworkStores<ApplicationDbContext>()\\n71 |             .AddSignInManager()\\n72 |             .AddDefaultTokenProviders()\\n73 |             .AddApiEndpoints();\\n74 | #endif\\n75 | \\n76 |         builder.Services.AddSingleton(TimeProvider.System);\\n77 |         builder.Services.AddTransient<IIdentityService, IdentityService>();\\n78 |     }\\n\\n--- src/Infrastructure/Infrastructure.csproj:7-25 (score 0.0159) ---\\n7 | \\n8 |   <ItemGroup>\\n9 |     <PackageReference Include=\\\"Microsoft.EntityFrameworkCore\\\" />\\n10 |     <!--#if